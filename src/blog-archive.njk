---
layout: layouts/base.njk
title: "Articles & Engineering Notes | Bittu"
description: "Technical deep dives, systems engineering notes, binary protocols, and architecture write-ups by Bittu."
permalink: "/blog/index.html"
isBlogPage: true
isBlogArchivePage: true
---
{% import "macros/icons.njk" as icons %}
{% from "macros/post-row.njk" import postRow %}

<div class="font-body relative">
  <!-- Same edge ornamentation as the homepage (decorative) -->
  {% include "components/scene-ornaments.njk" %}

  {% include "components/retro-header.njk" %}

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-14 sm:py-20" data-pagefind-ignore>
    <!-- Page heading: display voice + RSS / LLMS.TXT affordances -->
    <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 mb-10">
      <div>
        <h1 class="heading-pop font-display text-5xl sm:text-6xl text-black leading-none">Articles</h1>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill-sm bg-[#fb923c] hover:bg-[#f97316]"
          title="Subscribe via standard RSS 2.0"
        >
          {{ icons.rss("w-4 h-4 text-black") }} RSS
        </a>
        <a
          href="/llms.txt"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill-sm bg-[#86efac] hover:bg-[#4ade80]"
          title="Structured plain-text feed for LLMs"
        >
          {{ icons.llmsDoc("w-4 h-4 text-black") }} LLMS.TXT
        </a>
      </div>
    </header>

    <!-- Search, sort & tag filters -->
    <section class="mb-10 space-y-3" aria-label="Search and filter articles">
      <div class="flex flex-col sm:flex-row items-stretch gap-3">
        <!-- Search input -->
        <div class="flex-1 flex items-center gap-2.5 h-11 sm:h-12 px-3.5 sm:px-4 bg-[#fffdf9] border-2 border-black transition-colors focus-within:border-[#b45309] motion-reduce:transition-none">
          <span class="shrink-0 text-black/65">
            {{ icons.search("w-4 h-4 text-black") }}
          </span>
          <input
            type="search"
            id="blog-search-input"
            placeholder="Search articles by title, keywords, or #tag..."
            class="w-full text-sm text-black placeholder:text-black/65 focus:outline-none bg-transparent"
            aria-label="Search articles"
          />
          <button
            id="blog-search-clear"
            class="hidden shrink-0 px-2 py-1 text-xs font-bold text-black bg-[#fffdf9] border-2 border-black hover:bg-[#f87171] cursor-pointer transition-colors motion-reduce:transition-none"
            aria-label="Clear search"
          >
            CLEAR
          </button>
        </div>

        <!-- Sort select -->
        <select
          id="blog-sort-select"
          class="shrink-0 h-11 sm:h-12 px-3 sm:px-4 bg-[#fffdf9] border-2 border-black text-sm font-bold text-black focus:outline-none focus:border-[#b45309] cursor-pointer transition-colors motion-reduce:transition-none"
          aria-label="Sort articles"
        >
          <option value="date-desc" selected>Newest First</option>
          <option value="date-asc">Oldest First</option>
          <option value="read-time-asc">Shortest Read</option>
          <option value="read-time-desc">Longest Read</option>
          <option value="title-asc">Title (A–Z)</option>
        </select>
      </div>

      <!-- Tag filter chips (JS toggles .active / font weight only) -->
      <div class="flex flex-wrap items-center gap-2 pt-1" id="blog-tags-container" aria-label="Filter articles by tag">
        <button
          class="blog-tag-filter-btn active px-2.5 py-1.5 bg-transparent border-2 border-dashed border-black text-sm font-black text-black cursor-pointer select-none transition-colors hover:bg-[#fef3c7] motion-reduce:transition-none"
          data-tag="ALL"
        >
          ALL ({{ collections.blogs.length }})
        </button>
        {% for tag in collections.blogTags %}
          <button
            class="blog-tag-filter-btn px-2.5 py-1.5 bg-transparent border-2 border-dashed border-black text-sm font-bold text-black cursor-pointer select-none transition-colors hover:bg-[#fef3c7] motion-reduce:transition-none"
            data-tag="{{ tag }}"
          >
            #{{ tag }}
          </button>
        {% endfor %}
      </div>

      <div id="blog-search-status" class="hidden px-1 font-mono text-sm font-bold text-black/65" aria-live="polite">
        <span id="blog-search-count"></span>
      </div>
    </section>

    <!-- Article rows: 2px ink frame around the list, hairlines between rows -->
    <div class="divide-y divide-black/15 border-y border-black/15" id="blog-posts-list">
      {% for post in collections.blogs %}
        {{ postRow(post, loop.index0, 2, true) }}
      {% endfor %}
    </div>

    <!-- Empty results state -->
    <div id="blog-no-results" class="hidden my-10 border-2 border-dashed border-black p-8 sm:p-10 text-center">
      <h2 class="font-display text-2xl sm:text-3xl text-black leading-tight">No articles found</h2>
      <p class="font-body text-sm sm:text-base text-black/75 leading-relaxed max-w-md mx-auto mt-2">
        Try a different search term or clear the active filters.
      </p>
      <button id="blog-reset-filters-btn" class="mt-5 inline-flex items-center gap-2 px-4 py-2 border-2 border-black text-sm font-bold text-black bg-transparent hover:bg-[#fde047] cursor-pointer transition-colors">
        Reset filters
      </button>
    </div>
  </main>

  {% include "components/retro-footer.njk" %}
</div>

<!-- Pagefind Static Search Engine Client -->
<script src="/assets/js/pagefind-search.js" defer></script>
