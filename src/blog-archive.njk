---
layout: layouts/base.njk
title: "Articles & Engineering Notes | Bittu"
description: "Technical deep dives, systems engineering notes, binary protocols, and architecture write-ups by Bittu."
permalink: "/blog/index.html"
isBlogPage: true
---
{% import "macros/icons.njk" as icons %}

<div class="font-body">
  {% include "components/retro-header.njk" %}

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-14 sm:py-20" data-pagefind-ignore>
    <!-- Page heading: display voice + RSS / LLMS.TXT affordances -->
    <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 mb-10">
      <div>
        <h1 class="heading-pop font-display text-5xl sm:text-6xl text-black leading-none">All articles</h1>
        <p class="font-mono text-sm font-bold text-black/65 mt-4">
          {{ collections.blogs.length }} post{{ '' if collections.blogs.length == 1 else 's' }} · notes on systems, protocols &amp; the web
        </p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill-sm bg-[#fb923c] hover:bg-[#f97316]"
          title="Subscribe via standard RSS 2.0"
        >
          {{ icons.rss("w-4 h-4 text-black") }} RSS
        </a>
        <a
          href="/llms.txt"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill-sm bg-[#fffdf9] hover:bg-[#86efac]"
          title="Structured plain-text feed for LLMs"
        >
          {{ icons.terminal("w-4 h-4 text-black") }} LLMS.TXT
        </a>
      </div>
    </header>

    <!-- Search, sort & tag filters -->
    <section class="mb-10 space-y-3" aria-label="Search and filter articles">
      <div class="flex flex-col sm:flex-row items-stretch gap-3">
        <!-- Search input -->
        <div class="flex-1 flex items-center gap-2.5 h-11 sm:h-12 px-3.5 sm:px-4 bg-[#fffdf9] border-2 border-black transition-colors focus-within:border-[#b45309] motion-reduce:transition-none">
          <span class="shrink-0 text-black/65">
            {{ icons.search("w-4 h-4 text-black") }}
          </span>
          <input
            type="search"
            id="blog-search-input"
            placeholder="Search articles by title, keywords, or #tag..."
            class="w-full font-mono text-sm text-black placeholder:text-black/65 focus:outline-none bg-transparent"
            aria-label="Search articles"
          />
          <button
            id="blog-search-clear"
            class="hidden shrink-0 px-2 py-1 font-mono text-xs font-bold text-black bg-[#fffdf9] border-2 border-black hover:bg-[#f87171] cursor-pointer transition-colors motion-reduce:transition-none"
            aria-label="Clear search"
          >
            CLEAR
          </button>
        </div>

        <!-- Sort select -->
        <div class="flex items-center justify-between sm:justify-start gap-2 shrink-0 h-11 sm:h-12 px-3 sm:px-4 bg-[#fffdf9] border-2 border-black transition-colors focus-within:border-[#b45309] motion-reduce:transition-none">
          <label for="blog-sort-select" class="flex items-center gap-1.5 font-mono text-sm font-bold text-black shrink-0 cursor-pointer">
            {{ icons.slidersHorizontal("w-4 h-4 text-black") }}
            <span>SORT:</span>
          </label>
          <select
            id="blog-sort-select"
            class="bg-transparent font-mono text-sm font-bold text-black focus:outline-none cursor-pointer pr-1"
            aria-label="Sort articles"
          >
            <option value="date-desc">Newest First</option>
            <option value="date-asc">Oldest First</option>
            <option value="read-time-asc">Shortest Read</option>
            <option value="read-time-desc">Longest Read</option>
            <option value="title-asc">Title (A–Z)</option>
          </select>
        </div>
      </div>

      <!-- Tag filter chips (JS toggles bg-[#fde047] / bg-[#fffdf9] on these) -->
      <div class="flex flex-wrap items-center gap-2 pt-1" id="blog-tags-container" aria-label="Filter articles by tag">
        <button
          class="blog-tag-filter-btn active px-4 py-2.5 bg-[#fde047] border-2 border-black font-mono text-sm font-black text-black cursor-pointer select-none transition-colors motion-reduce:transition-none"
          data-tag="ALL"
        >
          ALL ({{ collections.blogs.length }})
        </button>
        {% for tag in collections.blogTags %}
          <button
            class="blog-tag-filter-btn px-4 py-2.5 bg-[#fffdf9] hover:bg-[#fde047] border-2 border-black font-mono text-sm font-bold text-black cursor-pointer select-none transition-colors motion-reduce:transition-none"
            data-tag="{{ tag }}"
          >
            #{{ tag }}
          </button>
        {% endfor %}
      </div>

      <div id="blog-search-status" class="hidden px-1 font-mono text-sm font-bold text-black/65">
        <span id="blog-search-count"></span>
      </div>
    </section>

    <!-- Article rows: 2px ink frame around the list, hairlines between rows -->
    <div class="divide-y divide-black/15 border-y-2 border-black" id="blog-posts-list">
      {% set chipColors = ['bg-[#86efac]', 'bg-[#c4b5fd]', 'bg-[#38bdf8]'] %}
      {% for post in collections.blogs %}
        {% set chip = chipColors[loop.index0 % 3] %}
        {% set validTags = [] %}
        {% for tag in post.data.tags %}
          {% if tag != "posts" %}
            {% set validTags = (validTags.push(tag), validTags) %}
          {% endif %}
        {% endfor %}

        <article
          class="blog-post-card group relative grid gap-3 py-8 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-8"
          data-slug="{{ post.data.slug or post.fileSlug }}"
          data-title="{{ (post.data.title or '') | lower }}"
          data-summary="{{ (post.data.summary or '') | lower }}"
          data-tags="{{ (post.data.tags or []) | join('|||') | lower }}"
          data-hidden-tags="{{ (post.data.allSeoTags or []) | join('|||') | lower }}"
          data-date="{{ (post.data.date or post.date) | dateIso }}"
          data-readtime="{{ post.data.readTime or '3 min read' }}"
        >
          <div class="min-w-0">
            <!-- Meta: date chip + read time -->
            <p class="font-mono text-sm font-bold flex flex-wrap items-center gap-3">
              <span class="inline-block px-2.5 py-1 border-2 border-black {{ chip }} text-black">
                <time datetime="{{ (post.data.date or post.date) | dateIso }}">
                  {{ (post.data.displayDate or ((post.data.date or post.date) | dateDisplay)) | upper }}
                </time>
              </span>
              <span class="text-black/65">// {{ (post.data.readTime or '3 min read') | upper }}</span>
            </p>

            <!-- Title is the row-wide link -->
            <h2 class="font-display text-3xl sm:text-4xl text-black leading-tight mt-4">
              <a
                href="{{ post.url }}"
                class="group-hover:text-[#b45309] transition-colors motion-reduce:transition-none after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
              >{{ post.data.title }}</a>
            </h2>

            <p class="font-body text-base sm:text-lg text-black/80 leading-relaxed mt-3">{{ post.data.summary }}</p>

            <!-- Pagefind excerpt (populated by /assets/js/pagefind-search.js) -->
            <div class="blog-match-snippet hidden mt-4 p-3 bg-[#fffdf9] border-2 border-black font-mono text-sm text-black/90 leading-relaxed"></div>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-4 font-mono text-sm font-bold text-black/65">
              {% for tag in validTags.slice(0, 4) %}
                <span>#{{ tag | lower }}</span>
              {% endfor %}
              {% if validTags.length > 4 %}
                <span title="{{ validTags.slice(4) | join(', ') }}">+{{ validTags.length - 4 }}</span>
              {% endif %}
            </div>
          </div>

          <a
            href="{{ post.url }}"
            class="relative z-10 inline-flex items-center gap-1.5 self-start px-4 py-2 border-2 border-black font-mono text-sm font-bold text-black bg-[#fde047] hover:bg-[#fbbf24] transition-colors motion-reduce:transition-none whitespace-nowrap"
          >
            Read article {{ icons.arrowUpRight("w-3.5 h-3.5") }}
          </a>
        </article>
      {% endfor %}
    </div>

    <!-- Empty results state -->
    <div id="blog-no-results" class="hidden my-10 border-[3px] border-black bg-[#fffdf9] p-8 sm:p-12 text-center">
      <div class="inline-block px-2.5 py-1 border-2 border-black bg-[#f87171] font-mono text-sm font-bold text-black">
        No matches
      </div>
      <h2 class="font-display text-3xl sm:text-4xl text-black leading-tight mt-4">Nothing here</h2>
      <p class="font-body text-base sm:text-lg text-black/80 leading-relaxed max-w-md mx-auto mt-3">
        No articles match your query or active tag filters. Try broader terms or clear the filters.
      </p>
      <div class="mt-6">
        <button id="blog-reset-filters-btn" class="btn-pill-sm bg-[#fde047] cursor-pointer">
          Reset all filters
        </button>
      </div>
    </div>
  </main>

  {% include "components/retro-footer.njk" %}
</div>

<!-- Pagefind Static Search Engine Client -->
<script src="/assets/js/pagefind-search.js" defer></script>
