---
layout: layouts/base.njk
title: "Articles & Engineering Notes | Bittu"
description: "Technical deep dives, systems engineering notes, binary protocols, and architecture write-ups by Bittu."
permalink: "/blog/index.html"
---
{% import "macros/icons.njk" as icons %}

<div class="min-h-screen bg-[#f6eedb] retro-dots-bg text-[#14161f] font-sans selection:bg-[#fde047] selection:text-black">
  {% include "components/retro-header.njk" %}

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12" data-pagefind-ignore>
    <!-- Editorial Header Banner -->
    <header class="mb-10 pb-6 border-b border-black/15">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 font-mono text-xs sm:text-sm font-bold text-black/60 uppercase tracking-widest mb-1.5">
            <span>BITTU.DEV</span>
            <span>/</span>
            <span>WRITING</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-black tracking-tight">
            Articles &amp; Dispatches
          </h1>
          <p class="mt-2.5 font-sans text-base sm:text-lg text-black/75 max-w-2xl leading-relaxed">
            Deep dives into low-level systems, network protocols, distributed signaling, and software architecture.
          </p>
        </div>

        <!-- External RSS & Context Feeds -->
        <div class="flex items-center gap-2 shrink-0 pt-2 sm:pt-0">
          <a
            href="/rss.xml"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#fffdf9] hover:bg-[#fb923c] text-black border border-black rounded font-mono text-xs sm:text-sm font-bold transition-colors"
            title="Subscribe via standard RSS 2.0"
          >
            {{ icons.rss("w-3.5 h-3.5 text-black") }}
            <span>RSS</span>
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#fffdf9] hover:bg-[#86efac] text-black border border-black rounded font-mono text-xs sm:text-sm font-bold transition-colors"
            title="Structured plain-text feed for LLMs"
          >
            {{ icons.terminal("w-3.5 h-3.5 text-black") }}
            <span>LLMS.TXT</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Search & Filter Controls: Standard, focused toolbar -->
    <section class="mb-10 space-y-4" aria-label="Search and filter articles">
      <div class="flex flex-col sm:flex-row items-stretch gap-3">
        <!-- Search Input -->
        <div class="flex-1 bg-[#fffdf9] border-2 border-black rounded-lg px-3.5 py-2.5 flex items-center gap-2.5 focus-within:ring-2 focus-within:ring-amber-500 transition-all shadow-sm">
          <svg class="w-4 h-4 text-black/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="search"
            id="blog-search-input"
            placeholder="Search articles by title, keywords, or #tag..."
            class="w-full font-sans text-sm sm:text-base text-black placeholder:text-black/45 focus:outline-none bg-transparent"
            aria-label="Search articles"
          />
          <button
            id="blog-search-clear"
            class="hidden px-2 py-0.5 font-mono text-xs font-bold bg-[#f87171] text-black border border-black rounded hover:bg-red-400 cursor-pointer shrink-0"
            aria-label="Clear search"
          >
            CLEAR
          </button>
        </div>

        <!-- Sort Select -->
        <div class="bg-[#fffdf9] border-2 border-black rounded-lg px-3 py-2 flex items-center gap-2 shrink-0 shadow-sm">
          <label for="blog-sort-select" class="flex items-center gap-1.5 text-black/70 font-mono text-xs sm:text-sm font-bold shrink-0 cursor-pointer">
            <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 4h18M3 10h12M3 16h6"/>
            </svg>
            <span>SORT:</span>
          </label>
          <select
            id="blog-sort-select"
            class="bg-transparent text-black font-mono text-xs sm:text-sm font-bold focus:outline-none cursor-pointer pr-1"
            aria-label="Sort articles"
          >
            <option value="date-desc">Newest First</option>
            <option value="date-asc">Oldest First</option>
            <option value="read-time-asc">Shortest Read</option>
            <option value="read-time-desc">Longest Read</option>
            <option value="title-asc">Title (A–Z)</option>
          </select>
        </div>
      </div>

      <!-- Tag Filter Pills Toolbar -->
      <div class="flex flex-wrap items-center gap-1.5 pt-1" id="blog-tags-container" aria-label="Filter articles by tag">
        <button
          class="blog-tag-filter-btn active px-3 py-1 bg-[#fde047] border border-black rounded-full font-mono text-xs sm:text-sm font-black cursor-pointer select-none transition-colors"
          data-tag="ALL"
        >
          ALL ({{ collections.blogs.length }})
        </button>
        {% for tag in collections.blogTags %}
          <button
            class="blog-tag-filter-btn px-3 py-1 bg-[#fffdf9] hover:bg-[#fde047] border border-black/40 hover:border-black rounded-full font-mono text-xs sm:text-sm font-bold text-black/80 hover:text-black cursor-pointer select-none transition-colors"
            data-tag="{{ tag }}"
          >
            #{{ tag }}
          </button>
        {% endfor %}
      </div>

      <!-- Search Count Status Indicator -->
      <div id="blog-search-status" class="hidden font-mono text-xs sm:text-sm text-black/70 font-bold px-1">
        <span id="blog-search-count"></span>
      </div>
    </section>

    <!-- Articles List Container -->
    <div class="space-y-6" id="blog-posts-list">
      {% for post in collections.blogs %}
        {% set validTags = [] %}
        {% for tag in post.data.tags %}
          {% if tag != "posts" %}
            {% set validTags = (validTags.push(tag), validTags) %}
          {% endif %}
        {% endfor %}

        <article
          class="blog-post-card group bg-[#fffdf9] border-2 border-black rounded-xl p-6 sm:p-8 hover:border-amber-600 shadow-sm hover:shadow-md transition-all"
          data-slug="{{ post.data.slug or post.fileSlug }}"
          data-title="{{ (post.data.title or '') | lower }}"
          data-summary="{{ (post.data.summary or '') | lower }}"
          data-tags="{{ (post.data.tags or []) | join('|||') | lower }}"
          data-date="{{ (post.data.date or post.date) | dateIso }}"
          data-readtime="{{ post.data.readTime or '3 min read' }}"
        >
          <!-- Metadata Byline Bar -->
          <div class="flex flex-wrap items-center justify-between gap-2.5 mb-3 text-xs sm:text-sm font-mono text-black/60">
            <div class="flex items-center gap-2">
              <time datetime="{{ (post.data.date or post.date) | dateIso }}" class="font-bold text-black">
                {{ post.data.displayDate or ((post.data.date or post.date) | dateDisplay) }}
              </time>
              <span>·</span>
              <span class="font-medium text-black/75">
                {{ post.data.readTime or '3 min read' }}
              </span>
            </div>

            <!-- Tags: Display up to first 5 tags, +N if more -->
            <div class="flex flex-wrap gap-1.5">
              {% for tag in validTags.slice(0, 5) %}
                <span class="px-2 py-0.5 bg-[#f6eedb] border border-black/20 rounded font-mono text-xs font-semibold text-black/80">
                  #{{ tag }}
                </span>
              {% endfor %}
              {% if validTags.length > 5 %}
                <span
                  class="px-2 py-0.5 bg-neutral-200 border border-black/20 rounded font-mono text-xs font-semibold text-black/70"
                  title="{{ validTags.slice(5) | join(', ') }}"
                >
                  +{{ validTags.length - 5 }}
                </span>
              {% endif %}
            </div>
          </div>

          <!-- Article Title -->
          <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-black leading-snug tracking-tight mb-2.5 group-hover:text-amber-600 transition-colors">
            <a href="{{ post.url }}" class="hover:underline underline-offset-4 decoration-amber-500">
              {{ post.data.title }}
            </a>
          </h2>

          <!-- Summary / Excerpt -->
          <p class="font-sans text-sm sm:text-base text-neutral-700 leading-relaxed mb-4">
            {{ post.data.summary }}
          </p>

          <!-- Search Match Snippet (populated dynamically by Pagefind) -->
          <div class="blog-match-snippet hidden mb-4 p-3 bg-amber-500/10 border-l-4 border-amber-500 font-sans text-xs sm:text-sm text-black/90 leading-relaxed rounded-r"></div>

          <!-- Read Link -->
          <div>
            <a
              href="{{ post.url }}"
              class="inline-flex items-center gap-1.5 font-sans font-bold text-sm text-black group-hover:text-amber-600 group-hover:translate-x-0.5 transition-all"
            >
              <span>Read article</span>
              {{ icons.arrowRight("w-4 h-4") }}
            </a>
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- Empty Results State -->
    <div
      id="blog-no-results"
      class="hidden p-8 sm:p-12 bg-[#fffdf9] border-2 border-black rounded-xl text-center space-y-4 my-8 shadow-sm"
    >
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-100 text-amber-900 border border-amber-300 font-mono text-xs font-bold rounded-full">
        <span>No matching dispatches</span>
      </div>
      <h3 class="font-bold text-xl sm:text-2xl text-black">No articles found</h3>
      <p class="font-sans text-sm sm:text-base text-neutral-600 max-w-md mx-auto">
        No articles match your query or active tag filters. Try searching for broader terms or clearing your filters.
      </p>
      <div>
        <button
          id="blog-reset-filters-btn"
          class="btn-brutal-yellow inline-flex items-center gap-2 px-4 py-2 text-sm font-bold rounded-lg shadow-sm cursor-pointer transition-all"
        >
          <span>Reset all filters</span>
        </button>
      </div>
    </div>
  </main>

  {% include "components/retro-footer.njk" %}
</div>

<!-- Pagefind Static Search Engine Client -->
<script src="/assets/js/pagefind-search.js" defer></script>
