---
layout: layouts/base.njk
title: "Blog & Technical Zine | Bittu"
description: "Essays on low-level networking in Go, reverse-engineering the Minecraft Java wire format, 2D Cartesian spatial parsing in Python, and architecture blueprints."
permalink: "/blog/index.html"
---
{% import "macros/icons.njk" as icons %}

<div class="min-h-screen bg-[#f6eedb] retro-dots-bg text-[#14161f] font-sans selection:bg-[#fde047] selection:text-black">
  {% include "components/retro-header.njk" %}

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Navigation & Feed header -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <a
        href="/"
        class="btn-brutal-white px-3.5 py-1.5 text-xs sm:text-sm"
      >
        {{ icons.arrowLeft("w-4 h-4") }}
        <span>RETURN HOME</span>
      </a>

      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutal bg-[#fb923c] px-3.5 py-1.5 text-xs sm:text-sm"
      >
        {{ icons.rss("w-4 h-4") }}
        <span>RSS 2.0 FEED</span>
      </a>
    </div>

    <!-- Page Title Box -->
    <div class="p-6 sm:p-8 card-brutal shadow-brutal-lg mb-10">
      <div class="inline-block px-3 py-1 bg-[#fde047] border-2 border-black font-mono text-xs font-bold shadow-brutal-xs mb-3">
        TECHNICAL BLOG ARCHIVE
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-mono font-black text-black mb-3 tracking-tight">
        ~/blog
      </h1>
      <p class="font-mono text-sm sm:text-base text-black/80 max-w-2xl leading-relaxed">
        Essays on low-level networking in Go, reverse-engineering the Minecraft Java wire format, 2D Cartesian spatial parsing in Python, and architecture blueprints.
      </p>
    </div>

    <!-- Post List -->
    <div class="space-y-6">
      {% for post in blogs %}
        <article class="p-6 sm:p-8 card-brutal group">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-3 pb-3 border-b-2 border-black/10">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 bg-[#86efac] border border-black font-mono text-xs font-bold text-black">
                STAMP: {{ post.date | upper }}
              </span>
              <span class="font-mono text-xs sm:text-sm text-black/60 font-bold">
                // {{ post.readTime | upper }}
              </span>
            </div>

            <div class="flex flex-wrap gap-1.5">
              {% for tag in post.tags %}
                <span class="tag-pill">
                  #{{ tag }}
                </span>
              {% endfor %}
            </div>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black text-black mb-3 group-hover:text-[#d97706] transition-colors">
            <a href="/blog/{{ post.slug }}">
              {{ post.title }}
            </a>
          </h2>

          <p class="font-mono text-xs sm:text-sm text-black/80 leading-relaxed mb-5">
            {{ post.summary }}
          </p>

          <div class="flex items-center justify-between pt-2">
            <a
              href="/blog/{{ post.slug }}"
              class="btn-brutal-yellow px-4 py-2 text-xs sm:text-sm"
            >
              <span>READ DISPATCH</span>
              {{ icons.arrowUpRight("w-4 h-4") }}
            </a>

            <span class="font-mono text-xs text-black/40 font-bold">
              /blog/{{ post.slug }}
            </span>
          </div>
        </article>
      {% endfor %}
    </div>
  </main>
</div>
