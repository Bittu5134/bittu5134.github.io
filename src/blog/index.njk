---
layout: layouts/base.njk
title: "Articles & Engineering Notes | Bittu"
description: "Technical deep dives, systems engineering notes, binary protocols, and architecture write-ups by Bittu."
permalink: "/blog/index.html"
---
{% import "macros/icons.njk" as icons %}

<div class="min-h-screen bg-[#f6eedb] retro-dots-bg text-[#14161f] font-sans selection:bg-[#fde047] selection:text-black">
  {% include "components/retro-header.njk" %}

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10" data-pagefind-ignore>
    <!-- Header Banner: Retro Terminal Aesthetic + Clean Editorial Typography -->
    <header class="mb-8 pb-5 border-b-2 border-black/15">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 font-mono text-xs sm:text-sm font-bold text-black/60 tracking-wider mb-1">
            <span>BITTU.DEV</span>
            <span>/</span>
            <span class="text-black font-black">~/blogs</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-mono font-black text-black tracking-tight">
            ~/blogs
          </h1>
          <p class="mt-2 font-mono text-sm sm:text-base text-black/75 max-w-2xl leading-relaxed">
            Technical deep dives, network protocols, systems engineering notes, and architecture write-ups.
          </p>
        </div>

        <!-- External RSS & Context Feeds -->
        <div class="flex items-center gap-2 shrink-0 pt-1 sm:pt-0">
          <a
            href="/rss.xml"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-brutal bg-[#fb923c] px-3 py-1.5 text-xs sm:text-sm"
            title="Subscribe via standard RSS 2.0"
          >
            {{ icons.rss("w-3.5 h-3.5 text-black") }}
            <span>RSS</span>
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-brutal bg-[#86efac] px-3 py-1.5 text-xs sm:text-sm"
            title="Structured plain-text feed for LLMs"
          >
            {{ icons.terminal("w-3.5 h-3.5 text-black") }}
            <span>LLMS.TXT</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Search & Filter Controls: Standard layout with brutalist retro styling -->
    <section class="mb-8 space-y-3" aria-label="Search and filter articles">
      <div class="flex flex-col sm:flex-row items-stretch gap-3">
        <!-- Search Input -->
        <div class="flex-1 card-brutal px-3.5 sm:px-4 py-2 bg-[#fffdf9] flex items-center gap-2.5 shadow-brutal-xs h-11 sm:h-12">
          <div class="text-black/50 shrink-0">
            <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input
            type="search"
            id="blog-search-input"
            placeholder="Search articles by title, keywords, or #tag..."
            class="w-full font-mono text-xs sm:text-sm text-black placeholder:text-black/45 focus:outline-none bg-transparent"
            aria-label="Search articles"
          />
          <button
            id="blog-search-clear"
            class="hidden px-2 py-0.5 font-mono text-xs font-bold bg-[#f87171] text-black border border-black hover:bg-red-400 cursor-pointer shrink-0"
            aria-label="Clear search"
          >
            CLEAR
          </button>
        </div>

        <!-- Sort Select -->
        <div class="card-brutal px-3 sm:px-4 py-2 bg-[#fffdf9] flex items-center justify-between sm:justify-start gap-2 shrink-0 shadow-brutal-xs h-11 sm:h-12">
          <label for="blog-sort-select" class="flex items-center gap-1.5 text-black font-mono text-xs sm:text-sm font-bold shrink-0 cursor-pointer">
            <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 4h18M3 10h12M3 16h6"/>
            </svg>
            <span>SORT:</span>
          </label>
          <select
            id="blog-sort-select"
            class="bg-transparent text-black font-mono text-xs sm:text-sm font-bold focus:outline-none cursor-pointer pr-1"
            aria-label="Sort articles"
          >
            <option value="date-desc">Newest First</option>
            <option value="date-asc">Oldest First</option>
            <option value="read-time-asc">Shortest Read</option>
            <option value="read-time-desc">Longest Read</option>
            <option value="title-asc">Title (A–Z)</option>
          </select>
        </div>
      </div>

      <!-- Tag Filter Pills Toolbar -->
      <div class="flex flex-wrap items-center gap-2 pt-1" id="blog-tags-container" aria-label="Filter articles by tag">
        <button
          class="blog-tag-filter-btn active px-3.5 py-1.5 bg-[#fde047] border-2 border-black font-mono text-xs sm:text-sm font-black cursor-pointer select-none"
          data-tag="ALL"
        >
          ALL ({{ collections.blogs.length }})
        </button>
        {% for tag in collections.blogTags %}
          <button
            class="blog-tag-filter-btn px-3.5 py-1.5 bg-[#fffdf9] hover:bg-[#fde047] border-2 border-black font-mono text-xs sm:text-sm font-bold text-black cursor-pointer select-none transition-colors"
            data-tag="{{ tag }}"
          >
            #{{ tag }}
          </button>
        {% endfor %}
      </div>

      <!-- Search Count Status Indicator -->
      <div id="blog-search-status" class="hidden font-mono text-xs sm:text-sm text-black/70 font-bold px-1">
        <span id="blog-search-count"></span>
      </div>
    </section>

    <!-- Articles List Container -->
    <div class="space-y-6" id="blog-posts-list">
      {% for post in collections.blogs %}
        {% set validTags = [] %}
        {% for tag in post.data.tags %}
          {% if tag != "posts" %}
            {% set validTags = (validTags.push(tag), validTags) %}
          {% endif %}
        {% endfor %}

        <article
          class="blog-post-card card-brutal p-5 sm:p-7 group bg-[#fffdf9] transition-all"
          data-slug="{{ post.data.slug or post.fileSlug }}"
          data-title="{{ (post.data.title or '') | lower }}"
          data-summary="{{ (post.data.summary or '') | lower }}"
          data-tags="{{ (post.data.tags or []) | join('|||') | lower }}"
          data-date="{{ (post.data.date or post.date) | dateIso }}"
          data-readtime="{{ post.data.readTime or '3 min read' }}"
        >
          <!-- Metadata Bar: Mint date stamp + read time + clean tags -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 mb-4 pb-3 border-b-2 border-black/10">
            <div class="flex items-center gap-2.5">
              <span class="px-2.5 py-1 bg-[#86efac] border-2 border-black font-mono text-xs sm:text-sm font-bold text-black">
                <time datetime="{{ (post.data.date or post.date) | dateIso }}">
                  {{ (post.data.displayDate or ((post.data.date or post.date) | dateDisplay)) | upper }}
                </time>
              </span>
              <span class="font-mono text-xs sm:text-sm text-black/70 font-bold">
                // {{ (post.data.readTime or '3 min read') | upper }}
              </span>
            </div>

            <!-- Tags: Display up to first 5 tags, +N if more -->
            <div class="flex flex-wrap gap-1.5">
              {% for tag in validTags.slice(0, 5) %}
                <span class="tag-pill">
                  #{{ tag }}
                </span>
              {% endfor %}
              {% if validTags.length > 5 %}
                <span
                  class="tag-pill opacity-75"
                  title="{{ validTags.slice(5) | join(', ') }}"
                >
                  +{{ validTags.length - 5 }}
                </span>
              {% endif %}
            </div>
          </div>

          <!-- Article Title -->
          <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-black leading-snug tracking-tight mb-2.5 group-hover:text-[#d97706] transition-colors">
            <a href="{{ post.url }}" class="hover:underline underline-offset-4 decoration-2">
              {{ post.data.title }}
            </a>
          </h2>

          <!-- Summary / Excerpt -->
          <p class="font-mono text-xs sm:text-sm text-black/80 leading-relaxed mb-4">
            {{ post.data.summary }}
          </p>

          <!-- Search Match Snippet (populated dynamically by Pagefind) -->
          <div class="blog-match-snippet hidden mb-4 p-3 bg-amber-500/10 border-l-4 border-amber-500 font-mono text-xs sm:text-sm text-black/90 leading-relaxed"></div>

          <!-- Read Action Button -->
          <div>
            <a
              href="{{ post.url }}"
              class="btn-brutal-yellow inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-bold shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 active:translate-y-0 active:shadow-none transition-all"
            >
              <span>READ ARTICLE</span>
              {{ icons.arrowUpRight("w-4 h-4") }}
            </a>
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- Empty Results State -->
    <div
      id="blog-no-results"
      class="hidden p-8 sm:p-12 card-brutal text-center space-y-4 my-8"
    >
      <div class="inline-block px-3 py-1.5 bg-[#f87171] border-2 border-black font-mono font-black text-xs sm:text-sm shadow-brutal-xs mx-auto mb-2 text-black">
        ERROR 404
      </div>
      <h3 class="font-sans font-black text-xl sm:text-2xl text-black">No Articles Found</h3>
      <p class="font-mono text-xs sm:text-sm text-black/75 max-w-md mx-auto">
        No articles match your query or active tag filters. Try searching for broader terms or clearing your filters.
      </p>
      <div>
        <button
          id="blog-reset-filters-btn"
          class="btn-brutal-yellow inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-bold shadow-brutal-xs cursor-pointer transition-all"
        >
          <span>RESET ALL FILTERS</span>
        </button>
      </div>
    </div>
  </main>

  {% include "components/retro-footer.njk" %}
</div>

<!-- Pagefind Static Search Engine Client -->
<script src="/assets/js/pagefind-search.js" defer></script>
