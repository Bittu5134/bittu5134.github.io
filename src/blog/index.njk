---
layout: layouts/base.njk
title: "Technical Writing & Architecture Articles | Bittu"
description: "Technical deep dives, systems engineering notes, binary protocols, and architecture write-ups by Bittu."
permalink: "/blog/index.html"
---
{% import "macros/icons.njk" as icons %}

<div class="min-h-screen bg-[#f6eedb] retro-dots-bg text-[#14161f] font-sans selection:bg-[#fde047] selection:text-black">
  {% include "components/retro-header.njk" %}

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-10" data-pagefind-ignore>
    <!-- Top Header: ~/blogs -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-4 border-b-[3px] border-black">
      <h1 class="text-4xl sm:text-5xl font-mono font-black text-black tracking-tight">
        ~/blogs
      </h1>

      <div class="flex items-center gap-2">
        <a
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-brutal bg-[#fb923c] px-3.5 py-1.5 text-sm font-mono font-bold"
          title="RSS Feed"
        >
          {{ icons.rss("w-4 h-4 text-black") }}
          <span>RSS</span>
        </a>
        <a
          href="/llms.txt"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-brutal bg-[#86efac] px-3.5 py-1.5 text-sm font-mono font-bold"
          title="LLMS.TXT"
        >
          {{ icons.terminal("w-4 h-4 text-black") }}
          <span>LLMS.TXT</span>
        </a>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="mb-8 space-y-3">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <!-- Search Input -->
        <div class="flex-1 card-brutal p-2.5 sm:p-3 bg-[#fffdf9] flex items-center gap-2 shadow-brutal-xs">
          <div class="pl-2 text-black/50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input
            type="text"
            id="blog-search-input"
            placeholder="Search articles by keyword, title, or #tag..."
            class="w-full font-mono text-sm sm:text-base text-black placeholder:text-black/45 focus:outline-none bg-transparent"
            aria-label="Search articles"
          />
          <button
            id="blog-search-clear"
            class="hidden px-2.5 py-1 font-mono text-sm font-bold bg-[#f87171] text-black border-2 border-black hover:bg-red-400 cursor-pointer"
            aria-label="Clear search"
          >
            CLEAR
          </button>
        </div>

        <!-- Sort Controls: Right next to search bar -->
        <div class="card-brutal px-3 py-2 sm:py-2.5 bg-[#fffdf9] flex items-center gap-2 shrink-0 shadow-brutal-xs">
          <label for="blog-sort-select" class="flex items-center gap-1.5 text-black font-mono text-sm font-bold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 4h18M3 10h12M3 16h6"/></svg>
            <span>SORT:</span>
          </label>
          <select
            id="blog-sort-select"
            class="bg-[#fffdf9] border-2 border-black px-2.5 py-1 cursor-pointer text-black font-mono text-sm font-bold focus:outline-none focus:bg-[#fde047]"
            aria-label="Sort articles"
          >
            <option value="date-desc">Newest First</option>
            <option value="date-asc">Oldest First</option>
            <option value="read-time-asc">Shortest Read</option>
            <option value="read-time-desc">Longest Read</option>
            <option value="title-asc">Title (A–Z)</option>
          </select>
        </div>
      </div>

      <!-- Multi-Tag Filter Row (no shadows) -->
      <div class="flex flex-wrap items-center gap-2 pt-1" id="blog-tags-container">
        <button
          class="blog-tag-filter-btn active px-3.5 py-1.5 bg-[#fde047] border-2 border-black font-mono text-sm font-black cursor-pointer select-none"
          data-tag="ALL"
        >
          ALL ({{ collections.blogs.length }})
        </button>
        {% for tag in collections.blogTags %}
          <button
            class="blog-tag-filter-btn px-3.5 py-1.5 bg-[#fffdf9] hover:bg-[#fde047] border-2 border-black font-mono text-sm font-bold text-black cursor-pointer select-none transition-colors"
            data-tag="{{ tag }}"
          >
            #{{ tag }}
          </button>
        {% endfor %}
      </div>

      <!-- Search Count Status: Clean and purely functional -->
      <div id="blog-search-status" class="hidden font-mono text-sm text-black/80 font-bold px-1">
        <span id="blog-search-count"></span>
      </div>
    </div>

    <!-- Articles List Container -->
    <div class="space-y-6" id="blog-posts-list">
      {% for post in collections.blogs %}
        <article
          class="blog-post-card card-brutal p-6 sm:p-7 group shadow-brutal hover:shadow-brutal-lg hover:-translate-y-0.5 transition-all"
          data-slug="{{ post.data.slug or post.fileSlug }}"
          data-title="{{ (post.data.title or '') | lower }}"
          data-summary="{{ (post.data.summary or '') | lower }}"
          data-tags="{{ (post.data.tags or []) | join('|||') | lower }}"
          data-date="{{ (post.data.date or post.date) | dateIso }}"
          data-readtime="{{ post.data.readTime or '3 min read' }}"
        >
          <div>
            <!-- Metadata Stamp Bar: Date in its box & Read Time -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b-2 border-black/10">
              <div class="flex items-center gap-2.5">
                <span class="px-2.5 py-1 bg-[#86efac] border-2 border-black font-mono text-sm font-bold text-black">
                  <time datetime="{{ (post.data.date or post.date) | dateIso }}">{{ (post.data.displayDate or post.data.date) | upper }}</time>
                </span>
                <span class="font-mono text-sm text-black/70 font-bold">
                  // {{ (post.data.readTime or '3 min read') | upper }}
                </span>
              </div>

              <!-- Tags (no shadows) -->
              <div class="flex flex-wrap gap-1.5">
                {% for tag in post.data.tags %}
                  {% if tag != "posts" %}
                    <span class="tag-pill">
                      #{{ tag }}
                    </span>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            <!-- Title -->
            <h2 class="text-2xl sm:text-3xl font-black text-black mb-3 group-hover:text-[#d97706] transition-colors">
              <a href="{{ post.url }}" class="hover:underline underline-offset-4">
                {{ post.data.title }}
              </a>
            </h2>

            <!-- Summary -->
            <p class="font-mono text-sm sm:text-base text-black/80 leading-relaxed mb-5">
              {{ post.data.summary }}
            </p>

            <!-- Search Snippet -->
            <div class="blog-match-snippet hidden mb-5 p-3 bg-amber-500/10 border-l-4 border-amber-500 font-mono text-sm text-black/90 leading-relaxed"></div>

            <!-- Bottom Action Button -->
            <div>
              <a
                href="{{ post.url }}"
                class="btn-brutal-yellow inline-flex items-center gap-2 px-4 py-2 text-sm font-bold shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 active:translate-y-0 active:shadow-none transition-all"
              >
                <span>READ ARTICLE</span>
                {{ icons.arrowRight("w-4 h-4") }}
              </a>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- No Search Results State -->
    <div
      id="blog-no-results"
      class="hidden p-8 sm:p-12 card-brutal text-center space-y-4 my-8"
    >
      <div class="inline-block px-3 py-1.5 bg-[#f87171] border-2 border-black font-mono font-black text-sm shadow-brutal-xs mx-auto mb-2 text-black">
        ERROR 404
      </div>
      <h3 class="font-sans font-black text-xl sm:text-2xl text-black">No Articles Found</h3>
      <p class="font-mono text-sm sm:text-base text-black/75 max-w-md mx-auto">
        No articles match your search or active filters.
      </p>
      <button
        id="blog-reset-filters-btn"
        class="btn-brutal-yellow inline-flex items-center gap-2 px-4 py-2 text-sm font-bold shadow-brutal-xs cursor-pointer transition-all"
      >
        <span>RESET ALL FILTERS</span>
      </button>
    </div>
  </main>

  {% include "components/retro-footer.njk" %}
</div>

<!-- Industry Standard Static File Search: Pagefind Wasm -->
<script src="/assets/js/pagefind-search.js" defer></script>
