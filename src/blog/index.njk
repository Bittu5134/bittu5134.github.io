---
layout: layouts/base.njk
title: "Technical Writing & Architecture Dispatches | Bittu"
description: "Essays and technical deep dives into low-level systems, protocol reverse engineering, high-throughput WebRTC signaling, and 2D spatial parsing by Bittu."
permalink: "/blog/index.html"
---
{% import "macros/icons.njk" as icons %}

<div class="min-h-screen bg-[#f6eedb] retro-dots-bg text-[#14161f] font-sans selection:bg-[#fde047] selection:text-black">
  {% include "components/retro-header.njk" %}

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12" data-pagefind-ignore>
    <!-- Header Hero Banner -->
    <div class="p-6 sm:p-8 card-brutal shadow-brutal-lg mb-8 bg-[#fffdf9]">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b-2 border-black/15">
        <div class="inline-block px-3 py-1 bg-[#fde047] border-2 border-black font-mono text-xs font-bold shadow-brutal-xs">
          TECHNICAL ARCHIVE &amp; DISPATCHES
        </div>

        <div class="flex items-center gap-2">

          <a
            href="/rss.xml"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-brutal bg-[#fb923c] px-3 py-1 text-xs"
            title="Subscribe via RSS 2.0 feed"
          >
            {{ icons.rss("w-3.5 h-3.5 text-black") }}
            <span>RSS FEED</span>
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-brutal bg-[#86efac] px-3 py-1 text-xs"
            title="LLM Context Index per llmstxt.org"
          >
            {{ icons.terminal("w-3.5 h-3.5 text-black") }}
            <span>LLMS.TXT</span>
          </a>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-black mb-3 tracking-tight">
        Technical Writing
      </h1>
      <p class="font-mono text-sm sm:text-base text-black/80 max-w-3xl leading-relaxed">
        Deep dives into low-level systems, binary network protocols, high-throughput WebRTC signaling servers in Go, and geometric algorithms in Python.
      </p>

      <div class="mt-4 pt-3 border-t border-black/15 flex flex-wrap items-center gap-3 font-mono text-xs font-bold text-black/70">
        <span>TOTAL: {{ collections.blogs.length }} DISPATCHES</span>
        <span>•</span>
        <span>SSG PRE-COMPILED</span>
        <span>•</span>
        <span>ZERO RUNTIME JS HIGHLIGHTING</span>
      </div>
    </div>

    <!-- Search & Tag Filter Controls -->
    <div class="mb-8 space-y-4">
      <!-- Search Input -->
      <div class="card-brutal p-2 sm:p-3 bg-[#fffdf9] flex items-center gap-2 shadow-brutal-xs">
        <div class="pl-2 text-black/50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <input
          type="text"
          id="blog-search-input"
          placeholder="Filter articles by keyword, title, topic, or tag (e.g., Go, Redis, Minecraft, PyMuPDF)..."
          class="w-full font-mono text-xs sm:text-sm text-black placeholder:text-black/40 focus:outline-none bg-transparent"
          aria-label="Search articles"
        />
        <button
          id="blog-search-clear"
          class="hidden px-2 py-0.5 font-mono text-xs font-bold bg-[#f87171] text-black border border-black hover:bg-red-400"
          aria-label="Clear search"
        >
          CLEAR
        </button>
      </div>

      <!-- Search Feedback Bar -->
      <div id="blog-search-status" class="hidden flex items-center justify-between font-mono text-xs px-1 text-black/70">
        <span id="blog-search-count" class="font-bold"></span>
        <span class="text-black/50 dark:text-white/50 text-[11px] uppercase tracking-wider flex items-center gap-1">
          <span>Indexed by Pagefind (Wasm)</span>
        </span>
      </div>

      <!-- Tag Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5" id="blog-tags-container">
        <button
          class="blog-tag-filter-btn active px-3 py-1 bg-[#fde047] border-2 border-black font-mono text-xs font-bold shadow-brutal-xs -translate-y-0.5 cursor-pointer select-none"
          data-tag="ALL"
        >
          ALL ({{ collections.blogs.length }})
        </button>
        {% for tag in collections.blogTags %}
          <button
            class="blog-tag-filter-btn px-3 py-1 bg-[#fffdf9] hover:bg-[#fde047] border-2 border-black font-mono text-xs font-bold transition-all cursor-pointer select-none"
            data-tag="{{ tag }}"
          >
            #{{ tag | upper }}
          </button>
        {% endfor %}
      </div>
    </div>

    <!-- Articles List Container -->
    <div class="space-y-6 sm:space-y-8" id="blog-posts-list">
      {% for post in collections.blogs %}
        <article
          class="blog-post-card card-brutal p-5 sm:p-7 md:p-8 group bg-[#fffdf9] transition-all"
          data-slug="{{ post.data.slug or post.fileSlug }}"
          data-title="{{ (post.data.title or '') | lower }}"
          data-summary="{{ (post.data.summary or '') | lower }}"
          data-tags="{{ (post.data.tags or []) | join(' ') | lower }}"
        >
          <div>
            <!-- Metadata Stamp Bar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 pb-3 border-b-2 border-black/10">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-1 bg-[#86efac] border border-black font-mono text-xs font-bold text-black shadow-brutal-xs">
                  STAMP: {{ (post.data.displayDate or post.data.date) | upper }}
                </span>
                <span class="font-mono text-xs sm:text-sm text-black/60 font-bold">
                  // {{ (post.data.readTime or '5 min read') | upper }}
                </span>
              </div>

              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5">
                {% for tag in post.data.tags %}
                  {% if tag != "posts" %}
                    <span class="tag-pill">
                      #{{ tag | upper }}
                    </span>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            <!-- Title -->
            <h2 class="text-2xl sm:text-3xl font-black text-black mb-3 group-hover:text-[#d97706] transition-colors">
              <a href="{{ post.url }}" class="hover:underline underline-offset-4">
                {{ post.data.title }}
              </a>
            </h2>

            <!-- Summary -->
            <p class="font-mono text-xs sm:text-sm text-black/80 leading-relaxed mb-4">
              {{ post.data.summary }}
            </p>

            <!-- Search Content Match Snippet (Populated dynamically when matching in body) -->
            <div class="blog-match-snippet hidden mb-6 p-3 bg-amber-500/10 border-l-4 border-amber-500 rounded-r font-mono text-xs text-black/80 leading-relaxed"></div>

            <!-- Bottom CTA Button -->
            <div class="flex items-center justify-between pt-1">
              <a
                href="{{ post.url }}"
                class="btn-brutal-yellow px-4 py-2 text-xs sm:text-sm"
              >
                <span>READ DISPATCH</span>
                {{ icons.arrowRight("w-4 h-4") }}
              </a>

              <span class="font-mono text-xs text-black/60 font-bold">
                {{ (post.data.readTime or '5 min read') | upper }}
              </span>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- No Search Results Found State -->
    <div
      id="blog-no-results"
      class="hidden p-8 sm:p-12 card-brutal bg-[#fffdf9] text-center space-y-4 my-8"
    >
      <div class="w-12 h-12 mx-auto bg-[#f87171] border-2 border-black flex items-center justify-center shadow-brutal-xs font-mono font-black text-xl">
        !
      </div>
      <h3 class="font-sans font-black text-xl text-black">No Dispatches Found</h3>
      <p class="font-mono text-xs sm:text-sm text-black/70 max-w-md mx-auto">
        No articles match your current search query or active tag filter.
      </p>
      <button
        id="blog-reset-filters-btn"
        class="btn-brutal-yellow px-4 py-2 text-xs sm:text-sm inline-flex"
      >
        <span>RESET ALL FILTERS</span>
      </button>
    </div>
  </main>
</div>

<!-- Industry Standard Static File Search: Pagefind Wasm -->
<script src="/assets/js/pagefind-search.js" defer></script>


