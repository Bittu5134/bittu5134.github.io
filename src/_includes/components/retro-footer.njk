{% import "macros/icons.njk" as icons %}

<footer class="mt-10 sm:mt-16 border-t-[3px] border-black bg-[#f6eedb] py-8 sm:py-12 px-3 sm:px-6">
  <div class="max-w-5xl mx-auto flex flex-col items-center text-center gap-6 sm:gap-8">
    <!-- Discrete Tip-Jar / Patreon Support -->
    <div class="w-full max-w-2xl bg-[#fffdf9] border-[3px] border-black shadow-brutal p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4 text-left">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          {{ icons.coffee("w-4 h-4 text-black shrink-0") }}
          <h3 class="font-mono text-xs sm:text-sm font-black text-black uppercase tracking-wide">
            SUPPORT ON PATREON: @lazybittu
          </h3>
        </div>
        <p class="font-mono text-xs sm:text-sm text-black/80 leading-relaxed">
          Enjoy my open-source tools, reverse-engineering work, and low-level systems tinkering? Consider becoming a patron to fuel future builds.
        </p>
      </div>
      <a
        href="https://www.patreon.com/lazybittu"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutal-pink px-4 py-2 text-xs sm:text-sm shrink-0"
      >
        {{ icons.heart("w-3.5 h-3.5 text-black fill-current shrink-0") }}
        <span>BECOME A PATRON</span>
        {{ icons.arrowUpRight("w-3.5 h-3.5 text-black shrink-0") }}
      </a>
    </div>

    <!-- Key Contact & Social Channels -->
    <div class="space-y-3 w-full">
      <div class="font-mono text-xs font-bold text-black/60 uppercase tracking-widest">
        CONNECT &amp; GET IN TOUCH
      </div>
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
        <a
          href="mailto:hello@bittu.dev"
          aria-label="Send Email to hello@bittu.dev"
          class="btn-brutal bg-[#fef08a] hover:bg-[#fde047] text-black px-3 py-1.5 text-xs sm:text-sm"
        >
          {{ icons.mail("w-4 h-4 text-black shrink-0") }}
          <span class="font-mono">hello@bittu.dev</span>
        </a>

        <a
          href="https://github.com/Bittu5134"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Profile (@Bittu5134)"
          class="btn-brutal-purple text-black px-3 py-1.5 text-xs sm:text-sm"
        >
          {{ icons.github("w-4 h-4 text-black shrink-0") }}
          <span class="font-mono">GitHub</span>
        </a>

        <a
          href="https://www.linkedin.com/in/bittu5134"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn Profile (Bittu)"
          class="btn-brutal bg-[#38bdf8] hover:bg-[#7dd3fc] text-black px-3 py-1.5 text-xs sm:text-sm"
        >
          {{ icons.linkedin("w-4 h-4 text-black shrink-0") }}
          <span class="font-mono">LinkedIn</span>
        </a>

        <a
          href="/discord"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Discord Community"
          class="btn-brutal bg-[#c4b5fd] hover:bg-[#a78bfa] text-black px-3 py-1.5 text-xs sm:text-sm"
        >
          {{ icons.discord("w-4 h-4 text-black shrink-0") }}
          <span class="font-mono">Discord</span>
        </a>

        <a
          href="https://x.com/bittu5134"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X / Twitter (@bittu5134)"
          class="btn-brutal bg-[#fffdf9] hover:bg-[#fde047] text-black px-3 py-1.5 text-xs sm:text-sm"
        >
          {{ icons.twitter("w-4 h-4 text-black shrink-0") }}
          <span class="font-mono">X / Twitter</span>
        </a>
      </div>
    </div>

    <!-- Back to top button -->
    <a
      href="#hero"
      class="cursor-pointer px-4 py-2 bg-[#86efac] text-black font-mono text-xs sm:text-sm font-bold border-2 border-black shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all flex items-center gap-1.5"
    >
      <span>▲ RETURN TO TOP</span>
    </a>

    <!-- Copyright -->
    <div class="space-y-1 font-mono text-xs sm:text-sm text-black/70">
      <p class="font-bold">
        &copy; 2026 Bittu (Bittu5134) &middot; IIT Kanpur
      </p>
    </div>
  </div>
</footer>
