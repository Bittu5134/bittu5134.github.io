{% import "macros/icons.njk" as icons %}

<section id="blog" class="py-6 sm:py-8 px-3 sm:px-6 scroll-mt-16 sm:scroll-mt-20">
  <div class="max-w-5xl mx-auto">
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4 mb-6 sm:mb-8">
      <div>
        <div class="inline-block px-2.5 py-0.5 bg-[#fde047] border border-black font-mono text-xs font-bold shadow-brutal-xs mb-2">
          WRITING &amp; ESSAYS
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-sans font-black text-black tracking-tight">
          Recent Dispatches
        </h2>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <a
          href="/blog"
          class="btn-brutal-yellow px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm"
        >
          {{ icons.bookOpen("w-4 h-4") }}
          <span>ALL ARTICLES ({{ collections.blogs.length }})</span>
          {{ icons.arrowUpRight("w-3.5 h-3.5") }}
        </a>
        <a
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-brutal bg-[#fb923c] px-3 sm:px-3.5 py-1.5 sm:py-2 text-xs sm:text-sm"
          title="Subscribe via RSS"
        >
          {{ icons.rss("w-4 h-4") }}
          <span>RSS</span>
        </a>
      </div>
    </div>

    <!-- Zine Articles Stack -->
    <div class="space-y-4 sm:space-y-6">
      {% for post in collections.blogs.slice(0, 3) %}
        <article class="card-brutal overflow-hidden group bg-[#fffdf9]">
          {% if post.data.coverImage %}
            <a
              href="{{ post.url }}"
              class="block overflow-hidden border-b-[3px] border-black bg-[#12151e]"
              aria-label="Read {{ post.data.title }}"
            >
              <img
                src="{{ post.data.coverImage }}"
                alt="{{ post.data.coverAlt if post.data.coverAlt else post.data.title }}"
                class="w-full h-36 sm:h-48 md:h-56 object-cover group-hover:scale-[1.01] transition-transform duration-300"
                loading="lazy"
              />
            </a>
          {% endif %}

          <div class="p-5 sm:p-7">
            <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 mb-3 pb-3 border-b-2 border-black/10">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 bg-[#86efac] border border-black font-mono text-xs font-bold text-black shadow-brutal-xs">
                  {{ (post.data.displayDate or post.data.date) | upper }}
                </span>
                <span class="font-mono text-xs sm:text-sm text-black/60 font-bold">
                  // {{ (post.data.readTime or '5 min read') | upper }}
                </span>
              </div>

              <div class="flex flex-wrap gap-1.5">
                {% for tag in post.data.tags %}
                  {% if tag != "posts" %}
                    <span class="tag-pill">
                      #{{ tag | upper }}
                    </span>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            <h3 class="text-2xl sm:text-3xl font-black text-black mb-3 group-hover:text-[#d97706] transition-colors">
              <a href="{{ post.url }}" class="hover:underline underline-offset-4">
                {{ post.data.title }}
              </a>
            </h3>

            <p class="font-mono text-xs sm:text-sm text-black/80 leading-relaxed mb-5">
              {{ post.data.summary }}
            </p>

            <div class="flex items-center justify-between pt-2">
              <a
                href="{{ post.url }}"
                class="btn-brutal-yellow px-4 py-2 text-xs sm:text-sm"
              >
                <span>READ DISPATCH</span>
                {{ icons.arrowUpRight("w-4 h-4") }}
              </a>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
