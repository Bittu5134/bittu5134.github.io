{% import "macros/icons.njk" as icons %}

<section id="blog" class="py-6 sm:py-8 px-3 sm:px-6 scroll-mt-16 sm:scroll-mt-20">
  <div class="max-w-5xl mx-auto">
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4 mb-6 sm:mb-8">
      <div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-mono font-black text-black tracking-tight">
          ~/blog
        </h2>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <a
          href="/blog"
          class="btn-brutal-yellow px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm"
        >
          {{ icons.bookOpen("w-4 h-4") }}
          <span>ALL ARTICLES ({{ blogs | length }})</span>
          {{ icons.arrowUpRight("w-3.5 h-3.5") }}
        </a>
        <a
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-brutal bg-[#fb923c] px-3 sm:px-3.5 py-1.5 sm:py-2 text-xs sm:text-sm"
        >
          {{ icons.rss("w-4 h-4") }}
          <span>RSS 2.0</span>
        </a>
      </div>
    </div>

    <!-- Zine Articles Stack -->
    <div class="space-y-4 sm:space-y-6">
      {% for post in blogs %}
        <article class="card-brutal p-4 sm:p-8 group">
          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 mb-3 pb-3 border-b-2 border-black/10">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 bg-[#86efac] border border-black font-mono text-xs font-bold text-black">
                {{ post.date | upper }}
              </span>
              <span class="font-mono text-xs sm:text-sm text-black/60 font-bold">
                // {{ post.readTime | upper }}
              </span>
            </div>

            <div class="flex flex-wrap gap-1.5">
              {% for tag in post.tags %}
                <span class="tag-pill">
                  #{{ tag }}
                </span>
              {% endfor %}
            </div>
          </div>

          <h3 class="text-2xl sm:text-3xl font-black text-black mb-3 group-hover:text-[#d97706] transition-colors">
            <a href="/blog/{{ post.slug }}" class="hover:underline underline-offset-4">
              {{ post.title }}
            </a>
          </h3>

          <p class="font-mono text-xs sm:text-sm text-black/80 leading-relaxed mb-5">
            {{ post.summary }}
          </p>

          <div class="flex items-center justify-between pt-2">
            <a
              href="/blog/{{ post.slug }}"
              class="btn-brutal-yellow px-4 py-2 text-xs sm:text-sm"
            >
              <span>READ DISPATCH</span>
              {{ icons.arrowUpRight("w-4 h-4") }}
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
