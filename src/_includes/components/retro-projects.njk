{% import "macros/icons.njk" as icons %}

<section id="projects" class="py-14 sm:py-20 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 mb-10">
      <div>
    <h2 class="heading-pop font-display text-5xl sm:text-6xl text-black leading-none">Projects</h2>
      </div>

      <!-- Filter pills: same hooks the filter script reads -->
      <div id="project-filters" class="flex flex-wrap gap-2">
        {% for cat in projects.categories %}
          <button
            data-filter="{{ cat }}"
            class="project-filter-btn px-4 py-2.5 border-2 border-black font-mono text-sm font-bold transition-all cursor-pointer {{ 'bg-[#fde047] shadow-brutal-xs' if loop.first else 'bg-[#fffdf9] hover:bg-[#fde047]' }}"
          >
            {{ cat | lower }}
          </button>
        {% endfor %}
      </div>
    </div>

    <!-- Pinned projects rendered server-side; the rest are injected on filter click -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {% for p in projects.projects %}
        {% if p.isPinned %}
          <article
            class="project-card group relative  border-[3px] border-black bg-[#fffdf9] shadow-brutal flex flex-col transition-transform hover:-translate-y-1 hover:rotate-0 {{ 'rotate-[-0.6deg]' if loop.index is even else 'rotate-[0.6deg]' }}"
            data-filter-category="{{ p.filterCategory }}"
            data-category="{{ p.category }}"
            data-pinned="true"
            data-popularity="{{ (p.stars or 0) + (p.forks or 0) }}"
            data-order="{{ p.order or 99 }}"
          >
            <div class="h-4 w-full  border-b-[3px] border-black {{ p.headerBgClass }}"></div>
            <div class="p-6 sm:p-7 flex flex-col gap-4 flex-1">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-display text-3xl text-black leading-tight">{{ p.title }}</h3>
              <div class="flex items-center gap-2 shrink-0 font-mono text-sm font-bold text-black/70">
                {% if p.stars > 0 %}
                  <span class="flex items-center gap-1" title="{{ p.stars }} stars on GitHub">{{ icons.star("w-3.5 h-3.5 text-[#f59e0b] fill-[#f59e0b]") }}{{ p.stars }}</span>
                {% endif %}
                {% if p.forks > 0 %}
                  <span class="flex items-center gap-1" title="{{ p.forks }} forks on GitHub">{{ icons.gitFork("w-3.5 h-3.5 text-black/70") }}{{ p.forks }}</span>
                {% endif %}
              </div>
            </div>

            {% if p.language or p.statsText %}
              <p class="font-mono text-sm font-bold text-black/65">
                {% if p.language %}{{ p.language }}{% endif %}
                {% if p.language and p.statsText %} · {% endif %}
                {% if p.statsText %}{{ p.statsText }}{% endif %}
              </p>
            {% endif %}

            <p class="font-body text-base text-black/85 leading-relaxed flex-1">{{ p.description }}</p>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
              <div class="flex flex-wrap gap-1.5">
                {% for tag in p.tags %}
                  <span class="font-mono text-sm font-bold text-black/60">#{{ tag | lower }}</span>
                {% endfor %}
              </div>
              <div class="flex items-center gap-2">
                {% if p.liveUrl %}
                  <a href="{{ p.liveUrl }}" target="_blank" rel="noopener noreferrer" class="btn-pill bg-[#fde047] !px-3.5 !py-1.5 !text-sm">Visit {{ icons.arrowUpRight("w-3.5 h-3.5 text-black") }}</a>
                {% endif %}
                {% if p.githubUrl %}
                  <a href="{{ p.githubUrl }}" target="_blank" rel="noopener noreferrer" class="btn-pill bg-[#fffdf9] hover:bg-[#86efac] !px-3.5 !py-1.5 !text-sm">{{ icons.github("w-3.5 h-3.5 text-black") }} GitHub</a>
                {% endif %}
              </div>
            </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Non-pinned projects: embedded as JSON, rendered client-side on filter click -->
    <script id="non-pinned-projects-data" type="application/json">
    [
      {% for p in projects.projects %}
        {% if not p.isPinned %}
          {
            "title": {{ p.title | dump | safe }},
            "filterCategory": {{ p.filterCategory | dump | safe }},
            "category": {{ p.category | dump | safe }},
            "popularity": {{ (p.stars or 0) + (p.forks or 0) }},
            "order": {{ p.order or 99 }},
            "stars": {{ p.stars or 0 }},
            "forks": {{ p.forks or 0 }},
            "language": {{ p.language | dump | safe }},
            "languageColor": {{ p.languageColor | dump | safe }},
            "statsText": {{ p.statsText | dump | safe }},
            "description": {{ p.description | dump | safe }},
            "tags": {{ p.tags | dump | safe }},
            "liveUrl": {{ p.liveUrl | dump | safe }},
            "githubUrl": {{ p.githubUrl | dump | safe }},
            "headerBgClass": {{ p.headerBgClass | dump | safe }}
          }{% if not loop.last %},{% endif %}
        {% endif %}
      {% endfor %}
    ]
    </script>

    <div class="mt-12 flex flex-col sm:flex-row sm:items-center gap-4 border-t-2 border-black/15 pt-8">
      <p class="heading-pop font-display text-3xl sm:text-4xl text-black leading-tight">More tools, prototypes and scripts</p>
      <a href="https://github.com/Bittu5134?tab=repositories" target="_blank" rel="noopener noreferrer" class="btn-pill bg-[#fde047] justify-self-start sm:ml-auto">On GitHub {{ icons.github("w-4 h-4 text-black") }}</a>
    </div>
  </div>
</section>
