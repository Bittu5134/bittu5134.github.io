{% import "macros/icons.njk" as icons %}

<section id="projects" class="py-6 sm:py-8 px-3 sm:px-6 scroll-mt-16 sm:scroll-mt-20">
  <div class="max-w-5xl mx-auto">
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4 mb-6 sm:mb-8">
      <div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-mono font-black text-black tracking-tight">
          ~/projects
        </h2>
      </div>

      <!-- Data-Driven Filter Pills -->
      <div id="project-filters" class="flex flex-wrap gap-1.5 sm:gap-2 font-mono text-xs font-bold">
        {% for cat in projects.categories %}
          <button
            data-filter="{{ cat }}"
            class="project-filter-btn px-2.5 sm:px-3 py-1 sm:py-1.5 border-2 border-black transition-all cursor-pointer {{ 'bg-[#fde047] shadow-brutal-xs font-black -translate-y-0.5' if loop.first else 'bg-[#fffdf9] hover:bg-[#f6eedb]' }}"
          >
            [{{ cat }}]
          </button>
        {% endfor %}
      </div>
    </div>

    <!-- Projects Grid (4 at once per filter) -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-8">
      {% for p in projects.projects %}
        <div
          class="project-card card-brutal flex flex-col justify-between {{ 'hidden' if loop.index > 4 else '' }}"
          data-filter-category="{{ p.filterCategory }}"
          data-category="{{ p.category }}"
        >
          <!-- Window Header -->
          <div class="card-header-bar gap-2 {{ p.headerBgClass }}">
            <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
              <span class="w-2.5 h-2.5 bg-black shrink-0"></span>
              <span class="font-mono text-xs font-bold text-black uppercase tracking-wider truncate">
                {{ p.category }}
              </span>
            </div>
            <span class="font-mono text-xs bg-black text-white px-2 py-0.5 font-bold shrink-0">
              {{ p.badge }}
            </span>
          </div>

          <!-- Body -->
          <div class="p-4 sm:p-6 flex flex-col flex-1 justify-between">
            <div>
              <h3 class="text-xl sm:text-2xl font-black text-black mb-1">
                {{ p.title }}
              </h3>
              <div class="font-mono text-xs font-bold text-[#d97706] mb-3">
                {{ p.statsText }}
              </div>
              <p class="font-mono text-xs sm:text-sm text-black/80 leading-relaxed mb-4">
                {{ p.description }}
              </p>
            </div>

            <div>
              <!-- Tag Pills -->
              <div class="flex flex-wrap gap-1.5 mb-4 sm:mb-5">
                {% for tag in p.tags %}
                  <span class="tag-pill">
                    #{{ tag }}
                  </span>
                {% endfor %}
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap items-center gap-2 sm:gap-3 pt-3 border-t-2 border-black/10">
                {% if p.liveUrl %}
                  <a
                    href="{{ p.liveUrl }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-brutal-yellow px-3 sm:px-3.5 py-1.5 sm:py-2 text-xs"
                  >
                    <span>LIVE DEMO</span>
                    {{ icons.arrowUpRight("w-3.5 h-3.5 text-black shrink-0") }}
                  </a>
                {% endif %}
                {% if p.githubUrl %}
                  <a
                    href="{{ p.githubUrl }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-brutal-white px-3 sm:px-3.5 py-1.5 sm:py-2 text-xs hover:bg-[#86efac]"
                  >
                    <span>SOURCE CODE</span>
                    {{ icons.arrowUpRight("w-3.5 h-3.5 text-black shrink-0") }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- GitHub link note -->
    <div class="mt-6 sm:mt-8 p-3.5 sm:p-4 bg-[#fffdf9] border-2 border-black shadow-brutal-xs flex items-center justify-between flex-wrap gap-3 sm:gap-4 font-mono text-xs sm:text-sm font-bold">
      <span class="text-black/70">
        Looking for more tools, prototypes, and scripts?
      </span>
      <a
        href="https://github.com/Bittu5134?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutal bg-[#c4b5fd] px-3 py-1.5 text-xs sm:text-sm"
      >
        <span>VIEW 25+ REPOSITORIES ON GITHUB</span>
        {{ icons.arrowUpRight("w-3.5 h-3.5 text-black shrink-0") }}
      </a>
    </div>

    <!-- Patreon Support Banner -->
    <div class="mt-4 p-4 sm:p-6 bg-[#fef08a] border-[3px] border-black shadow-brutal flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          {{ icons.coffee("w-5 h-5 text-black shrink-0") }}
          <h3 class="font-mono text-sm sm:text-base font-black text-black uppercase tracking-wide">
            SUPPORT ON PATREON: @lazybittu
          </h3>
        </div>
        <p class="font-mono text-xs sm:text-sm text-black/85 leading-relaxed">
          Enjoy my open-source tools, reverse-engineering work, and low-level systems tinkering? Consider becoming a patron to fuel future builds and infra costs.
        </p>
      </div>
      <a
        href="https://www.patreon.com/lazybittu"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutal-pink px-4 py-2.5 text-xs sm:text-sm shrink-0"
      >
        {{ icons.heart("w-4 h-4 text-black fill-current shrink-0") }}
        <span>BECOME A PATRON</span>
        {{ icons.arrowUpRight("w-4 h-4 text-black shrink-0") }}
      </a>
    </div>
  </div>
</section>
