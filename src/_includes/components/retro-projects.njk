{% import "macros/icons.njk" as icons %}

<section id="projects" class="py-6 sm:py-8 px-3 sm:px-6 scroll-mt-16 sm:scroll-mt-20">
  <div class="max-w-5xl mx-auto">
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4 mb-6 sm:mb-8">
      <div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-mono font-black text-black tracking-tight">
          ~/projects
        </h2>
      </div>

      <!-- Data-Driven Filter Pills -->
      <div id="project-filters" class="flex flex-wrap gap-1.5 sm:gap-2 font-mono text-xs font-bold">
        {% for cat in projects.categories %}
          <button
            data-filter="{{ cat }}"
            class="project-filter-btn px-2.5 sm:px-3 py-1 sm:py-1.5 border-2 border-black transition-all cursor-pointer {{ 'bg-[#fde047] shadow-brutal-xs font-black -translate-y-0.5' if loop.first else 'bg-[#fffdf9] hover:bg-[#f6eedb]' }}"
          >
            [{{ cat }}]
          </button>
        {% endfor %}
      </div>
    </div>

    <!-- Projects Grid (4 at once per filter) -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-8">
      {% for p in projects.projects %}
        <div
          class="project-card card-brutal flex flex-col justify-between overflow-hidden {{ 'hidden' if not p.isPinned else '' }}"
          data-filter-category="{{ p.filterCategory }}"
          data-category="{{ p.category }}"
          data-pinned="{{ 'true' if p.isPinned else 'false' }}"
          data-popularity="{{ (p.stars or 0) + (p.forks or 0) }}"
        >
          <!-- Solid Colour Bar -->
          <div class="hidden sm:block h-6 w-full border-b-[3px] border-black {{ p.headerBgClass }}"></div>

          <!-- Body -->
          <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between">
            <div>
              <div class="flex items-start justify-between gap-2 mb-1">
                <h3 class="text-xl sm:text-2xl font-black text-black">
                  {{ p.title }}
                </h3>
                <div class="flex items-center gap-1.5 shrink-0">
                  {% if p.stars > 0 %}
                    <span class="inline-flex items-center gap-1 font-mono text-xs font-bold text-black/80 bg-[#fffdf9] border border-black px-1.5 py-0.5" title="{{ p.stars }} stargazers on GitHub">
                      {{ icons.star("w-3.5 h-3.5 text-[#f59e0b] fill-[#f59e0b] shrink-0") }}
                      <span>{{ p.stars }}</span>
                    </span>
                  {% endif %}
                  {% if p.forks > 0 %}
                    <span class="inline-flex items-center gap-1 font-mono text-xs font-bold text-black/80 bg-[#fffdf9] border border-black px-1.5 py-0.5" title="{{ p.forks }} forks on GitHub">
                      {{ icons.gitFork("w-3.5 h-3.5 text-black/70 shrink-0") }}
                      <span>{{ p.forks }}</span>
                    </span>
                  {% endif %}
                </div>
              </div>

              <!-- Live Signals: Language Dot + Handcrafted Stats -->
              <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs font-bold text-black/70 mb-3">
                {% if p.language %}
                  <span class="inline-flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full border border-black/40 shrink-0" style="background-color: {{ p.languageColor }}"></span>
                    <span>{{ p.language }}</span>
                  </span>
                {% endif %}
                {% if p.statsText %}
                  {% if p.language %}<span class="text-black/30">/</span>{% endif %}
                  <span class="text-[#d97706]">{{ p.statsText }}</span>
                {% endif %}
              </div>

              <p class="font-mono text-xs sm:text-sm text-black/80 leading-relaxed mb-4">
                {{ p.description }}
              </p>
            </div>

            <div>
              <!-- Tag Pills -->
              <div class="flex flex-wrap gap-1.5 mb-4 sm:mb-5">
                {% for tag in p.tags %}
                  <span class="tag-pill">
                    #{{ tag | upper }}
                  </span>
                {% endfor %}
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap items-center gap-2 sm:gap-3 pt-3 border-t-2 border-black/10">
                {% if p.liveUrl %}
                  <a
                    href="{{ p.liveUrl }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-brutal-yellow px-3 sm:px-3.5 py-1.5 sm:py-2 text-xs"
                  >
                    <span>LIVE DEMO</span>
                    {{ icons.arrowUpRight("w-3.5 h-3.5 text-black shrink-0") }}
                  </a>
                {% endif %}
                {% if p.githubUrl %}
                  <a
                    href="{{ p.githubUrl }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-brutal-white px-3 sm:px-3.5 py-1.5 sm:py-2 text-xs hover:bg-[#86efac]"
                  >
                    {{ icons.github("w-3.5 h-3.5 text-black shrink-0") }}
                    <span>GITHUB</span>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- GitHub link note -->
    <div class="mt-6 sm:mt-8 p-3.5 sm:p-4 bg-[#fffdf9] border-2 border-black shadow-brutal-xs flex items-center justify-between flex-wrap gap-3 sm:gap-4 font-mono text-xs sm:text-sm font-bold">
      <span class="text-black/80">
        Looking for more tools, prototypes, and scripts?
      </span>
      <a
        href="https://github.com/Bittu5134?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutal bg-[#c4b5fd] px-3 py-1.5 text-xs sm:text-sm"
      >
        {# <span>VIEW {{ projects.totalReposCount if projects.totalReposCount else "ALL" }} REPOSITORIES ON GITHUB</span> #}
        <span>VIEW {{ projects.totalReposCount if projects.totalReposCount else "ALL" }}+ PROJECTS ON GITHUB</span>
        {# <span>VIEW ALL PROJECTS ON GITHUB</span> #}
        {{ icons.arrowUpRight("w-3.5 h-3.5 text-black shrink-0") }}
      </a>
    </div>
  </div>
</section>

