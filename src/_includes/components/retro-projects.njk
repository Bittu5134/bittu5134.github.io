{% import "macros/icons.njk" as icons %}

<section id="projects" class="py-14 sm:py-20 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 mb-10">
      <div class="relative sm:inline-block">
        <span class="hidden sm:block absolute pointer-events-none z-10" style="bottom:100%; left:1.5rem" aria-hidden="true">
          <img src="/images/Copper_Golem_Walking_Animation_Pixel_art.gif" alt="" width="74" height="74" loading="lazy" class="w-14 h-auto">
        </span>
        <h2 class="heading-pop font-display text-5xl sm:text-6xl text-black leading-none">Projects</h2>
      </div>

      <!-- Filter chips: same hooks the filter script reads -->
      <div id="project-filters" class="inline-flex flex-wrap gap-1 border-2 border-black bg-[#fffdf9] p-1">
        {% for cat in projects.categories %}
          <button
            data-filter="{{ cat }}"
            class="project-filter-btn filter-chip {{ 'is-active' if loop.first }}"
          >
            {{ cat | lower }}
          </button>
        {% endfor %}
      </div>
    </div>

    <!-- Pinned projects rendered server-side; the rest are injected on filter click -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6 md:pr-1 md:pb-1">
      {% for p in projects.projects %}
        {% if p.isPinned %}
          <article
            class="project-card group relative flex flex-col border-[3px] border-black bg-[#fffdf9] shadow-brutal transition-transform motion-reduce:transition-none motion-reduce:hover:transform-none hover:-translate-y-0.5 hover:rotate-0 {{ 'rotate-[-0.6deg]' if loop.index is even else 'rotate-[0.6deg]' }}"
            data-filter-category="{{ p.filterCategory }}"
            data-category="{{ p.category }}"
            data-pinned="true"
            data-popularity="{{ (p.stars or 0) + (p.forks or 0) }}"
            data-order="{{ p.order or 99 }}"
          >
            <p class="flex items-center gap-2 px-6 pt-5 font-mono text-xs font-bold uppercase tracking-[0.12em] text-black/70">
              <span class="w-2.5 h-2.5 border-2 border-black {{ p.headerBgClass }}" aria-hidden="true"></span>{{ p.category }}
            </p>

            <div class="px-6 pt-2 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-3">
              <h3 class="font-display text-3xl sm:text-4xl text-black leading-tight">{{ p.title }}</h3>
              <div class="flex items-center gap-1.5 shrink-0">
                {% if p.stars > 0 %}
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 border-2 border-black bg-[#fde047] font-mono text-sm font-bold text-black" title="{{ p.stars }} stars on GitHub">{{ icons.star("w-3.5 h-3.5 text-black fill-black") }}{{ p.stars }}</span>
                {% endif %}
                {% if p.forks > 0 %}
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 border-2 border-black bg-[#f6eedb] font-mono text-sm font-bold text-black" title="{{ p.forks }} forks on GitHub">{{ icons.gitFork("w-3.5 h-3.5 text-black") }}{{ p.forks }}</span>
                {% endif %}
              </div>
            </div>

            {% if p.language or p.statsText %}
              <p class="px-6 pt-2 font-mono text-sm font-bold text-black/65">
                {% if p.language %}{{ p.language }}{% endif %}
                {% if p.language and p.statsText %} · {% endif %}
                {% if p.statsText %}{{ p.statsText }}{% endif %}
              </p>
            {% endif %}

            <p class="px-6 pt-4 pb-6 font-body text-base text-black/85 leading-relaxed flex-1">{{ p.description }}</p>

            <div class="mt-auto flex flex-wrap items-center gap-2 border-t-2 border-black px-6 py-4">
              <div class="flex flex-1 flex-wrap items-center gap-1.5 font-mono text-sm font-bold text-black/60">
                {% for tag in p.tags %}
                  <span>#{{ tag | lower }}</span>
                {% endfor %}
              </div>
              {% if p.githubUrl %}
                <a href="{{ p.githubUrl }}" target="_blank" rel="noopener noreferrer" class="btn-pill-sm bg-transparent hover:bg-[#86efac]">{{ icons.github("w-3.5 h-3.5 text-black") }} GitHub</a>
              {% endif %}
              {% if p.liveUrl %}
                <a href="{{ p.liveUrl }}" target="_blank" rel="noopener noreferrer" class="btn-pill-sm bg-[#fde047] hover:bg-[#fbbf24]">Visit {{ icons.arrowUpRight("w-3.5 h-3.5 text-black") }}</a>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Non-pinned projects: embedded as JSON, rendered client-side on filter click -->
    <script id="non-pinned-projects-data" type="application/json">
    [
      {% for p in projects.projects %}
        {% if not p.isPinned %}
          {
            "title": {{ p.title | dump | safe }},
            "filterCategory": {{ p.filterCategory | dump | safe }},
            "category": {{ p.category | dump | safe }},
            "popularity": {{ (p.stars or 0) + (p.forks or 0) }},
            "order": {{ p.order or 99 }},
            "stars": {{ p.stars or 0 }},
            "forks": {{ p.forks or 0 }},
            "language": {{ p.language | dump | safe }},
            "languageColor": {{ p.languageColor | dump | safe }},
            "statsText": {{ p.statsText | dump | safe }},
            "description": {{ p.description | dump | safe }},
            "tags": {{ p.tags | dump | safe }},
            "liveUrl": {{ p.liveUrl | dump | safe }},
            "githubUrl": {{ p.githubUrl | dump | safe }},
            "headerBgClass": {{ p.headerBgClass | dump | safe }}
          }{% if not loop.last %},{% endif %}
        {% endif %}
      {% endfor %}
    ]
    </script>

    <a href="https://github.com/Bittu5134?tab=repositories" target="_blank" rel="noopener noreferrer" class="relative mt-10 flex items-center justify-between gap-4 border-2 border-black bg-transparent px-4 py-2.5 font-mono text-sm font-bold text-black hover:bg-[#fde047] transition-colors">
      <span class="hidden sm:block absolute right-8 w-16 pointer-events-none z-10" style="bottom:100%" aria-hidden="true">
        <img src="/images/Armadillo_Running_Animation.gif" alt="" width="78" height="56" loading="lazy" class="w-full h-auto">
      </span>
      <span>More tools, prototypes and scripts on <span class="underline underline-offset-4">GitHub</span></span>
      {{ icons.arrowUpRight("w-3.5 h-3.5 text-black shrink-0") }}
    </a>
  </div>
</section>
