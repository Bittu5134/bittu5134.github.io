{% set tickerSkills = site.ticker or [
  "GO / GOLANG",
  "C / C++",
  "PYTHON",
  "PYTORCH",
  "WEBRTC P2P",
  "LINUX DAEMONS & SOCKETS",
  "DOCKER",
  "REDIS",
  "TYPESCRIPT",
  "REACT",
  "FASTAPI",
  "CLOUDFLARE WORKERS"
] %}

<div class="relative w-full my-6 z-20">
  <!-- pixel companion walking the skills band (outside the clip so it stays whole) -->
  <div class="ticker-companion absolute -top-5 left-0 w-6 h-6" aria-hidden="true">
    <svg class="w-6 h-6 text-black" style="image-rendering: pixelated"><use href="#icon-pixel-monster"/></svg>
  </div>
  <div class="w-full bg-[#fde047] border-y-2 border-black py-2.5 overflow-hidden select-none font-mono text-sm sm:text-sm font-bold shadow-brutal-bottom">
    <div class="flex w-max animate-ticker whitespace-nowrap">
    {% for i in range(0, 2) %}
      {% for skill in tickerSkills %}
        <div class="flex items-center mx-3 sm:mx-5 text-black tracking-wider">
          <span>{{ skill }}</span>
          <span class="ml-3 sm:ml-5 text-black/40">✦</span>
        </div>
      {% endfor %}
    {% endfor %}
    </div>
  </div>
</div>
