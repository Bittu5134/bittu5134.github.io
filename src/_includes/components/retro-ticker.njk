{% set tickerSkills = site.ticker or [
  "GO / GOLANG",
  "C / C++",
  "PYTHON",
  "PYTORCH",
  "WEBRTC P2P",
  "LINUX DAEMONS & SOCKETS",
  "DOCKER",
  "REDIS",
  "TYPESCRIPT",
  "REACT",
  "FASTAPI",
  "CLOUDFLARE WORKERS"
] %}

<div class="relative w-full my-6 z-20">
  <!-- chicken jockey rides the skills band (webp animates itself, stays fixed) -->
  <div class="absolute -top-9 left-2 sm:left-6 w-9 sm:w-11 pointer-events-none" aria-hidden="true">
    <img src="/images/chicken-jockey.webp" alt="" width="44" height="44" loading="lazy" class="w-full h-auto drop-shadow-[2px_2px_0_rgba(0,0,0,0.6)]"/>
  </div>
  <div class="w-full bg-[#fde047] border-y-2 border-black py-2.5 overflow-hidden select-none font-mono text-sm sm:text-sm font-bold shadow-brutal-bottom">
    <div class="flex w-max animate-ticker whitespace-nowrap">
    {% for i in range(0, 2) %}
      {% for skill in tickerSkills %}
        <div class="flex items-center mx-3 sm:mx-5 text-black tracking-wider">
          <span>{{ skill }}</span>
          <span class="ml-3 sm:ml-5 text-black/40">✦</span>
        </div>
      {% endfor %}
    {% endfor %}
    </div>
  </div>
</div>
