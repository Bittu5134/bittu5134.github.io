{% set tickerSkills = site.ticker or [
  "GO / GOLANG",
  "C / C++",
  "PYTHON",
  "PYTORCH",
  "WEBRTC P2P",
  "LINUX DAEMONS & SOCKETS",
  "DOCKER",
  "REDIS",
  "TYPESCRIPT",
  "REACT",
  "FASTAPI",
  "CLOUDFLARE WORKERS"
] %}

<div class="ticker-band relative w-full my-6 z-20">
  <!-- chicken jockey rides the skills band (webp animates itself, stays fixed) -->
  <div style="top:-6.7rem" class="hidden sm:block absolute left-2 sm:left-10 w-24 sm:w-32 pointer-events-none z-10" aria-hidden="true">
    <img src="/images/chicken-jockey.webp" alt="" width="44" height="44" loading="lazy" class="w-full h-auto"/>
  </div>
  <div class="w-full bg-[#fde047] border-y-2 border-black py-2.5 overflow-hidden select-none font-mono text-sm sm:text-sm font-bold shadow-brutal-bottom">
    <div class="flex w-max animate-ticker whitespace-nowrap">
    {% for i in range(0, 2) %}
      {% set loopHidden = ' aria-hidden="true"' if i === 1 else '' %}
      {% for skill in tickerSkills %}
        <div{{ loopHidden }} class="flex items-center mx-3 sm:mx-5 text-black tracking-wider">
          <span>{{ skill }}</span>
          <span class="ml-3 sm:ml-5 text-black/40">✦</span>
        </div>
      {% endfor %}
    {% endfor %}
    </div>
  </div>
</div>
