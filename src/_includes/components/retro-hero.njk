{% import "macros/icons.njk" as icons %}
<section
  id="hero" class="pt-4 sm:pt-8 pb-4 px-3 sm:px-6 scroll-mt-16 sm:scroll-mt-20">
  <!-- Retro Window Container -->
  <div
    class="max-w-5xl mx-auto bg-[#fffdf9] border-[3px] border-black shadow-brutal sm:shadow-brutal-lg rounded-none
      overflow-hidden">
    <!-- Retro Window Titlebar -->
    <div class="bg-[#fb923c] px-3 sm:px-4 py-2 border-b-[3px] border-black flex items-center justify-between gap-2 select-none">
      <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
        <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-[#f87171] border-2 border-black shrink-0"></span>
        <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-[#fde047] border-2 border-black shrink-0"></span>
        <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-[#86efac] border-2 border-black shrink-0"></span>
        <!-- <span class="ml-1 shrink-0 text-black">{{ icons.terminal("w-3.5 h-3.5") }}</span> -->
        <span class="font-mono text-sm font-bold text-black shrink-0">
          ~\whoami
        </span>
      </div>
      <span id="hero-clock" class="font-mono text-xs sm:text-sm font-bold text-black uppercase shrink-0">
        INDIA, IST
      </span>
    </div>
    <!-- Hero Content Body -->
    <div
      class="p-4 sm:p-10 md:p-12 grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center">
      <!-- Left Column: Avatar Polaroid & Badges (5 cols) -->
      <div
        class="lg:col-span-5 flex flex-col items-center justify-center">
        <!-- Polaroid Container -->
        <div class="relative bg-[#fffdf9] p-3 sm:p-4 pb-6 sm:pb-8 border-[3px] border-black shadow-brutal transition-transform
            duration-300 w-full max-w-[240px] sm:max-w-[280px]">
          <!-- Washi Tape Effect at top -->
          <!-- <div class="absolute -top-3 sm:-top-3.5 left-1/2 -translate-x-1/2 w-24 sm:w-28 h-5 sm:h-6 bg-[#fde047]/90 border
          border-black shadow-sm rotate-[2deg] sm:rotate-[3deg] z-10 flex items-center justify-center"> <span class="font-mono
          text-[10px] sm:text-xs text-black uppercase font-black tracking-widest">
              ★ IT'S ME ★
          </span> </div> -->
          <!-- Avatar Image -->
            <div class="border-2 border-black overflow-hidden bg-[#12151e]"> <picture>
              <source srcset="/images/avatar.avif" type="image/avif"/>
              <img
                src="/images/avatar.webp"
                alt="Bittu, pixel art Minecraft-style avatar"
                width="224"
                height="224"
                loading="eager"
                fetchpriority="high"
                class="w-full h-48 sm:h-56 object-cover hover:scale-105 transition-transform duration-300"/>
            </picture>
          </div>
          <div class="mt-2.5 sm:mt-3 text-center">
            <p class="font-mono text-base sm:text-lg text-black font-black tracking-wider">BITTU (HE/HIM)</p>
            <p class="font-mono text-xs text-gray-700 tracking-wide uppercase font-bold mt-0.5">
              Software &amp; Cyber-Sec
              {# pixels, packets & playlists #}
            </p>
          </div>
        </div>
        <!-- Sticker Badges beneath Polaroid -->
        <div class="flex flex-wrap gap-1.5 sm:gap-2 mt-4 sm:mt-6 justify-center max-w-xs">
          <a
            href="https://youtu.be/w6zLprHHZOk?t=495"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 bg-[#86efac] border-2 border-black font-mono text-xs font-bold shadow-brutal-xs flex items-center gap-1 hover:-translate-y-0.5 transition-transform text-black cursor-pointer"
          >
            {{ icons.pickaxe("w-3.5 h-3.5 text-black shrink-0") }}
            <span>MINECRAFT LIVE</span>
          </a>
          <a
            href="https://iitk.ac.in"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 bg-[#c4b5fd] border-2 border-black font-mono text-xs font-bold shadow-brutal-xs flex items-center gap-1 hover:-translate-y-0.5 transition-transform text-black cursor-pointer"
          >
            {{ icons.graduationCap("w-3.5 h-3.5 text-black shrink-0") }}
            <span>IIT KANPUR '30</span>
          </a>
          <span class="px-2.5 py-1 bg-[#38bdf8] border-2 border-black font-mono text-xs font-bold shadow-brutal-xs flex items-center gap-1">
            {{ icons.bug("w-3.5 h-3.5 text-black shrink-0") }}
            <span>BUG &amp; BLOCKS</span>
          </span>
        </div>
      </div>
      <!-- Right Column: Bio & CTA (7 cols) -->
      <div
        class="lg:col-span-7 flex flex-col justify-center">
        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.1] text-black mb-3 sm:mb-4">
          HEY, I'M
          <span class="bg-[#fde047] px-2 py-0.5 border-2 border-black shadow-brutal-xs inline-block">
            BITTU.
          </span>
        </h1>
        <!-- Sub-headline -->
        <p class="font-mono text-sm sm:text-base md:text-lg text-black font-semibold leading-relaxed mb-4 sm:mb-6">
          I write code, poke at <span class="bg-[#38bdf8]/30 px-1 border-b-2 border-black font-bold">security stuff</span>, and got featured on <a href="https://youtu.be/w6zLprHHZOk?t=495" target="_blank" rel="noopener noreferrer" class="bg-[#86efac]/50 px-1 border-b-2 border-black font-bold hover:bg-[#86efac] transition-colors text-black inline-block">Minecraft Live</a>. Mostly I'm just here making things I think are cool.
        </p>
        <!-- Sticky Note -->
        <div class="p-3.5 sm:p-4 bg-[#fef08a] border-2 border-black shadow-brutal-xs mb-6 sm:mb-8">
          <p class="font-mono text-xs sm:text-sm text-black leading-relaxed">
            Studying Programming &amp; Cybersecurity at <a href="https://iitk.ac.in" target="_blank" rel="noopener noreferrer" class="bg-[#c4b5fd]/40 px-1 border-b-2 border-black font-bold hover:bg-[#c4b5fd] transition-colors text-black inline-block">IIT Kanpur</a>, class of 2030.
          </p>
        </div>
        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-4">
          <a href="#projects" class="btn-hero-brutal bg-[#f59e0b]">
            <span>PROJECTS</span>
            {{ icons.arrowDown("w-4 h-4 text-black shrink-0") }}
          </a>
          <a href="#blog" class="btn-hero-brutal bg-[#86efac]">
            <span>BLOG</span>
            {{ icons.arrowRight("w-4 h-4 text-black shrink-0") }}
          </a>
          <a href="#contact" class="btn-hero-brutal bg-[#38bdf8]">
            <span>CONTACT</span>
            {{ icons.mail("w-4 h-4 text-black shrink-0") }}
          </a>
          {# <button
            id="copy-discord-hero"
            aria-label="Copy Discord handle bittu5134"
            class="btn-hero-brutal bg-[#fffdf9] hover:bg-[#c4b5fd]">
            <span class="discord-default flex items-center gap-2">
              {{ icons.discord("w-4 h-4 text-black shrink-0") }}
              <span>DISCORD: bittu5134</span>
            </span>
            <span class="discord-copied hidden flex items-center gap-2 text-green-700">
              {{ icons.check("w-4 h-4 text-green-700 shrink-0") }}
              <span>TAG COPIED!</span>
            </span>
          </button> #}
        </div>
      </div>
    </div>
  </div>

  <!-- Credibility & Key Achievement Highlight Strip -->
  <div class="max-w-5xl mx-auto mt-4 sm:mt-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      <!-- Metric 1: Monthly Active Users (Website/Projects) -->
      <a
        href="https://orv.pages.dev"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Web & Reader Projects - 900K+ Monthly Active Users"
        class="bg-[#fffdf9] border-[3px] border-black shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 transition-all p-3.5 sm:p-4 flex flex-col justify-between group cursor-pointer h-full"
      >
        <div class="flex items-center justify-between gap-2 mb-2">
          <span class="font-mono text-xs font-bold text-black/60 uppercase tracking-wider">ACTIVE USERS</span>
          <span class="p-1 bg-[#fde047] border border-black">{{ icons.bookOpen("w-3.5 h-3.5 text-black") }}</span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-mono font-black text-black tracking-tight group-hover:text-amber-600 transition-colors">900K+</div>
          <div class="font-mono text-xs font-bold text-black/75 mt-0.5 flex items-center justify-between">
            <span>Monthly Readers</span>
            {{ icons.arrowUpRight("w-3 h-3 text-black/40 group-hover:text-black") }}
          </div>
        </div>
      </a>

      <!-- Metric 2: Downloads & Views (PMC + Releases) -->
      <a
        href="https://www.planetminecraft.com/member/bittu5134/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Planet Minecraft and Releases - 2.3M+ Views and Downloads"
        class="bg-[#fffdf9] border-[3px] border-black shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 transition-all p-3.5 sm:p-4 flex flex-col justify-between group cursor-pointer h-full"
      >
        <div class="flex items-center justify-between gap-2 mb-2">
          <span class="font-mono text-xs font-bold text-black/60 uppercase tracking-wider">PMC &amp; RELEASES</span>
          <span class="p-1 bg-[#86efac] border border-black">{{ icons.pickaxe("w-3.5 h-3.5 text-black") }}</span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-mono font-black text-black tracking-tight group-hover:text-emerald-700 transition-colors">2.3M+</div>
          <div class="font-mono text-xs font-bold text-black/75 mt-0.5 flex items-center justify-between">
            <span>Views &amp; Downloads</span>
            {{ icons.arrowUpRight("w-3 h-3 text-black/40 group-hover:text-black") }}
          </div>
        </div>
      </a>

      <!-- Metric 3: Stars -->
      <a
        href="https://github.com/Bittu5134"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile - 400+ Stars across Open Source Repositories"
        class="bg-[#fffdf9] border-[3px] border-black shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 transition-all p-3.5 sm:p-4 flex flex-col justify-between group cursor-pointer h-full"
      >
        <div class="flex items-center justify-between gap-2 mb-2">
          <span class="font-mono text-xs font-bold text-black/60 uppercase tracking-wider">OPEN SOURCE</span>
          <span class="p-1 bg-[#f59e0b] border border-black">{{ icons.star("w-3.5 h-3.5 text-black") }}</span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-mono font-black text-black tracking-tight group-hover:text-[#d97706] transition-colors">400+</div>
          <div class="font-mono text-xs font-bold text-black/75 mt-0.5 flex items-center justify-between">
            <span>GitHub Stars</span>
            {{ icons.arrowUpRight("w-3 h-3 text-black/40 group-hover:text-black") }}
          </div>
        </div>
      </a>

      <!-- Metric 4: Spotlight -->
      <a
        href="https://youtu.be/w6zLprHHZOk?t=495"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Minecraft Live Official Feature Video"
        class="bg-[#fffdf9] border-[3px] border-black shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 transition-all p-3.5 sm:p-4 flex flex-col justify-between group cursor-pointer h-full"
      >
        <div class="flex items-center justify-between gap-2 mb-2">
          <span class="font-mono text-xs font-bold text-black/60 uppercase tracking-wider">SHOWCASED</span>
          <span class="p-1 bg-[#c4b5fd] border border-black">{{ icons.trophy("w-3.5 h-3.5 text-black") }}</span>
        </div>
        <div>
          <div class="text-base sm:text-lg font-mono font-black text-black leading-tight group-hover:text-purple-700 transition-colors">MINECRAFT LIVE</div>
          <div class="font-mono text-xs font-bold text-black/75 mt-0.5 flex items-center justify-between">
            <span>Official Feature</span>
            {{ icons.arrowUpRight("w-3 h-3 text-black/40 group-hover:text-black") }}
          </div>
        </div>
      </a>
    </div>
  </div>
</section>