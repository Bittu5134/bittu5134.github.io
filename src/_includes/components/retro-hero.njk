{% import "macros/icons.njk" as icons %}
<section id="hero" class="relative pt-8 sm:pt-12 pb-4 px-4 sm:px-6 scroll-mt-16 sm:scroll-mt-20 overflow-hidden">
  <canvas id="metaballs-canvas" class="hidden sm:block pointer-events-none absolute inset-0 h-full w-full opacity-90 hero-canvas-blur hero-canvas-mask" aria-hidden="true"></canvas>
  <div class="relative z-10 max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">

    <!-- Left: avatar + name (one visual anchor) -->
    <div class="md:col-span-5 flex flex-col items-center justify-center">
      <div class="w-full max-w-[260px] rotate-[-3deg]  border-[3px] border-black">
        <picture>
          <source srcset="/images/avatar.avif" type="image/avif"/>
          <img
            src="/images/avatar.webp"
            alt="Bittu, pixel art Minecraft-style avatar"
            width="224"
            height="224"
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto object-contain  border-2 border-black"/>
        </picture>
      </div>
      <!-- Small decorative tags: not buttons -->
      <div class="flex flex-wrap gap-2 mt-4 justify-center md:justify-start">
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-[#86efac]/60 font-mono text-sm font-bold text-black">
          {{ icons.pickaxe("w-3 h-3 text-black shrink-0") }} minecraft live
        </span>
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-[#c4b5fd]/60 font-mono text-sm font-bold text-black">
          {{ icons.graduationCap("w-3 h-3 text-black shrink-0") }} iitk '30
        </span>
      </div>
    </div>

    <!-- Right: headline, bio, badges, actions -->
    <div class="md:col-span-7 flex flex-col justify-center text-center md:text-left">
      <h1 class="font-display text-6xl sm:text-7xl leading-[0.95] text-black">
        Hey, I'm <span class="relative inline-block whitespace-nowrap">
          <span class="relative z-10">Bittu</span>
          <span class="absolute inset-x-[-0.1em] bottom-[0.08em] h-[0.42em] -z-0 bg-[#86efac] -rotate-1"></span>
        </span>.
      </h1>
      <p class="font-display text-2xl sm:text-3xl text-[#b45309] mt-3">Your friendly, neighborhood Technomancer.</p>

      <p class="font-body text-lg sm:text-xl text-black leading-relaxed mt-5 max-w-xl mx-auto md:mx-0">
        I write code, poke at security stuff, and got featured on <a href="https://youtu.be/w6zLprHHZOk?t=495" target="_blank" rel="noopener noreferrer" class="inline-block py-1.5 underline decoration-2 underline-offset-4 hover:text-[#d97706]">Minecraft Live</a>. Mostly I'm just making things I think are cool.
      </p>
      <p class="font-body text-base sm:text-lg text-black/80 mt-3 max-w-xl mx-auto md:mx-0">
        Studying Programming &amp; Cybersecurity at IIT Kanpur, class of 2030.
      </p>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mt-5">
        <a href="#projects" class="btn-pill bg-[#fde047]">Projects {{ icons.arrowDown("w-4 h-4 text-black shrink-0") }}</a>
        <a href="#blog" class="btn-pill bg-[#86efac]">Blog {{ icons.arrowRight("w-4 h-4 text-black shrink-0") }}</a>
        <a href="#contact" class="btn-pill bg-[#38bdf8]">Contact {{ icons.mail("w-4 h-4 text-black shrink-0") }}</a>
      </div>


    </div>
  </div>

  <!-- Key numbers -->
  <div class="relative z-10 max-w-5xl mx-auto mt-10 grid grid-cols-2 md:grid-cols-4  border-[3px] border-black bg-[#fffdf9] shadow-brutal-xs overflow-hidden">
    <a href="#" aria-label="Reach: 2.9M+ monthly views" class="px-5 py-4 md:border-r-2 border-black/15 hover:bg-[#fde047]/40 transition-colors">
      <p class="font-body text-sm font-bold uppercase tracking-wide text-black/75">Reach</p>
      <p class="font-display text-3xl sm:text-4xl text-black mt-1 whitespace-nowrap">2.9M+ <span class="block mt-1 font-body text-sm sm:text-base font-bold text-black/75">monthly views</span></p>
    </a>
    <a href="https://www.planetminecraft.com/member/bittu5134/" target="_blank" rel="noopener noreferrer" aria-label="Projects: 2.3M+ views and downloads" class="px-5 py-4 md:border-r-2 border-black/15 hover:bg-[#86efac]/40 transition-colors">
      <p class="font-body text-sm font-bold uppercase tracking-wide text-black/75">Projects</p>
      <p class="font-display text-3xl sm:text-4xl text-black mt-1 whitespace-nowrap">2.3M+ <span class="block mt-1 font-body text-sm sm:text-base font-bold text-black/75">views &amp; downloads</span></p>
    </a>
    <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" aria-label="Open source: 400+ GitHub stars" class="px-5 py-4 md:border-r-2 border-black/15 hover:bg-[#f59e0b]/30 transition-colors">
      <p class="font-body text-sm font-bold uppercase tracking-wide text-black/75">Open source</p>
      <p class="font-display text-3xl sm:text-4xl text-black mt-1 whitespace-nowrap">400+ <span class="block mt-1 font-body text-sm sm:text-base font-bold text-black/75">GitHub stars</span></p>
    </a>
    <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" aria-label="Activity: 4.8K+ GitHub contributions" class="px-5 py-4 hover:bg-[#c4b5fd]/40 transition-colors">
      <p class="font-body text-sm font-bold uppercase tracking-wide text-black/75">Activity</p>
      <p class="font-display text-3xl sm:text-4xl text-black mt-1 whitespace-nowrap">4.8K+ <span class="block mt-1 font-body text-sm sm:text-base font-bold text-black/75">contributions</span></p>
    </a>
  </div>
</section>
