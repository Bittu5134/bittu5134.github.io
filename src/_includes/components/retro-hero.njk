{% import "macros/icons.njk" as icons %}
<section id="hero" class="pt-8 sm:pt-12 pb-4 px-4 sm:px-6 scroll-mt-16 sm:scroll-mt-20">
  <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">

    <!-- Avatar + one-line identity -->
    <div class="md:col-span-5 flex flex-col items-center">
      <div class="relative w-full max-w-[260px] rotate-[-3deg] rounded-[2rem] border-[3px] border-black bg-[#fffdf9] p-3 shadow-brutal">
        <!-- washi tape -->
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 rotate-[4deg] w-28 h-7 bg-[#fde047]/90 border-2 border-black flex items-center justify-center z-10">
          <span class="font-mono text-[11px] font-bold text-black uppercase tracking-widest">it's me</span>
        </div>
        <picture>
          <source srcset="/images/avatar.avif" type="image/avif"/>
          <img
            src="/images/avatar.webp"
            alt="Bittu, pixel art Minecraft-style avatar"
            width="224"
            height="224"
            loading="eager"
            fetchpriority="high"
            class="w-full aspect-square object-cover rounded-[1.25rem] border-2 border-black"/>
        </picture>
      </div>
      <p class="mt-7 font-display text-3xl text-black">Bittu</p>
      <p class="font-mono text-xs font-bold uppercase tracking-wide text-black/70 mt-1">he/him · software &amp; cyber-sec</p>

      <div class="flex flex-wrap gap-2 mt-4 justify-center">
        <a href="https://youtu.be/w6zLprHHZOk?t=495" target="_blank" rel="noopener noreferrer"
          class="px-3 py-1 rounded-full bg-[#86efac] border-2 border-black font-mono text-xs font-bold text-black flex items-center gap-1.5 hover:-translate-y-0.5 transition-transform">
          {{ icons.pickaxe("w-3.5 h-3.5 text-black shrink-0") }}
          <span>Minecraft Live</span>
        </a>
        <a href="https://iitk.ac.in" target="_blank" rel="noopener noreferrer"
          class="px-3 py-1 rounded-full bg-[#c4b5fd] border-2 border-black font-mono text-xs font-bold text-black flex items-center gap-1.5 hover:-translate-y-0.5 transition-transform">
          {{ icons.graduationCap("w-3.5 h-3.5 text-black shrink-0") }}
          <span>IIT Kanpur '30</span>
        </a>
      </div>
    </div>

    <!-- Bio + actions -->
    <div class="md:col-span-7 text-center md:text-left">
      <p class="font-mono text-sm font-bold text-black/70 mb-3">~/whoami</p>
      <h1 class="font-display text-6xl sm:text-7xl leading-[0.95] text-black">
        Hey, I'm <span class="relative inline-block whitespace-nowrap">
          <span class="relative z-10">Bittu</span>
          <span class="absolute inset-x-[-0.1em] bottom-[0.08em] h-[0.42em] -z-0 bg-[#fde047] -rotate-1"></span>
        </span>.
      </h1>
      <p class="font-display text-2xl text-[#b45309] mt-3">Your friendly, neighborhood Technomancer.</p>
      <p class="font-body text-lg sm:text-xl text-black leading-relaxed mt-5 max-w-xl mx-auto md:mx-0">
        I write code, poke at <a href="https://youtu.be/w6zLprHHZOk?t=495" target="_blank" rel="noopener noreferrer" class="underline decoration-2 underline-offset-4 hover:text-[#d97706]">security stuff</a>, and got featured on Minecraft Live. Mostly I'm just making things I think are cool.
      </p>
      <p class="font-body text-base text-black/75 mt-3 max-w-xl mx-auto md:mx-0">
        Studying Programming &amp; Cybersecurity at IIT Kanpur, class of 2030.
      </p>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mt-7">
        <a href="#projects" class="btn-pill bg-[#fde047]">Projects {{ icons.arrowDown("w-4 h-4 text-black shrink-0") }}</a>
        <a href="#blog" class="btn-pill bg-[#86efac]">Blog {{ icons.arrowRight("w-4 h-4 text-black shrink-0") }}</a>
        <a href="#contact" class="btn-pill bg-[#38bdf8]">Contact {{ icons.mail("w-4 h-4 text-black shrink-0") }}</a>
      </div>
    </div>
  </div>

  <!-- Key numbers: one box, four readings, no nested cards -->
  <div class="max-w-5xl mx-auto mt-10 grid grid-cols-2 md:grid-cols-4 rounded-3xl border-[3px] border-black bg-[#fffdf9] shadow-brutal-xs overflow-hidden">
    <a href="#" aria-label="Reach: 2.9M+ monthly views" class="px-5 py-4 md:border-r-2 border-black/15 hover:bg-[#fde047]/40 transition-colors">
      <p class="font-mono text-xs font-bold uppercase tracking-wide text-black/70">Reach</p>
      <p class="font-display text-3xl text-black mt-1">2.9M+ <span class="font-mono text-xs font-bold text-black/70">monthly views</span></p>
    </a>
    <a href="https://www.planetminecraft.com/member/bittu5134/" target="_blank" rel="noopener noreferrer" aria-label="Projects: 2.3M+ views and downloads" class="px-5 py-4 md:border-r-2 border-black/15 hover:bg-[#86efac]/40 transition-colors">
      <p class="font-mono text-xs font-bold uppercase tracking-wide text-black/70">Projects</p>
      <p class="font-display text-3xl text-black mt-1">2.3M+ <span class="font-mono text-xs font-bold text-black/70">views &amp; downloads</span></p>
    </a>
    <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" aria-label="Open source: 400+ GitHub stars" class="px-5 py-4 md:border-r-2 border-black/15 hover:bg-[#f59e0b]/30 transition-colors">
      <p class="font-mono text-xs font-bold uppercase tracking-wide text-black/70">Open source</p>
      <p class="font-display text-3xl text-black mt-1">400+ <span class="font-mono text-xs font-bold text-black/70">GitHub stars</span></p>
    </a>
    <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" aria-label="Activity: 4.8K+ GitHub contributions" class="px-5 py-4 hover:bg-[#c4b5fd]/40 transition-colors">
      <p class="font-mono text-xs font-bold uppercase tracking-wide text-black/70">Activity</p>
      <p class="font-display text-3xl text-black mt-1">4.8K+ <span class="font-mono text-xs font-bold text-black/70">contributions</span></p>
    </a>
  </div>
</section>
