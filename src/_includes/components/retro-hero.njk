{% import "macros/icons.njk" as icons %}
<section id="hero" class="relative pt-8 sm:pt-12 pb-8 sm:pb-10 px-4 sm:px-6 scroll-mt-20 overflow-hidden">
  <canvas id="metaballs-canvas" class="hidden sm:block pointer-events-none absolute inset-0 h-full w-full opacity-90 hero-canvas-blur hero-canvas-mask" aria-hidden="true"></canvas>
  <div class="relative z-10 max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">

    <!-- Left: avatar + name (one visual anchor) -->
    <div class="md:col-span-5 flex flex-col items-center justify-center">
      <div class="w-full max-w-[260px] rotate-[-3deg]  border-[3px] border-black">
        <picture>
          <source srcset="/images/avatar.avif" type="image/avif"/>
          <img
            src="/images/avatar.webp"
            alt="Bittu, pixel art Minecraft-style avatar"
            width="224"
            height="224"
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto object-contain"/>
        </picture>
      </div>
      <!-- Small decorative tags: not buttons -->
      <div class="flex flex-wrap gap-2 mt-4 justify-center md:justify-start">
        <a href="https://youtu.be/w6zLprHHZOk?t=495" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 py-1 border-2 border-black bg-[#86efac]/60 font-mono text-sm font-bold text-black hover:bg-[#86efac] transition-colors">
          {{ icons.minecraftLive("w-3 h-3 text-black shrink-0") }} minecraft live
        </a>
        <a href="https://www.iitk.ac.in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 py-1 border-2 border-black bg-[#c4b5fd]/60 font-mono text-sm font-bold text-black hover:bg-[#c4b5fd] transition-colors">
          {{ icons.gradSpark("w-3 h-3 text-black shrink-0") }} iitk '30
        </a>
      </div>
    </div>

    <!-- Right: headline, bio, badges, actions -->
    <div class="md:col-span-7 flex flex-col justify-center text-center md:text-left">
      <h1 class="font-display text-6xl sm:text-7xl leading-[0.95] text-black">
        Hey, I'm <span class="relative inline-block whitespace-nowrap">
          <span class="relative z-10">Bittu</span>
          <span class="absolute inset-x-[-0.1em] bottom-[0.08em] h-[0.42em] -z-0 bg-[#86efac] -rotate-1"></span>
        </span>.
      </h1>
      <p class="font-display text-2xl sm:text-3xl text-[#b45309] mt-3">Your friendly, neighborhood Technomancer.</p>

      <div class="space-y-4 mt-5">
        <p class="font-body text-base sm:text-lg text-black leading-relaxed max-w-xl mx-auto md:mx-0">
          I write code, poke at security stuff, and got featured on <a href="https://youtu.be/w6zLprHHZOk?t=495" target="_blank" rel="noopener noreferrer" class="inline-block py-1.5 underline decoration-2 underline-offset-4 hover:text-[#b45309]">Minecraft Live</a>. Mostly I'm just making things I think are cool.
        </p>
        <p class="font-body text-base text-black/80 leading-relaxed max-w-xl mx-auto md:mx-0">
          Studying Programming &amp; Cybersecurity at IIT Kanpur, class of 2030.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mt-6">
        <a href="#projects" class="btn-pill bg-[#fde047]">Projects {{ icons.arrowDown("w-3.5 h-3.5 text-black shrink-0") }}</a>
        <a href="#blog" class="btn-pill bg-[#86efac]">Blog {{ icons.arrowRight("w-3.5 h-3.5 text-black shrink-0") }}</a>
        <a href="#contact" class="btn-pill bg-[#38bdf8]">Contact {{ icons.mail("w-3.5 h-3.5 text-black shrink-0") }}</a>
      </div>


    </div>
  </div>

  <!-- Key numbers — dashed spec sheet, sticker swatches -->
  <div class="relative z-10 max-w-5xl mx-auto mt-10 border-[3px] border-dashed border-black">
      {# goat celebrates on the stat strip #}
      <div style="top:-3.9rem" class="hidden sm:block absolute right-8 w-16 pointer-events-none z-10" aria-hidden="true">
        <img src="/images/Goat_celebrate.gif" alt="" width="122" height="94" loading="lazy" class="w-full h-auto"/>
      </div>
  <div class="grid grid-cols-2 md:grid-cols-4">
    <div aria-label="None" class="relative px-5 py-5 transition-colors">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-black/75 flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 border-2 border-black bg-[#38bdf8]" aria-hidden="true"></span>Reach</p>
      <p class="font-display text-4xl text-black leading-none mt-2 whitespace-nowrap">2.9M+ <span class="block mt-2 font-mono text-xs font-bold uppercase tracking-[0.08em] text-black/80">monthly views</span></p>
    </div>
    <a href="https://www.planetminecraft.com/member/bittu5134/" target="_blank" rel="noopener noreferrer" aria-label="Projects: 2.3M+ views and downloads" class="relative px-5 py-5 transition-colors hover:bg-[#86efac]">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-black/75 flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 border-2 border-black bg-[#86efac]" aria-hidden="true"></span>Projects</p>
      <p class="font-display text-4xl text-black leading-none mt-2 whitespace-nowrap">2.3M+ <span class="block mt-2 font-mono text-xs font-bold uppercase tracking-[0.08em] text-black/80">views &amp; downloads</span></p>
    </a>
    <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" aria-label="Open source: 400+ GitHub stars" class="relative px-5 py-5 transition-colors hover:bg-[#fde047]">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-black/75 flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 border-2 border-black bg-[#fde047]" aria-hidden="true"></span>Open source</p>
      <p class="font-display text-4xl text-black leading-none mt-2 whitespace-nowrap">400+ <span class="block mt-2 font-mono text-xs font-bold uppercase tracking-[0.08em] text-black/80">GitHub stars</span></p>
    </a>
    <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" aria-label="Activity: 4.8K+ GitHub contributions" class="relative px-5 py-5 transition-colors hover:bg-[#c4b5fd]">
      <p class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-black/75 flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 border-2 border-black bg-[#c4b5fd]" aria-hidden="true"></span>Activity</p>
      <p class="font-display text-4xl text-black leading-none mt-2 whitespace-nowrap">4.8K+ <span class="block mt-2 font-mono text-xs font-bold uppercase tracking-[0.08em] text-black/80">contributions</span></p>
    </a>
  </div>
  </div>
</section>
