{% import "macros/icons.njk" as icons %}

<section id="about" class="py-6 sm:py-8 px-3 sm:px-6 scroll-mt-16 sm:scroll-mt-20">
  <div class="max-w-5xl mx-auto space-y-6">
    <!-- Section Header -->
    <div class="mb-6 sm:mb-8">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-mono font-black text-black tracking-tight">
        ~/about
      </h2>
    </div>

    <!-- Row 1: Bio + Glance -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-8">

      <!-- Main Story Box (7 cols) -->
      <div class="lg:col-span-7 p-5 sm:p-8 card-brutal flex flex-col justify-between">
        <div class="space-y-4 font-mono text-sm sm:text-base text-black/85 leading-relaxed">
          <p>
            I'm <strong>Bittu</strong> — a 19-year-old software engineer and cybersecurity student at
            <a href="https://iitk.ac.in" target="_blank" rel="noopener noreferrer"
              class="bg-[#38bdf8]/30 px-1 border-b-2 border-black font-bold hover:bg-[#38bdf8]/60 transition-colors">
              IIT Kanpur '30
            </a>, with a deep interest in open-source, low-level systems, and digital security. Alongside freelance software engineering, I build things for fun, and every so often they turn out to be genuinely useful.
          </p>
          <p>
            Outside of systems code, I've spent years deep in the
            <a href="https://www.planetminecraft.com/member/bittu5134/" target="_blank" rel="noopener noreferrer"
              class="bg-[#86efac]/40 px-1 border-b-2 border-black font-bold hover:bg-[#86efac]/80 transition-colors">
              Minecraft Technical &amp; Modding
            </a>
            community. One of my datapack creations was spotlighted on
            <a href="https://youtu.be/w6zLprHHZOk?t=495" target="_blank" rel="noopener noreferrer"
              class="font-bold underline hover:text-[#fb923c] transition-colors text-black">Minecraft Live</a>,
            which cemented my love for game loops and network protocols. I'm also active in the webnovel and MTL community,
            where I build reader platforms and translation tooling to make stories more accessible across languages.
          </p>
          <p>
            When I'm not writing code, I'm usually watching anime, playing games or participating in game jams, hackathons, and CTFs.
          </p>
        </div>

        <!-- Signature Strip -->
        <div class="mt-6 pt-4 border-t-2 border-black/10 flex items-center justify-between flex-wrap gap-2">
          <span class="font-mono text-sm sm:text-base font-bold text-black tracking-wide">— BITTU (@BITTU5134)</span>
        </div>
      </div>

      <!-- Right Column: AT A GLANCE + shader (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-4 sm:gap-6">

        <!-- AT A GLANCE card -->
        <div class="p-5 sm:p-6 bg-[#fde047] border-[3px] border-black shadow-brutal">
          <ul class="space-y-3 font-mono text-xs sm:text-sm font-bold text-black">
            <li class="flex items-start gap-2.5">
              {{ icons.trophy("w-4 h-4 text-black shrink-0 mt-0.5") }}
              <span>Active in game jams, hackathons &amp; CTFs</span>
            </li>
            <li class="flex items-start gap-2.5">
              {{ icons.bookOpen("w-4 h-4 text-black shrink-0 mt-0.5") }}
              <span>Webnovel &amp; MTL tooling creator</span>
            </li>
            <li class="flex items-start gap-2.5">
              {{ icons.code("w-4 h-4 text-black shrink-0 mt-0.5") }}
              <span>Freelance software engineer</span>
            </li>
            <li class="flex items-start gap-2.5">
              {{ icons.zap("w-4 h-4 text-black shrink-0 mt-0.5") }}
              <span>Enjoys optimising small &amp; fast builds</span>
            </li>
          </ul>
        </div>

        <!-- Shader Card (desktop only) -->
        <div class="hidden lg:flex flex-col flex-1 card-brutal overflow-hidden min-h-[150px] bg-black">
          <div class="relative flex-1 w-full bg-black min-h-[120px]">
            <canvas id="metaballs-canvas" class="w-full h-full block absolute inset-0"></canvas>
          </div>
        </div>

      </div>
    </div>

    <!-- Row 2: Core Technologies & Tooling -->
    <div class="p-4 sm:p-6 card-brutal">
      <div class="flex flex-wrap gap-2.5 sm:gap-3">
        {% for tech in techStack %}
          <span class="tech-badge {{ tech.bgClass }}">
            {% if tech.iconId %}
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-black shrink-0" fill="currentColor" aria-hidden="true">
                <use href="#{{ tech.iconId }}"/>
              </svg>
            {% endif %}
            <span>{{ tech.name }}</span>
          </span>
        {% endfor %}
      </div>
    </div>
  </div>
</section>