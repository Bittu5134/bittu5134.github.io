{% import "macros/icons.njk" as icons %}
{% from "macros/post-row.njk" import postRow %}

<section id="blog" class="relative py-14 sm:py-20 px-4 sm:px-6 scroll-mt-20">
  <!-- Nether portal + lava scene on the right edge (decorative).
       Static blocks are baked into portal.png; animated cells are transparent
       and covered by one small WebP per animated block. -->
  {% set netherPortalAnim = { cells: [] } %}
  {% for g in blockAnim %}{% if g.design == "portal" %}{% set netherPortalAnim = g %}{% endif %}{% endfor %}
  {% set sceneCols = netherPortalAnim.sceneCols or 7 %}
  {% set sceneRows = netherPortalAnim.sceneRows or 41 %}
  {% set sceneCell = 287 / sceneCols %}
  <div class="hidden xl:block absolute right-0 top-[35%] -mt-8 w-[287px] pointer-events-none select-none -z-10" aria-hidden="true">
    <img src="/assets/images/scenes/portal.png?v={{ buildStamp }}" alt="" width="{{ sceneCols * 16 }}" height="{{ sceneRows * 16 }}" loading="lazy" decoding="async" class="w-full h-auto" style="image-rendering:pixelated"/>
    {% for cell in netherPortalAnim.cells %}
    <div class="anim-cell absolute" style="left:{{ cell.c * sceneCell }}px;top:{{ cell.r * sceneCell }}px;width:{{ sceneCell }}px;height:{{ sceneCell }}px;background-image:url('/assets/images/scenes/{{ cell.sheet }}?v={{ buildStamp }}');background-size:100% 100%;image-rendering:pixelated"></div>
    {% endfor %}
  </div>
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 mb-10">
      <div>
    <h2 class="heading-pop font-display text-5xl sm:text-6xl text-black leading-none">Blog</h2>
      </div>
      <div class="flex items-center gap-3">
        <a href="/blog/" class="btn-pill-sm bg-[#fde047]">
          All articles ({{ collections.blogs.length }}) {{ icons.arrowRight("w-3.5 h-3.5 text-black") }}
        </a>
        <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="btn-pill-sm bg-[#fb923c] hover:bg-[#f97316]" title="Subscribe to RSS">{{ icons.rss("w-4 h-4 text-black") }} RSS</a>
      </div>
    </div>

    <div class="divide-y divide-black/15 border-y border-black/15">
      {% for post in collections.blogs.slice(0, 3) %}
        {{ postRow(post, loop.index0, 3, false) }}
      {% endfor %}
    </div>
  </div>
</section>
