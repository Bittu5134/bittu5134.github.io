{% import "macros/icons.njk" as icons %}

<section id="blog" class="relative py-14 sm:py-20 px-4 sm:px-6 scroll-mt-20">
  <!-- Nether portal + lava scene on the right edge (decorative).
       Animated cells are cutouts in portal.png; overlays animate them from
       the flipbook sheets listed in portal-anim.json (7 cols x 27 rows). -->
  {% set netherPortalAnim = { cells: [] } %}
  {% for g in blockAnim %}{% if g.design == "portal" %}{% set netherPortalAnim = g %}{% endif %}{% endfor %}
  <div class="hidden xl:block absolute right-0 top-1/2 -translate-y-1/2 w-[288px] pointer-events-none select-none -z-10" aria-hidden="true">
    <img src="/assets/images/scenes/portal.png" alt="" width="112" height="432" class="w-full h-auto" style="image-rendering:pixelated"/>
    {% for cell in netherPortalAnim.cells %}
    <div class="block-anim absolute" style="left:{{ cell.c * 100 / 7 }}%;top:{{ cell.r * 100 / 27 }}%;width:{{ 100 / 7 }}%;height:{{ 100 / 27 }}%;background-image:url('/assets/images/scenes/{{ cell.sheet }}');background-size:100% calc(var(--f) * 100%);--f:{{ cell.frames }};image-rendering:pixelated" data-frames="{{ cell.frames }}"></div>
    {% endfor %}
  </div>
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 mb-10">
      <div>
    <h2 class="heading-pop font-display text-5xl sm:text-6xl text-black leading-none">Blog</h2>
      </div>
      <div class="flex items-center gap-3">
        <a href="/blog/" class="btn-pill-sm bg-[#fde047]">
          All articles ({{ collections.blogs.length }}) {{ icons.arrowRight("w-3.5 h-3.5 text-black") }}
        </a>
        <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="btn-pill-sm bg-[#fb923c] hover:bg-[#f97316]" title="Subscribe to RSS">{{ icons.rss("w-4 h-4 text-black") }} RSS</a>
      </div>
    </div>

    <div class="divide-y divide-black/15 border-y-2 border-black">
      {% set chipColors = ['bg-[#86efac]', 'bg-[#c4b5fd]', 'bg-[#38bdf8]'] %}
      {% for post in collections.blogs.slice(0, 3) %}
        {% set chip = chipColors[loop.index0 % 3] %}
        <article class="group relative grid gap-3 py-8 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-8">
          <div class="min-w-0">
            <p class="font-mono text-sm font-bold flex flex-wrap items-center gap-3">
              <span class="inline-block px-2.5 py-1 border-2 border-black {{ chip }} text-black">{{ post.data.date | dateShort }}</span>
              <span class="text-black/65">{{ post.data.readTime or '5 min read' }}</span>
            </p>
            <h3 class="font-display text-3xl sm:text-4xl text-black leading-tight mt-4">
              <a href="{{ post.url }}" class="group-hover:text-[#b45309] transition-colors after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black">{{ post.data.title }}</a>
            </h3>
            <p class="font-body text-base sm:text-lg text-black/80 leading-relaxed mt-3">{{ post.data.summary }}</p>
            {% set validTags = [] %}
            {% for tag in post.data.tags %}
              {% if tag != "posts" %}{% set validTags = (validTags.push(tag), validTags) %}{% endif %}
            {% endfor %}
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-4 font-mono text-sm font-bold text-black/60">
              {% for tag in validTags.slice(0, 4) %}<span>#{{ tag | lower }}</span>{% endfor %}
            </div>
          </div>
          <span aria-hidden="true" class="inline-flex items-center gap-1.5 self-start px-4 py-2 border-2 border-black font-mono text-sm font-bold text-black bg-[#fffdf9] group-hover:bg-[#fde047] transition-colors whitespace-nowrap">
            Read article {{ icons.arrowUpRight("w-3.5 h-3.5") }}
          </span>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
