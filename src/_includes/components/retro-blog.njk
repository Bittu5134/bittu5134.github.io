{% import "macros/icons.njk" as icons %}

<section id="blog" class="py-14 sm:py-20 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 mb-10">
      <div>
    <h2 class="heading-pop font-display text-5xl sm:text-6xl text-black leading-none">Blog</h2>
      </div>
      <div class="flex items-center gap-3">
        <a href="/blog/" class="inline-flex items-center gap-1.5 px-4 py-2.5 border-2 border-black font-mono text-sm font-bold text-black bg-[#fde047] transition-colors">
          All articles ({{ collections.blogs.length }}) {{ icons.arrowRight("w-4 h-4 text-black") }}
        </a>
        <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="btn-pill shadow-none hover:shadow-none active:shadow-none !translate-y-0 bg-[#fdba74] hover:bg-[#fb923c]" title="Subscribe to RSS">{{ icons.rss("w-4 h-4 text-black") }} RSS</a>
      </div>
    </div>

    <div class="divide-y divide-black">
      {% set chipColors = ['bg-[#86efac]', 'bg-[#c4b5fd]', 'bg-[#38bdf8]'] %}
      {% for post in collections.blogs.slice(0, 3) %}
        {% set chip = chipColors[loop.index0 % 3] %}
        <article class="group relative grid gap-3 py-6 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-8 sm:py-8">
          <div class="min-w-0">
            <p class="font-mono text-sm font-bold flex flex-wrap items-center gap-3">
              <span class="inline-block px-2.5 py-1 border-2 border-dashed border-black {{ chip }} text-black">{{ post.data.date | dateShort }}</span>
              <span class="text-black/65">{{ post.data.readTime or '5 min read' }}</span>
            </p>
            <h3 class="font-display text-3xl sm:text-4xl text-black leading-tight mt-3">
              <a href="{{ post.url }}" class="group-hover:text-[#b45309] transition-colors after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black">{{ post.data.title }}</a>
            </h3>
            <p class="font-body text-base sm:text-lg text-black/80 leading-relaxed mt-2">{{ post.data.summary }}</p>
            {% set validTags = [] %}
            {% for tag in post.data.tags %}
              {% if tag != "posts" %}{% set validTags = (validTags.push(tag), validTags) %}{% endif %}
            {% endfor %}
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3 font-mono text-sm font-bold text-black/60">
              {% for tag in validTags.slice(0, 4) %}<span>#{{ tag | lower }}</span>{% endfor %}
            </div>
          </div>
          <span aria-hidden="true" class="inline-flex items-center gap-1.5 self-start px-3.5 py-2.5 border-2 border-black font-mono text-sm font-bold text-black bg-[#fffdf9] group-hover:bg-[#fde047] transition-colors whitespace-nowrap">
            Read article {{ icons.arrowUpRight("w-3.5 h-3.5") }}
          </span>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
