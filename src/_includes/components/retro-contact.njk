{% import "macros/icons.njk" as icons %}

<section id="contact" class="py-14 sm:py-20 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-4xl mx-auto">
    <h2 class="heading-pop font-display text-5xl sm:text-6xl text-black leading-none mb-8">Contact</h2>

    <div class="relative flex flex-col gap-3">
      <!-- drops avatar perched on the email card (like the jockey on the ticker) -->
      <div style="top:-7.4rem" class="hidden sm:block absolute right-6 sm:right-14 w-20 sm:w-24 pointer-events-none z-10" aria-hidden="true">
        <img src="/images/contact-avatar.gif" alt="" width="368" height="368" loading="lazy" class="w-full h-auto"/>
      </div>
      <div class="group relative flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 bg-[#fde047] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
        <a href="mailto:hello@bittu.dev" class="flex items-center gap-3">
          {{ icons.mail("w-5 h-5 text-black shrink-0") }}
          <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-black/70">Email</span>
          <span class="font-mono text-base font-bold text-black">hello@bittu.dev</span></span>
        </a>
        <span class="flex items-center gap-2">
          <a href="mailto:hello@bittu.dev" class="inline-flex items-center gap-1.5 whitespace-nowrap bg-transparent border-2 border-black px-3.5 py-2.5 font-body text-sm font-bold text-black hover:bg-[#fffdf9]">Mail {{ icons.arrowUpRight("w-3.5 h-3.5") }}</a>
          <button id="copy-email-contact" type="button" class="inline-flex items-center gap-1.5 whitespace-nowrap bg-transparent border-2 border-black px-3.5 py-2.5 font-body text-sm font-bold text-black hover:bg-[#fffdf9]">
            <span class="email-default inline-flex whitespace-nowrap items-center gap-1.5">{{ icons.copy("w-3.5 h-3.5") }} Copy</span>
            <span class="email-copied hidden inline-flex whitespace-nowrap items-center gap-1.5">{{ icons.check("w-3.5 h-3.5") }} Copied</span>
          </button>
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 bg-[#24292f] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
          <span class="flex items-center gap-3">{{ icons.github("w-5 h-5 text-white shrink-0") }}
            <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-white/80">GitHub</span><span class="font-mono text-base font-bold text-white">@Bittu5134</span></span></span>
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap bg-[#fffdf9] border-2 border-black px-3 py-1.5 font-body text-sm font-bold">Visit {{ icons.arrowUpRight("w-3.5 h-3.5") }}</span>
        </a>
        <a href="https://www.linkedin.com/in/bittu5134" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 bg-[#0A66C2] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
          <span class="flex items-center gap-3">{{ icons.linkedin("w-5 h-5 text-white shrink-0") }}
            <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-white/80">LinkedIn</span><span class="font-mono text-base font-bold text-white">in/bittu5134</span></span></span>
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap bg-[#fffdf9] border-2 border-black px-3 py-1.5 font-body text-sm font-bold">Visit {{ icons.arrowUpRight("w-3.5 h-3.5") }}</span>
        </a>
        <a href="/discord/" rel="noopener noreferrer" class="flex items-center justify-between gap-4 bg-[#5865F2] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
          <span class="flex items-center gap-3">{{ icons.discord("w-5 h-5 text-white shrink-0") }}
            <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-white/80">Discord</span><span class="font-mono text-base font-bold text-white">bittu5134</span></span></span>
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap bg-[#fffdf9] border-2 border-black px-3 py-1.5 font-body text-sm font-bold">Join {{ icons.arrowUpRight("w-3.5 h-3.5") }}</span>
        </a>
        <a href="https://www.patreon.com/lazybittu" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 bg-[#E11D48] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
          <span class="flex items-center gap-3">{{ icons.patreon("w-5 h-5 text-white shrink-0") }}
            <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-white/90">Patreon</span><span class="font-mono text-base font-bold text-white">@lazybittu</span></span></span>
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap bg-[#fffdf9] border-2 border-black px-3 py-1.5 font-body text-sm font-bold">Support {{ icons.arrowUpRight("w-3.5 h-3.5") }}</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <a href="https://www.reddit.com/user/RealNPC_/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-2 bg-[#fffdf9] border-2 border-black px-4 py-3.5 font-mono text-sm font-bold text-black hover:bg-[#fde047] transition-colors">{{ icons.reddit("w-5 h-5 text-black shrink-0") }} <span class="font-body text-base font-bold">u/RealNPC_</span> {{ icons.arrowUpRight("w-4 h-4 text-black shrink-0") }}</a>
        <a href="https://x.com/LostSquidXD" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-2 bg-[#fffdf9] border-2 border-black px-4 py-3.5 font-mono text-sm font-bold text-black hover:bg-[#fde047] transition-colors">{{ icons.twitter("w-5 h-5 text-black shrink-0") }} <span class="font-body text-base font-bold">@LostSquidXD</span> {{ icons.arrowUpRight("w-4 h-4 text-black shrink-0") }}</a>
        <a href="https://www.planetminecraft.com/member/bittu5134/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-2 bg-[#fffdf9] border-2 border-black px-4 py-3.5 font-mono text-sm font-bold text-black hover:bg-[#fde047] transition-colors"><svg class="w-5 h-5 shrink-0 text-black" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 12 12" aria-hidden="true"><path d="M0 0h12v12H0z" fill="none"/><path fill="currentColor" d="M2 11h1v-1h5v1h1v-1h1V9h1V4h-1V3H9V2H8v1H7v2H6v1H5v1H4V6H3V5H2v3H1V4H0v5h1v1h1Zm1 1h5v-1H3ZM1 4h1V3H1Zm5 5V8h1V7h1v1h1v1ZM2 3h1V2H2Zm7 4V6h1v1ZM3 2h5V1H3Zm0 0"/></svg> <span class="font-body text-base font-bold">Planet Minecraft</span> {{ icons.arrowUpRight("w-4 h-4 text-black shrink-0") }}</a>
      </div>
    </div>
  </div>
</section>
