{% import "macros/icons.njk" as icons %}

<section id="contact" class="py-14 sm:py-20 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-4xl mx-auto">
    <h2 class="heading-pop font-display text-5xl sm:text-6xl text-black leading-none mb-8">Contact</h2>

    <div class="flex flex-col gap-3">
      <div class="group flex items-center justify-between gap-4 bg-[#fde047] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
        <a href="mailto:hello@bittu.dev" class="flex items-center gap-3">
          {{ icons.mail("w-5 h-5 text-black shrink-0") }}
          <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-black/70">Email</span>
          <span class="font-mono text-base font-bold text-black">hello@bittu.dev</span></span>
        </a>
        <span class="flex items-center gap-2">
          <a href="mailto:hello@bittu.dev" class="inline-flex items-center gap-1.5 whitespace-nowrap bg-transparent border-2 border-black px-3.5 py-2.5 font-body text-sm font-bold text-black hover:bg-[#fffdf9]">Mail {{ icons.arrowUpRight("w-3.5 h-3.5") }}</a>
          <button id="copy-email-contact" type="button" class="inline-flex items-center gap-1.5 whitespace-nowrap bg-transparent border-2 border-black px-3.5 py-2.5 font-body text-sm font-bold text-black hover:bg-[#fffdf9]">
            <span class="email-default inline-flex whitespace-nowrap items-center gap-1.5">{{ icons.copy("w-3.5 h-3.5") }} Copy</span>
            <span class="email-copied hidden inline-flex whitespace-nowrap items-center gap-1.5">{{ icons.check("w-3.5 h-3.5") }} Copied</span>
          </button>
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 bg-[#c4b5fd] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
          <span class="flex items-center gap-3">{{ icons.github("w-5 h-5 text-black shrink-0") }}
            <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-black/70">GitHub</span><span class="font-mono text-base font-bold text-black">@Bittu5134</span></span></span>
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap bg-[#fffdf9] border-2 border-black px-3 py-1.5 font-body text-sm font-bold">Visit {{ icons.arrowUpRight("w-3.5 h-3.5") }}</span>
        </a>
        <a href="https://www.linkedin.com/in/bittu5134" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 bg-[#38bdf8] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
          <span class="flex items-center gap-3">{{ icons.linkedin("w-5 h-5 text-black shrink-0") }}
            <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-black/70">LinkedIn</span><span class="font-mono text-base font-bold text-black">in/bittu5134</span></span></span>
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap bg-[#fffdf9] border-2 border-black px-3 py-1.5 font-body text-sm font-bold">Visit {{ icons.arrowUpRight("w-3.5 h-3.5") }}</span>
        </a>
        <a href="/discord" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 bg-[#86efac] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
          <span class="flex items-center gap-3">{{ icons.discord("w-5 h-5 text-black shrink-0") }}
            <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-black/70">Discord</span><span class="font-mono text-base font-bold text-black">bittu5134</span></span></span>
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap bg-[#fffdf9] border-2 border-black px-3 py-1.5 font-body text-sm font-bold">Join {{ icons.arrowUpRight("w-3.5 h-3.5") }}</span>
        </a>
        <a href="https://patreon.com/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 bg-[#fb7185] border-2 border-black shadow-brutal-xs px-4 py-3.5 hover:-translate-y-0.5 transition-transform">
          <span class="flex items-center gap-3">{{ icons.patreon("w-5 h-5 text-black shrink-0") }}
            <span><span class="block font-body text-sm font-bold uppercase tracking-wide text-black/70">Patreon</span><span class="font-mono text-base font-bold text-black">@lazybittu</span></span></span>
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap bg-[#fffdf9] border-2 border-black px-3 py-1.5 font-body text-sm font-bold">Support {{ icons.arrowUpRight("w-3.5 h-3.5") }}</span>
        </a>
      </div>

      <div class="flex flex-wrap gap-2 pt-1">
        <a href="https://www.reddit.com/user/RealNPC_" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#fffdf9] border-2 border-black px-3 py-2 font-mono text-sm font-bold text-black hover:bg-[#fde047]">{{ icons.reddit("w-4 h-4") }} reddit: u/RealNPC_ {{ icons.arrowUpRight("w-3 h-3") }}</a>
        <a href="https://x.com/LostSquidXD" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#fffdf9] border-2 border-black px-3 py-2 font-mono text-sm font-bold text-black hover:bg-[#fde047]">{{ icons.twitter("w-4 h-4") }} x: @LostSquidXD {{ icons.arrowUpRight("w-3 h-3") }}</a>
        <a href="https://www.planetminecraft.com/member/bittu5134/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#fffdf9] border-2 border-black px-3 py-2 font-mono text-sm font-bold text-black hover:bg-[#fde047]">{{ icons.planetMinecraft("w-4 h-4") }} planetminecraft: bittu5134 {{ icons.arrowUpRight("w-3 h-3") }}</a>
      </div>
    </div>
  </div>
</section>
