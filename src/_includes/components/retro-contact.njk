{% import "macros/icons.njk" as icons %}

<section id="contact" class="py-6 sm:py-8 px-3 sm:px-6 scroll-mt-16 sm:scroll-mt-20">
  <div class="max-w-5xl mx-auto">

    <div class="mb-6 sm:mb-8">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-mono font-black text-black tracking-tight">
        ~/contact
      </h2>
    </div>

    <div class="card-brutal sm:shadow-brutal-lg overflow-hidden p-4 sm:p-8 md:p-10 space-y-6">

      <!-- Email -->
      <div class="p-3 sm:p-4 bg-[#fef08a] border-2 border-black shadow-brutal-xs flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3 sm:gap-4">
          <svg class="w-7 h-7 sm:w-8 sm:h-8 text-black shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <div>
            <div class="font-mono text-xs uppercase font-bold text-black/60">EMAIL</div>
            <div class="font-mono text-sm sm:text-base font-bold text-black break-all">hello@bittu.dev</div>
          </div>
        </div>
        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <a href="mailto:hello@bittu.dev" class="btn-brutal-white px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm hover:bg-[#86efac]">
            <span>MAIL</span>
            {{ icons.arrowUpRight("w-3.5 h-3.5") }}
          </a>
          <button id="copy-email-contact" aria-label="Copy email address hello@bittu.dev" class="btn-brutal-yellow px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm">
            <span class="email-default flex items-center gap-1">
              {{ icons.copy("w-3.5 h-3.5") }}
              <span>COPY</span>
            </span>
            <span class="email-copied hidden">
              <span class="flex items-center gap-1 text-emerald-800 font-black">
                {{ icons.check("w-3.5 h-3.5 text-emerald-800 stroke-[3]") }}
                <span>COPIED!</span>
              </span>
            </span>
          </button>
        </div>
      </div>

      <!-- GitHub, LinkedIn, Discord, Patreon — clean standard SVGs, no black boxes -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <div class="p-3 sm:p-4 bg-[#c4b5fd] border-2 border-black shadow-brutal-xs flex items-center justify-between gap-2.5">
          <div class="flex items-center gap-3 sm:gap-4">
            <svg class="w-7 h-7 sm:w-8 sm:h-8 text-black shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.6 9.6 0 0 1 12 6.844a9.6 9.6 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2"/>
            </svg>
            <div>
              <div class="font-mono text-xs uppercase font-bold text-black/60">GITHUB</div>
              <div class="font-mono text-sm sm:text-base font-bold text-black">@Bittu5134</div>
            </div>
          </div>
          <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="btn-brutal-white px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm hover:bg-[#86efac]">
            <span>VISIT</span>
            {{ icons.arrowUpRight("w-3.5 h-3.5") }}
          </a>
        </div>

        <div class="p-3 sm:p-4 bg-[#38bdf8] border-2 border-black shadow-brutal-xs flex items-center justify-between gap-2.5">
          <div class="flex items-center gap-3 sm:gap-4">
            <svg class="w-7 h-7 sm:w-8 sm:h-8 text-black shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
            <div>
              <div class="font-mono text-xs uppercase font-bold text-black/60">LINKEDIN</div>
              <div class="font-mono text-sm sm:text-base font-bold text-black">in/bittu5134</div>
            </div>
          </div>
          <a href="https://www.linkedin.com/in/bittu5134" target="_blank" rel="noopener noreferrer" class="btn-brutal-white px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm hover:bg-[#86efac]">
            <span>VISIT</span>
            {{ icons.arrowUpRight("w-3.5 h-3.5") }}
          </a>
        </div>

        <div class="p-3 sm:p-4 bg-[#86efac] border-2 border-black shadow-brutal-xs flex items-center justify-between gap-2.5">
          <div class="flex items-center gap-3 sm:gap-4">
            <svg class="w-7 h-7 sm:w-8 sm:h-8 text-black shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.8 19.8 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.3 18.3 0 0 0-5.487 0 13 13 0 0 0-.617-1.25.08.08 0 0 0-.079-.037A19.7 19.7 0 0 0 3.677 4.37a.1.1 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.08.08 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.08.08 0 0 0 .084-.028 14 14 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13 13 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10 10 0 0 0 .372-.292.07.07 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.07.07 0 0 1 .078.01q.181.149.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.08.08 0 0 0 .084.028 19.8 19.8 0 0 0 6.002-3.03.08.08 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418m7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418"/>
            </svg>
            <div>
              <div class="font-mono text-xs uppercase font-bold text-black/60">DISCORD</div>
              <div class="font-mono text-sm sm:text-base font-bold text-black">bittu5134</div>
            </div>
          </div>
          <a href="/discord" target="_blank" rel="noopener noreferrer" class="btn-brutal-white px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm hover:bg-[#86efac]">
            <span>JOIN</span>
            {{ icons.arrowUpRight("w-3.5 h-3.5") }}
          </a>
        </div>

        <div class="p-3 sm:p-4 bg-[#f96854] border-2 border-black shadow-brutal-xs flex items-center justify-between gap-2.5">
          <div class="flex items-center gap-3 sm:gap-4">
            <svg class="w-7 h-7 sm:w-8 sm:h-8 text-black shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22.957 7.21c-.004-3.064-2.391-5.576-5.191-6.482-3.478-1.125-8.064-.962-11.384.604C2.357 3.231 1.093 7.391 1.046 11.54c-.039 3.411.302 12.396 5.369 12.46 3.765.047 4.326-4.804 6.068-7.141 1.24-1.662 2.836-2.132 4.801-2.618 3.376-.836 5.678-3.501 5.673-7.031Z"/>
            </svg>
            <div>
              <div class="font-mono text-xs uppercase font-bold text-black/70">PATREON</div>
              <div class="font-mono text-sm sm:text-base font-bold text-black">@lazybittu</div>
            </div>
          </div>
          <a href="https://www.patreon.com/lazybittu" target="_blank" rel="noopener noreferrer" class="btn-brutal-white px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm hover:bg-black hover:text-white">
            <span>SUPPORT</span>
            {{ icons.arrowUpRight("w-3.5 h-3.5") }}
          </a>
        </div>

      </div>

      <!-- Secondary links: smaller icons -->
      <div class="flex flex-wrap gap-2 pt-2 border-t-2 border-black/10">
        <a href="https://x.com/404lostsquid" target="_blank" rel="noopener noreferrer" class="profile-link hover:bg-[#38bdf8]">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-black shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/>
            </svg>
            X / TWITTER: @404lostsquid
          </span>
          {{ icons.arrowUpRight("w-4 h-4") }}
        </a>
        <a href="https://www.planetminecraft.com/member/bittu5134/" target="_blank" rel="noopener noreferrer" class="profile-link hover:bg-[#86efac]">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-black shrink-0" fill="currentColor" viewBox="0 0 16 16">
              <rect width="16" height="16" opacity=".15" rx="2"/>
              <path d="M2 3h4v3H2zm8 0h4v3h-4zM6 6h4v2H6zM4 8h2v2H4zm6 0h2v2h-2zm-6 2h8v2H4z"/>
            </svg>
            PLANET MINECRAFT: bittu5134
          </span>
          {{ icons.arrowUpRight("w-4 h-4") }}
        </a>
      </div>

    </div>
  </div>
</section>