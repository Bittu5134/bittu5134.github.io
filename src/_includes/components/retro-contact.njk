{% import "macros/icons.njk" as icons %}

<section id="contact" class="py-14 sm:py-20 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-3xl mx-auto">
    <p class="font-mono text-sm font-bold text-black/70 mb-2">~/contact</p>
    <h2 class="font-display text-5xl sm:text-6xl text-black leading-none">Contact</h2>
    <p class="font-body text-lg text-black/80 mt-4">Email is the best way to reach me. Socials are below if you prefer them.</p>

    <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4 rounded-3xl border-[3px] border-black bg-[#fffdf9] shadow-brutal p-6">
      <div class="flex-1">
        <p class="font-mono text-xs font-bold uppercase tracking-wide text-black/65">Email</p>
        <p class="font-mono text-lg font-bold text-black break-all">hello@bittu.dev</p>
      </div>
      <div class="flex gap-2">
        <a href="mailto:hello@bittu.dev" class="btn-pill bg-[#fde047]">Mail {{ icons.arrowUpRight("w-3.5 h-3.5 text-black") }}</a>
        <button id="copy-email-contact" class="btn-pill bg-[#fffdf9]" aria-label="Copy email address">
          <span class="email-default flex items-center gap-1.5">{{ icons.copy("w-3.5 h-3.5 text-black") }} Copy</span>
          <span class="email-copied hidden flex items-center gap-1.5">{{ icons.check("w-3.5 h-3.5 text-black") }} Copied</span>
        </button>
      </div>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 mt-10 font-body text-lg">
      <li><a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b-2 border-black/15 hover:text-[#b45309]"><span class="flex items-center gap-3">{{ icons.github("w-5 h-5 text-black") }} GitHub · @Bittu5134</span>{{ icons.arrowUpRight("w-4 h-4") }}</a></li>
      <li><a href="https://www.linkedin.com/in/bittu5134" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b-2 border-black/15 hover:text-[#b45309]"><span class="flex items-center gap-3">{{ icons.linkedin("w-5 h-5 text-black") }} LinkedIn · in/bittu5134</span>{{ icons.arrowUpRight("w-4 h-4") }}</a></li>
      <li><a href="/discord" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b-2 border-black/15 hover:text-[#b45309]"><span class="flex items-center gap-3">{{ icons.discord("w-5 h-5 text-black") }} Discord · bittu5134</span>{{ icons.arrowUpRight("w-4 h-4") }}</a></li>
      <li><a href="https://x.com/LostSquidXD" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b-2 border-black/15 hover:text-[#b45309]"><span class="flex items-center gap-3">{{ icons.twitter("w-5 h-5 text-black") }} X · @LostSquidXD</span>{{ icons.arrowUpRight("w-4 h-4") }}</a></li>
      <li><a href="https://www.reddit.com/user/RealNPC_" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b-2 border-black/15 hover:text-[#b45309]"><span class="flex items-center gap-3">{{ icons.reddit("w-5 h-5 text-black") }} Reddit · u/RealNPC_</span>{{ icons.arrowUpRight("w-4 h-4") }}</a></li>
      <li><a href="https://www.planetminecraft.com/member/bittu5134/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between py-3 border-b-2 border-black/15 hover:text-[#b45309]"><span class="flex items-center gap-3">{{ icons.planetMinecraft("w-5 h-5 text-black") }} Planet Minecraft · bittu5134</span>{{ icons.arrowUpRight("w-4 h-4") }}</a></li>
    </ul>
  </div>
</section>
