{% import "macros/icons.njk" as icons %}

<section id="contact" class="py-8 sm:py-12 px-4 sm:px-6 scroll-mt-16 sm:scroll-mt-20">
  <div class="max-w-4xl mx-auto">

    <div class="mb-6 sm:mb-8">
      <h2 class="text-3xl sm:text-4xl font-mono font-black text-black tracking-tight">
        ~/contact
      </h2>
      <p class="font-mono text-sm sm:text-base text-black/70 mt-1">
        Reach out for security research, systems engineering, or technical collaboration.
      </p>
    </div>

    <div class="bg-[#fffdf9] border-2 border-black p-5 sm:p-8 space-y-6 shadow-brutal-xs">

      <!-- Primary Professional Channels: GitHub, LinkedIn, Email, RSS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <!-- LinkedIn (Prioritized) -->
        <a
          href="https://www.linkedin.com/in/bittu5134"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 bg-[#f0f9ff] border-2 border-black hover:bg-[#bae6fd] hover:-translate-y-0.5 transition-all flex items-center justify-between group"
        >
          <div class="flex items-center gap-3">
            {{ icons.linkedin("w-6 h-6 text-black shrink-0") }}
            <div>
              <div class="font-mono text-xs uppercase font-bold text-black/70">LINKEDIN</div>
              <div class="font-mono text-sm sm:text-base font-bold text-black group-hover:underline">in/bittu5134</div>
            </div>
          </div>
          {{ icons.arrowUpRight("w-4 h-4 text-black") }}
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/Bittu5134"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 bg-[#faf5ff] border-2 border-black hover:bg-[#e9d5ff] hover:-translate-y-0.5 transition-all flex items-center justify-between group"
        >
          <div class="flex items-center gap-3">
            {{ icons.github("w-6 h-6 text-black shrink-0") }}
            <div>
              <div class="font-mono text-xs uppercase font-bold text-black/70">GITHUB</div>
              <div class="font-mono text-sm sm:text-base font-bold text-black group-hover:underline">@Bittu5134</div>
            </div>
          </div>
          {{ icons.arrowUpRight("w-4 h-4 text-black") }}
        </a>

        <!-- Email -->
        <div class="p-4 bg-[#fefce8] border-2 border-black flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            {{ icons.mail("w-6 h-6 text-black shrink-0") }}
            <div>
              <div class="font-mono text-xs uppercase font-bold text-black/70">EMAIL</div>
              <div class="font-mono text-sm sm:text-base font-bold text-black break-all">hello@bittu.dev</div>
            </div>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <a
              href="mailto:hello@bittu.dev"
              class="px-2.5 py-1 bg-white border border-black font-mono text-xs font-bold hover:bg-[#86efac] transition-colors"
            >
              MAIL
            </a>
            <button
              id="copy-email-contact"
              aria-label="Copy email hello@bittu.dev"
              class="px-2.5 py-1 bg-white border border-black font-mono text-xs font-bold cursor-pointer hover:bg-[#fde047] transition-colors"
            >
              <span class="email-default">COPY</span>
              <span class="email-copied hidden text-emerald-800 font-black">COPIED</span>
            </button>
          </div>
        </div>

        <!-- RSS Feed -->
        <a
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 bg-[#fff7ed] border-2 border-black hover:bg-[#fed7aa] hover:-translate-y-0.5 transition-all flex items-center justify-between group"
        >
          <div class="flex items-center gap-3">
            {{ icons.rss("w-6 h-6 text-amber-700 shrink-0") }}
            <div>
              <div class="font-mono text-xs uppercase font-bold text-black/70">RSS FEED</div>
              <div class="font-mono text-sm sm:text-base font-bold text-black group-hover:underline">bittu.dev/rss.xml</div>
            </div>
          </div>
          {{ icons.arrowUpRight("w-4 h-4 text-black") }}
        </a>

      </div>

      <!-- Secondary Links (Quiet Text Row) -->
      <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-black/15 font-mono text-xs text-black/75">
        <span class="font-bold uppercase text-black">Also on:</span>
        <a href="https://x.com/404lostsquid" target="_blank" rel="noopener noreferrer" class="hover:text-black hover:underline">
          X / Twitter
        </a>
        <span>·</span>
        <a href="https://www.patreon.com/lazybittu" target="_blank" rel="noopener noreferrer" class="hover:text-black hover:underline">
          Patreon
        </a>
        <span>·</span>
        <a href="/discord" target="_blank" rel="noopener noreferrer" class="hover:text-black hover:underline">
          Discord
        </a>
        <span>·</span>
        <a href="https://www.reddit.com/user/RealNPC_" target="_blank" rel="noopener noreferrer" class="hover:text-black hover:underline">
          Reddit
        </a>
      </div>

    </div>
  </div>
</section>