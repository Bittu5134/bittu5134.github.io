{% import "macros/icons.njk" as icons %}
{% set isHomePage = (page.url == "/") %}

{# One list for both navs; each item carries the full class strings Tailwind
   needs to see, so the desktop underline accent and the mobile hover tint stay
   a single source of truth. #}
{% set navItems = [
  { id: "projects", label: "Projects", accent: "after:bg-[#fde047]", hover: "hover:bg-[#fde047]" },
  { id: "blog", label: "Blog", accent: "after:bg-[#86efac]", hover: "hover:bg-[#86efac]", pageHref: "/blog/" },
  { id: "about", label: "About", accent: "after:bg-[#c4b5fd]", hover: "hover:bg-[#c4b5fd]" },
  { id: "contact", label: "Contact", accent: "after:bg-[#38bdf8]", hover: "hover:bg-[#38bdf8]" }
] %}

<header class="sticky top-0 z-50 bg-[#f3e7cc] border-b border-black/15">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">

    <a href="/" class="flex items-center gap-2.5 font-display text-3xl text-black leading-none py-2" aria-label="Bittu home">
      {{ icons.pixelMonster("w-6 h-6 text-black shrink-0") }}
      <span>bittu<span class="text-[#b45309]">.dev</span></span>
    </a>

    <!-- Desktop nav: plain text links, one accent underline on hover.
         Section anchors on the homepage; on any other page Blog goes to the
         archive and the rest jump back to the homepage sections. -->
    <nav class="hidden lg:flex items-center gap-8 font-body text-base font-bold text-black" aria-label="Main">
      {% for item in navItems %}
        {% set navHref = item.pageHref if (item.pageHref and not isHomePage) else (('#' if isHomePage else '/#') + item.id) %}
        <a href="{{ navHref }}" data-nav="{{ item.id }}" class="relative py-3 leading-none after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[3px] {{ item.accent }} after:scale-x-0 hover:after:scale-x-100 after:transition-transform">{{ item.label }}</a>
      {% endfor %}
    </nav>

    <div class="flex items-center gap-3">
      <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile (@Bittu5134)" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 bg-[#fffdf9] border-2 border-black font-body text-sm font-bold text-black hover:bg-[#fde047] transition-colors">
        {{ icons.github("w-5 h-5 text-black shrink-0") }} GitHub
      </a>

      <!-- Mobile menu toggle (wired up by main.js) -->
      <button id="menu-toggle-btn" class="lg:hidden inline-flex items-center gap-2 px-4 py-2 bg-[#fde047] border-2 border-black font-body text-sm font-bold text-black" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span id="menu-icon-open">{{ icons.menu("w-5 h-5 text-black shrink-0") }}</span>
        <span id="menu-icon-close" class="hidden">{{ icons.x("w-5 h-5 text-black shrink-0") }}</span>
        <span id="menu-text">MENU</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile backdrop (toggled by main.js) -->
<div id="mobile-backdrop" class="hidden fixed inset-0 top-16 bg-black/40 z-40 lg:hidden" aria-hidden="true"></div>

<!-- Mobile drawer (toggled by main.js) -->
<div id="mobile-drawer" class="hidden fixed top-16 left-0 right-0 z-50 lg:hidden bg-[#fffdf9] border-b-2 border-black max-h-[calc(100vh-4rem)] overflow-y-auto">
  <nav class="p-4 flex flex-col gap-2 font-body text-base font-bold text-black" aria-label="Mobile">
    {% for item in navItems %}
      {% set navHref = item.pageHref if (item.pageHref and not isHomePage) else (('#' if isHomePage else '/#') + item.id) %}
      <a href="{{ navHref }}" class="mobile-nav-link flex items-center justify-between px-4 py-3 {{ item.hover }}">{{ item.label }} <span aria-hidden="true">→</span></a>
    {% endfor %}
    <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="mt-2 flex items-center justify-center gap-2 px-4 py-3 bg-[#fffdf9] border-2 border-black">
      {{ icons.github("w-5 h-5 text-black shrink-0") }} GitHub
    </a>
  </nav>
</div>
