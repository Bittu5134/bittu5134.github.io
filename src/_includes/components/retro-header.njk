{% import "macros/icons.njk" as icons %}
{% set isHomePage = (page.url == "/") %}

<header class="sticky top-0 z-50 px-3 sm:px-6 pt-2.5 pb-2 bg-[#f6eedb]/95 backdrop-blur-md border-b-[3px] border-black">
  <div class="max-w-6xl mx-auto flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo -->
    <div class="flex items-center gap-2">
      {% if isHomePage %}
        <a
          href="#hero"
          class="cursor-pointer group flex items-center gap-2 px-2.5 sm:px-3 py-1 bg-[#fde047] border-2 border-black shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all"
        >
          {{ icons.pixelMonster("w-5 h-5 text-black shrink-0") }}
          <span class="font-mono text-sm sm:text-base font-black tracking-widest">BITTU.DEV</span>
        </a>
      {% else %}
        <a
          href="/"
          class="group flex items-center gap-2 px-2.5 sm:px-3 py-1 bg-[#fde047] border-2 border-black shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all"
        >
          {{ icons.pixelMonster("w-5 h-5 text-black shrink-0") }}
          <span class="font-mono text-sm sm:text-base font-black tracking-widest">BITTU.DEV</span>
          <span class="hidden sm:inline-block text-xs font-mono bg-black text-white px-2 py-0.5 rounded-sm font-bold">
            ← HOME
          </span>
        </a>
      {% endif %}
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-2 font-mono">
      <a
        href="{{ '#projects' if isHomePage else '/#projects' }}"
        class="cursor-pointer px-3 py-1 bg-[#fffdf9] border-2 border-black text-xs sm:text-sm font-black shadow-brutal-xs hover:bg-[#fde047] hover:shadow-brutal hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all tracking-tight flex items-center gap-1.5"
      >
        {{ icons.folder("w-3.5 h-3.5 text-black shrink-0") }}
        <span>~/projects</span>
      </a>

      <a
        href="{{ '#blog' if isHomePage else '/blog' }}"
        class="cursor-pointer px-3 py-1 bg-[#fffdf9] border-2 border-black text-xs sm:text-sm font-black shadow-brutal-xs hover:bg-[#fde047] hover:shadow-brutal hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all tracking-tight flex items-center gap-1.5"
      >
        {{ icons.fileText("w-3.5 h-3.5 text-black shrink-0") }}
        <span>~/blog</span>
      </a>

      <a
        href="{{ '#about' if isHomePage else '/#about' }}"
        class="cursor-pointer px-3 py-1 bg-[#fffdf9] border-2 border-black text-xs sm:text-sm font-black shadow-brutal-xs hover:bg-[#fde047] hover:shadow-brutal hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all tracking-tight flex items-center gap-1.5"
      >
        {{ icons.user("w-3.5 h-3.5 text-black shrink-0") }}
        <span>~/about</span>
      </a>

      <a
        href="{{ '#contact' if isHomePage else '/#contact' }}"
        class="cursor-pointer px-3 py-1 bg-[#fffdf9] border-2 border-black text-xs sm:text-sm font-black shadow-brutal-xs hover:bg-[#fde047] hover:shadow-brutal hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all tracking-tight flex items-center gap-1.5"
      >
        {{ icons.mail("w-3.5 h-3.5 text-black shrink-0") }}
        <span>~/contact</span>
      </a>

      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="RSS Feed"
        class="px-2.5 py-1 bg-[#fb923c] text-black border-2 border-black text-xs sm:text-sm font-bold shadow-brutal-xs hover:shadow-brutal hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all flex items-center gap-1.5"
      >
        {{ icons.rss("w-3.5 h-3.5 text-black shrink-0") }}
        <span>RSS</span>
      </a>
    </nav>

    <!-- Actions & Mobile Hamburger -->
    <div class="flex items-center gap-2">
      <a
        href="https://github.com/Bittu5134"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile (@Bittu5134)"
        class="px-2.5 py-1 sm:py-1.5 bg-[#fffdf9] border-2 border-black font-mono text-xs sm:text-sm font-bold shadow-brutal-xs hover:bg-[#c4b5fd] hover:shadow-brutal hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all flex items-center justify-center gap-1.5"
      >
        {{ icons.github("w-4 h-4 sm:w-5 sm:h-5 text-black shrink-0") }}
        <span class="hidden sm:inline-block font-mono text-xs sm:text-sm font-bold">GITHUB</span>
      </a>

      <!-- Mobile Hamburger Toggle Button -->
      <button
        id="menu-toggle-btn"
        class="lg:hidden px-3 py-1 sm:py-1.5 bg-[#fde047] border-2 border-black font-mono text-xs sm:text-sm font-black shadow-brutal-xs hover:bg-[#fb923c] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all flex items-center gap-1.5 select-none cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span id="menu-icon-open">{{ icons.menu("w-4 h-4 text-black shrink-0") }}</span>
        <span id="menu-icon-close" class="hidden">{{ icons.x("w-4 h-4 text-black shrink-0") }}</span>
        <span id="menu-text">MENU</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Backdrop Overlay -->
<div
  id="mobile-backdrop"
  class="hidden fixed inset-0 top-[54px] sm:top-[58px] bg-black/50 backdrop-blur-sm z-40 lg:hidden transition-opacity duration-200"
  aria-hidden="true"
></div>

<!-- Mobile Slide-down Neo-Brutalist Drawer -->
<div
  id="mobile-drawer"
  class="hidden fixed top-[54px] sm:top-[58px] left-0 right-0 z-50 lg:hidden bg-[#fffdf9] border-b-[4px] border-black shadow-brutal-lg max-h-[calc(100vh-65px)] overflow-y-auto"
>
  <!-- Drawer Window Titlebar -->
  <div class="bg-[#fb923c] px-4 py-2 border-b-2 border-black flex items-center justify-between select-none">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 bg-[#f87171] border border-black"></span>
      <span class="w-2.5 h-2.5 bg-[#fde047] border border-black"></span>
      <span class="w-2.5 h-2.5 bg-[#86efac] border border-black"></span>
      <span class="font-mono text-xs font-bold text-black ml-1">
        SYSTEM MENU: bittu@android
      </span>
    </div>
    <button
      id="drawer-close-btn"
      aria-label="Close menu"
      class="font-mono text-xs font-bold px-1.5 py-0.5 bg-black text-white hover:bg-red-500 active:scale-95 flex items-center justify-center cursor-pointer"
    >
      {{ icons.x("w-3.5 h-3.5") }}
    </button>
  </div>

  <!-- Navigation Links list -->
  <div class="p-4 space-y-2.5">
    <div class="text-xs font-mono font-bold text-black/60 uppercase tracking-widest px-1">
      NAVIGATION DIRECTORY:
    </div>

    <a
      href="{{ '#projects' if isHomePage else '/#projects' }}"
      class="mobile-nav-link w-full flex items-center justify-between px-3.5 py-2.5 bg-[#f6eedb] border-2 border-black font-mono text-sm font-bold shadow-brutal-xs hover:bg-[#fde047] active:translate-x-1 active:translate-y-0.5 transition-all cursor-pointer"
    >
      <span class="flex items-center gap-2">
        {{ icons.folder("w-4 h-4 text-black shrink-0") }}
        <span class="text-black font-black">~/projects</span>
      </span>
      <span class="text-black/60 font-mono text-xs">→</span>
    </a>

    <a
      href="{{ '#blog' if isHomePage else '/blog' }}"
      class="mobile-nav-link w-full flex items-center justify-between px-3.5 py-2.5 bg-[#f6eedb] border-2 border-black font-mono text-sm font-bold shadow-brutal-xs hover:bg-[#fde047] active:translate-x-1 active:translate-y-0.5 transition-all cursor-pointer"
    >
      <span class="flex items-center gap-2">
        {{ icons.fileText("w-4 h-4 text-black shrink-0") }}
        <span class="text-black font-black">~/blog</span>
      </span>
      <span class="text-black/60 font-mono text-xs">→</span>
    </a>

    <a
      href="{{ '#about' if isHomePage else '/#about' }}"
      class="mobile-nav-link w-full flex items-center justify-between px-3.5 py-2.5 bg-[#f6eedb] border-2 border-black font-mono text-sm font-bold shadow-brutal-xs hover:bg-[#fde047] active:translate-x-1 active:translate-y-0.5 transition-all cursor-pointer"
    >
      <span class="flex items-center gap-2">
        {{ icons.user("w-4 h-4 text-black shrink-0") }}
        <span class="text-black font-black">~/about</span>
      </span>
      <span class="text-black/60 font-mono text-xs">→</span>
    </a>

    <a
      href="{{ '#contact' if isHomePage else '/#contact' }}"
      class="mobile-nav-link w-full flex items-center justify-between px-3.5 py-2.5 bg-[#f6eedb] border-2 border-black font-mono text-sm font-bold shadow-brutal-xs hover:bg-[#fde047] active:translate-x-1 active:translate-y-0.5 transition-all cursor-pointer"
    >
      <span class="flex items-center gap-2">
        {{ icons.mail("w-4 h-4 text-black shrink-0") }}
        <span class="text-black font-black">~/contact</span>
      </span>
      <span class="text-black/60 font-mono text-xs">→</span>
    </a>

    <!-- Quick External Actions -->
    <div class="pt-2 border-t-2 border-black/15 grid grid-cols-2 gap-2">
      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="RSS Feed"
        class="flex items-center justify-center gap-1.5 px-3 py-2 bg-[#fb923c] text-black border-2 border-black font-mono text-xs font-bold shadow-brutal-xs hover:shadow-brutal active:translate-x-0.5 active:translate-y-0.5"
      >
        {{ icons.rss("w-3.5 h-3.5 text-black shrink-0") }}
        <span>RSS FEED</span>
      </a>

      <a
        href="https://github.com/Bittu5134"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile (@Bittu5134)"
        class="flex items-center justify-center gap-1.5 px-3 py-2 bg-[#fffdf9] text-black border-2 border-black font-mono text-xs font-bold shadow-brutal-xs hover:bg-[#c4b5fd] active:translate-x-0.5 active:translate-y-0.5"
      >
        {{ icons.github("w-4 h-4 text-black shrink-0") }}
        <span>GITHUB</span>
      </a>
    </div>

    <div class="pt-1">
      <a
        href="/discord"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 px-3 py-2 bg-[#c4b5fd] text-black border-2 border-black font-mono text-xs font-bold shadow-brutal-xs active:translate-x-0.5 active:translate-y-0.5"
      >
        {{ icons.discord("w-4 h-4 text-black shrink-0") }}
        <span>JOIN DISCORD COMMUNITY</span>
      </a>
    </div>
  </div>
</div>
