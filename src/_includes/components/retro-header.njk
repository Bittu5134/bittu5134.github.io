{% import "macros/icons.njk" as icons %}
{% set isHomePage = (page.url == "/") %}

<header class="sticky top-0 z-50 bg-[#fbf7ef]/95 backdrop-blur-md border-b-2 border-black/10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">

    <a href="/" class="flex items-center gap-2.5 font-display text-2xl text-black leading-none" aria-label="Bittu home">
      {{ icons.pixelMonster("w-6 h-6 text-black shrink-0") }}
      <span>bittu<span class="text-[#b45309]">.dev</span></span>
    </a>

    <!-- Desktop nav: plain text links, one accent underline on hover -->
    <nav class="hidden lg:flex items-center gap-7 font-body text-base font-bold text-black" aria-label="Main">
      <a href="{{ '#projects' if isHomePage else '/#projects' }}" class="relative py-1 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[3px] after:bg-[#fde047] after:scale-x-0 hover:after:scale-x-100 after:transition-transform">Projects</a>
      <a href="{{ '#blog' if isHomePage else '/blog' }}" class="relative py-1 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[3px] after:bg-[#86efac] after:scale-x-0 hover:after:scale-x-100 after:transition-transform {{ 'after:scale-x-100' if page.url and page.url.startsWith('/blog') else '' }}">Blog</a>
      <a href="{{ '#about' if isHomePage else '/#about' }}" class="relative py-1 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[3px] after:bg-[#c4b5fd] after:scale-x-0 hover:after:scale-x-100 after:transition-transform">About</a>
      <a href="{{ '#contact' if isHomePage else '/#contact' }}" class="relative py-1 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[3px] after:bg-[#38bdf8] after:scale-x-0 hover:after:scale-x-100 after:transition-transform">Contact</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile (@Bittu5134)" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#fffdf9] border-2 border-black font-body text-base font-bold text-black hover:bg-[#fde047] transition-colors">
        {{ icons.github("w-5 h-5 text-black shrink-0") }} GitHub
      </a>

      <!-- Mobile menu toggle (wired up by main.js) -->
      <button id="menu-toggle-btn" class="lg:hidden inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#fde047] border-2 border-black font-body text-base font-bold text-black" aria-label="Toggle navigation menu" aria-expanded="false">
        <span id="menu-icon-open">{{ icons.menu("w-5 h-5 text-black shrink-0") }}</span>
        <span id="menu-icon-close" class="hidden">{{ icons.x("w-5 h-5 text-black shrink-0") }}</span>
        <span id="menu-text">Menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile backdrop (toggled by main.js) -->
<div id="mobile-backdrop" class="hidden fixed inset-0 top-16 bg-black/40 z-40 lg:hidden" aria-hidden="true"></div>

<!-- Mobile drawer (toggled by main.js) -->
<div id="mobile-drawer" class="hidden fixed top-16 left-0 right-0 z-50 lg:hidden bg-[#fffdf9] border-b-2 border-black rounded-b-3xl max-h-[calc(100vh-4rem)] overflow-y-auto">
  <nav class="p-4 flex flex-col gap-2 font-body text-lg font-bold text-black" aria-label="Mobile">
    <a href="{{ '#projects' if isHomePage else '/#projects' }}" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-2xl hover:bg-[#fde047]">Projects <span aria-hidden="true">→</span></a>
    <a href="{{ '#blog' if isHomePage else '/blog' }}" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-2xl hover:bg-[#86efac]">Blog <span aria-hidden="true">→</span></a>
    <a href="{{ '#about' if isHomePage else '/#about' }}" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-2xl hover:bg-[#c4b5fd]">About <span aria-hidden="true">→</span></a>
    <a href="{{ '#contact' if isHomePage else '/#contact' }}" class="mobile-nav-link flex items-center justify-between px-4 py-3 rounded-2xl hover:bg-[#38bdf8]">Contact <span aria-hidden="true">→</span></a>
    <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="mt-2 flex items-center justify-center gap-2 px-4 py-3 rounded-full bg-[#fffdf9] border-2 border-black">
      {{ icons.github("w-5 h-5 text-black shrink-0") }} GitHub
    </a>
  </nav>
</div>
