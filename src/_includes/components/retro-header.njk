{% import "macros/icons.njk" as icons %}
{% set isHomePage = (page.url == "/") %}

<header class="sticky top-0 z-50 px-4 sm:px-6 py-3 bg-[#f6eedb]/95 backdrop-blur-md border-b border-black/15">
  <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a
      href="/"
      class="flex items-center gap-2 text-black hover:text-amber-700 transition-colors"
      aria-label="Bittu Home"
    >
      <span class="font-mono text-base sm:text-lg font-black tracking-tight">bittu.dev</span>
    </a>

    <!-- Desktop Navigation Links (Clean Text Bar) -->
    <nav class="hidden md:flex items-center gap-6 font-mono text-sm text-black/80 font-medium">
      <a
        href="{{ '#projects' if isHomePage else '/#projects' }}"
        class="hover:text-black hover:underline underline-offset-4 transition-colors"
      >
        Projects
      </a>

      <a
        href="{{ '#blog' if isHomePage else '/blog' }}"
        class="hover:text-black hover:underline underline-offset-4 transition-colors {{ 'font-bold text-black underline' if page.url and page.url.startsWith('/blog') else '' }}"
      >
        Blog
      </a>

      <a
        href="{{ '#about' if isHomePage else '/#about' }}"
        class="hover:text-black hover:underline underline-offset-4 transition-colors"
      >
        About
      </a>

      <a
        href="{{ '#contact' if isHomePage else '/#contact' }}"
        class="hover:text-black hover:underline underline-offset-4 transition-colors"
      >
        Contact
      </a>
    </nav>

    <!-- Right Actions: GitHub, LinkedIn, RSS & Mobile Menu -->
    <div class="flex items-center gap-3">
      <div class="hidden sm:flex items-center gap-3 text-black/75 font-mono text-sm">
        <a
          href="https://github.com/Bittu5134"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-black transition-colors flex items-center gap-1.5"
          title="GitHub Profile"
        >
          {{ icons.github("w-4 h-4 text-black") }}
          <span class="hidden lg:inline">GitHub</span>
        </a>

        <span class="text-black/30">/</span>

        <a
          href="https://www.linkedin.com/in/bittu5134"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-black transition-colors flex items-center gap-1.5"
          title="LinkedIn Profile"
        >
          {{ icons.linkedin("w-4 h-4 text-black") }}
          <span class="hidden lg:inline">LinkedIn</span>
        </a>

        <span class="text-black/30">/</span>

        <a
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-amber-700 transition-colors flex items-center gap-1.5"
          title="RSS Feed"
        >
          {{ icons.rss("w-4 h-4 text-amber-700") }}
          <span class="hidden lg:inline">RSS</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="menu-toggle-btn"
        class="md:hidden flex items-center gap-1.5 px-2.5 py-1.5 border border-black/20 rounded-md font-mono text-xs font-bold text-black bg-white/60 hover:bg-white transition-colors"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span id="menu-icon-open">{{ icons.menu("w-4 h-4 text-black shrink-0") }}</span>
        <span id="menu-icon-close" class="hidden">{{ icons.x("w-4 h-4 text-black shrink-0") }}</span>
        <span id="menu-text">MENU</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Backdrop Overlay -->
<div
  id="mobile-backdrop"
  class="hidden fixed inset-0 top-[52px] bg-black/40 backdrop-blur-xs z-40 md:hidden transition-opacity duration-200"
  aria-hidden="true"
></div>

<!-- Mobile Slide-down Menu -->
<div
  id="mobile-drawer"
  class="hidden fixed top-[52px] left-0 right-0 z-50 md:hidden bg-[#fffdf9] border-b border-black/20 shadow-xl max-h-[calc(100vh-55px)] overflow-y-auto"
>
  <div class="p-5 space-y-3 font-mono text-sm">
    <a
      href="{{ '#projects' if isHomePage else '/#projects' }}"
      class="mobile-nav-link flex items-center justify-between py-2 border-b border-black/10 text-black font-bold"
    >
      <span>Projects</span>
      <span class="text-black/50">→</span>
    </a>

    <a
      href="{{ '#blog' if isHomePage else '/blog' }}"
      class="mobile-nav-link flex items-center justify-between py-2 border-b border-black/10 text-black font-bold"
    >
      <span>Blog</span>
      <span class="text-black/50">→</span>
    </a>

    <a
      href="{{ '#about' if isHomePage else '/#about' }}"
      class="mobile-nav-link flex items-center justify-between py-2 border-b border-black/10 text-black font-bold"
    >
      <span>About</span>
      <span class="text-black/50">→</span>
    </a>

    <a
      href="{{ '#contact' if isHomePage else '/#contact' }}"
      class="mobile-nav-link flex items-center justify-between py-2 border-b border-black/10 text-black font-bold"
    >
      <span>Contact</span>
      <span class="text-black/50">→</span>
    </a>

    <!-- Social Links Grid in Mobile Menu -->
    <div class="pt-3 grid grid-cols-3 gap-2 text-center text-xs">
      <a
        href="https://github.com/Bittu5134"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 border border-black/20 rounded bg-white flex flex-col items-center gap-1 text-black font-bold"
      >
        {{ icons.github("w-4 h-4") }}
        <span>GitHub</span>
      </a>

      <a
        href="https://www.linkedin.com/in/bittu5134"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 border border-black/20 rounded bg-white flex flex-col items-center gap-1 text-black font-bold"
      >
        {{ icons.linkedin("w-4 h-4") }}
        <span>LinkedIn</span>
      </a>

      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 border border-black/20 rounded bg-white flex flex-col items-center gap-1 text-amber-700 font-bold"
      >
        {{ icons.rss("w-4 h-4") }}
        <span>RSS</span>
      </a>
    </div>
  </div>
</div>
