---
layout: layouts/base.njk
ogType: article
---
{% import "macros/icons.njk" as icons %}
{% set tocList = content | toc %}

<!-- Reading Progress Bar (Catppuccin Lavender) -->
<div
  id="reading-progress"
  class="fixed top-0 left-0 h-[2px] bg-[#b4befe] z-50 transition-all duration-75"
  style="width: 0%"
  aria-hidden="true"
></div>

<div class="min-h-screen bg-[#1e1e2e] text-[#cdd6f4] font-sans selection:bg-[#585b70] selection:text-[#cdd6f4]">
  <!-- Solid Minimal Top Navigation Bar matching article width -->
  <header class="bg-[#1e1e2e] border-b border-[#313244] px-4 sm:px-6 md:px-8 py-4">
    <div class="max-w-3xl mx-auto flex items-center justify-between gap-4 text-sm font-mono">
      <!-- Minimal Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 truncate text-[#a6adc8]">
        <a
          href="/"
          class="hover:text-[#cdd6f4] transition-colors font-medium shrink-0 min-h-[44px] inline-flex items-center py-2"
        >
          bittu.dev
        </a>
        <span class="text-[#585b70]">/</span>
        <a
          href="/blog"
          class="hover:text-[#cdd6f4] transition-colors font-medium shrink-0 min-h-[44px] inline-flex items-center py-2"
        >
          blog
        </a>
      </nav>

      <!-- Clean Action Area: Share Widget with Solid Popover / Native Sheet -->
      <div class="relative flex items-center shrink-0">
        <button
          id="share-article-btn"
          class="hover:text-[#cdd6f4] text-[#a6adc8] transition-colors flex items-center gap-1.5 cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#89b4fa] rounded px-3 py-1.5 min-h-[44px] touch-manipulation"
          data-title="{{ title }}"
          data-url="https://bittu.dev{{ page.url }}"
          aria-haspopup="true"
          aria-expanded="false"
          title="Share article"
        >
          {{ icons.share2("w-4 h-4") }}
          <span>Share</span>
        </button>

        <!-- Desktop Share Popover (Solid Catppuccin Mantle) -->
        <div
          id="share-popover"
          class="hidden absolute right-0 top-full mt-2 w-56 bg-[#181825] border border-[#313244] rounded-xl shadow-2xl p-2 z-50 text-sm font-mono flex flex-col gap-1"
          role="menu"
          aria-label="Share options"
        >
          <a
            href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ ('https://bittu.dev' + page.url) | urlencode }}"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 px-3 py-2 text-[#cdd6f4] hover:bg-[#313244] rounded-lg transition-colors"
            role="menuitem"
          >
            {{ icons.twitter("w-4 h-4 text-[#89b4fa]") }}
            <span>Share on X</span>
          </a>

          <a
            href="https://www.linkedin.com/sharing/share-offsite/?url={{ ('https://bittu.dev' + page.url) | urlencode }}"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 px-3 py-2 text-[#cdd6f4] hover:bg-[#313244] rounded-lg transition-colors"
            role="menuitem"
          >
            {{ icons.linkedin("w-4 h-4 text-[#89b4fa]") }}
            <span>Share on LinkedIn</span>
          </a>

          <a
            href="https://api.whatsapp.com/send?text={{ (title + ' ' + 'https://bittu.dev' + page.url) | urlencode }}"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 px-3 py-2 text-[#cdd6f4] hover:bg-[#313244] rounded-lg transition-colors"
            role="menuitem"
          >
            <svg class="w-4 h-4 text-[#a6e3a1]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
            <span>Share on WhatsApp</span>
          </a>

          <a
            href="https://reddit.com/submit?url={{ ('https://bittu.dev' + page.url) | urlencode }}&title={{ title | urlencode }}"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 px-3 py-2 text-[#cdd6f4] hover:bg-[#313244] rounded-lg transition-colors"
            role="menuitem"
          >
            {{ icons.reddit("w-4 h-4 text-[#fab387]") }}
            <span>Share on Reddit</span>
          </a>

          <div class="h-px bg-[#313244] my-1"></div>

          <button
            id="popover-copy-link-btn"
            class="w-full flex items-center justify-between px-3 py-2 text-[#cdd6f4] hover:bg-[#313244] rounded-lg transition-colors cursor-pointer text-left"
            role="menuitem"
          >
            <span class="share-copy-label flex items-center gap-2.5">
              {{ icons.copy("w-4 h-4 text-[#a6adc8]") }}
              <span>Copy link</span>
            </span>
            <span class="share-copy-done hidden flex items-center gap-1 text-[#a6e3a1] font-medium">
              {{ icons.check("w-4 h-4 text-[#a6e3a1] stroke-[2.5]") }}
              <span>Copied!</span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Centered Reading Column -->
  <main class="max-w-3xl mx-auto px-4 sm:px-6 md:px-8 py-10 sm:py-14 md:py-20">
    <article id="article-top" class="min-w-0" data-pagefind-body>
      <!-- Optional Cover Image -->
      {% if coverImage %}
        <div class="mb-10 rounded-lg overflow-hidden border border-[#313244] bg-[#181825]">
          <img
            src="{{ coverImage }}"
            alt="{{ coverAlt if coverAlt else title }}"
            class="w-full h-auto max-h-[440px] object-cover"
            loading="lazy"
            decoding="async"
            data-pagefind-meta="image[src]"
          />
        </div>
      {% endif %}

      <!-- Article Header -->
      <header class="mb-10">
        <!-- Date & Read Time -->
        <div class="flex items-center gap-2 text-sm font-mono text-[#a6adc8] mb-3.5">
          <time datetime="{{ date | dateIso }}">{{ (displayDate or date) | dateDisplay }}</time>
          <span class="text-[#585b70]">·</span>
          <span>{{ readTime or (content | readingTime) }}</span>
        </div>

        <!-- Article Title -->
        <h1 class="text-3xl sm:text-4xl md:text-[2.6rem] font-bold text-[#cdd6f4] leading-[1.22] tracking-tight mb-5 font-sans" data-pagefind-meta="title">
          {{ title }}
        </h1>

        <!-- Summary / Lead Paragraph -->
        {% if summary %}
          <p class="text-base sm:text-lg text-[#bac2de] font-normal leading-relaxed mb-6" data-pagefind-meta="summary">
            {{ summary }}
          </p>
        {% endif %}

        <!-- Tags List with Catppuccin Accents -->
        {% if tags and tags.length > 0 %}
          <div class="flex flex-wrap items-center gap-x-3.5 gap-y-2 text-sm font-mono text-[#a6adc8] pt-1">
            {% for tag in tags %}
              {% if tag != "posts" %}
                <a
                  href="/blog?tag={{ tag | urlencode }}"
                  class="hover:text-[#b4befe] transition-colors py-1 inline-flex items-center"
                  data-pagefind-filter="tag"
                >
                  #{{ tag }}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </header>

      <!-- Minimal Table of Contents -->
      {% if tocList.length > 1 %}
        <details class="mb-10 border border-[#313244] rounded-lg p-4 bg-[#181825] group">
          <summary class="cursor-pointer font-mono text-sm text-[#cdd6f4] flex items-center justify-between select-none focus-visible:outline-none min-h-[36px]">
            <span class="flex items-center gap-2 font-medium">
              <span>Table of contents</span>
              <span class="text-[#a6adc8]">({{ tocList.length }} sections)</span>
            </span>
            <span class="text-[#a6adc8] text-xs group-open:rotate-180 transition-transform duration-150">▼</span>
          </summary>
          <nav class="mt-3 pt-3 border-t border-[#313244] space-y-1.5 text-sm font-mono">
            {% for item in tocList %}
              <a
                href="#{{ item.id }}"
                class="block py-1 text-[#a6adc8] hover:text-[#89b4fa] transition-colors {{ 'pl-3 text-[#7f849c]' if item.level == 3 else 'text-[#bac2de] font-medium' }}"
              >
                {{ item.title }}
              </a>
            {% endfor %}
          </nav>
        </details>
      {% endif %}

      <!-- Markdown Content Body -->
      <div class="prose prose-invert prose-zinc max-w-none text-[#cdd6f4] prose-retro">
        {{ content | safe }}
      </div>

      <!-- Unified Post Footer: Single clean author + navigation section -->
      <footer class="mt-16 pt-10 border-t border-[#313244] space-y-8">
        <!-- Author Profile & Links -->
        <div class="flex items-center justify-between flex-wrap gap-4 text-sm font-mono">
          <div class="flex items-center gap-3">
            <img
              src="/images/avatar.webp"
              alt="Bittu avatar"
              class="w-9 h-9 rounded-full border border-[#45475a] object-cover shrink-0"
              loading="lazy"
            />
            <div>
              <div class="text-[#cdd6f4] font-medium font-sans">Bittu</div>
              <div class="text-xs text-[#a6adc8]">Systems &amp; Security</div>
            </div>
          </div>
          <div class="flex items-center gap-2 text-sm text-[#a6adc8]">
            <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="hover:text-[#89b4fa] transition-colors min-h-[44px] inline-flex items-center px-2">
              GitHub
            </a>
            <span class="text-[#585b70]">·</span>
            <a href="https://www.linkedin.com/in/bittu5134" target="_blank" rel="noopener noreferrer" class="hover:text-[#89b4fa] transition-colors min-h-[44px] inline-flex items-center px-2">
              LinkedIn
            </a>
            <span class="text-[#585b70]">·</span>
            <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="hover:text-[#fab387] transition-colors min-h-[44px] inline-flex items-center px-2">
              RSS
            </a>
          </div>
        </div>

        <!-- Previous / Next Navigation & See More Blogs -->
        {% set prevPost = collections.blogs | getPreviousCollectionItem(page) %}
        {% set nextPost = collections.blogs | getNextCollectionItem(page) %}
        {% if prevPost or nextPost or true %}
          <div class="pt-6 border-t border-[#313244] space-y-3 font-mono text-sm">
            {% if prevPost %}
              <div class="flex items-baseline justify-between gap-3 group">
                <div class="flex items-baseline gap-2 min-w-0">
                  <span class="text-[#7f849c] shrink-0 text-xs uppercase tracking-wider">Previous:</span>
                  <a
                    href="{{ prevPost.url }}"
                    class="font-sans font-medium text-[#cdd6f4] hover:text-[#89b4fa] transition-colors truncate"
                  >
                    {{ prevPost.data.title }}
                  </a>
                </div>
                <time datetime="{{ prevPost.date | dateIso }}" class="text-xs text-[#7f849c] shrink-0 font-mono">
                  {{ (prevPost.data.displayDate or prevPost.date) | dateDisplay }}
                </time>
              </div>
            {% endif %}

            {% if nextPost %}
              <div class="flex items-baseline justify-between gap-3 group">
                <div class="flex items-baseline gap-2 min-w-0">
                  <span class="text-[#7f849c] shrink-0 text-xs uppercase tracking-wider">Next:</span>
                  <a
                    href="{{ nextPost.url }}"
                    class="font-sans font-medium text-[#cdd6f4] hover:text-[#89b4fa] transition-colors truncate"
                  >
                    {{ nextPost.data.title }}
                  </a>
                </div>
                <time datetime="{{ nextPost.date | dateIso }}" class="text-xs text-[#7f849c] shrink-0 font-mono">
                  {{ (nextPost.data.displayDate or nextPost.date) | dateDisplay }}
                </time>
              </div>
            {% endif %}

            <div class="pt-2 flex items-center">
              <a
                href="/blog"
                class="inline-flex items-center gap-1.5 text-xs font-mono text-[#a6adc8] hover:text-[#89b4fa] transition-colors group"
              >
                <span>See more blogs</span>
                <span class="transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            </div>
          </div>
        {% endif %}
      </footer>

      <!-- Giscus Comments Section (GitHub Discussions) -->
      <section class="mt-14 pt-8 border-t border-[#313244]" id="comments">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl sm:text-2xl font-bold font-sans text-[#cdd6f4]">Discussion</h2>
        </div>
        <div class="giscus-container min-h-[160px]">
          <script src="https://giscus.app/client.js"
            data-repo="Bittu5134/bittu5134.github.io"
            data-repo-id="R_kgDOH4e-bA"
            data-category="Announcements"
            data-category-id="DIC_kwDOH4e-bM4Cbfj1"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="bottom"
            data-theme="catppuccin_mocha"
            data-lang="en"
            data-loading="lazy"
            crossorigin="anonymous"
            async>
          </script>
        </div>
      </section>
    </article>
  </main>
</div>

<!-- Share Widget Logic (Native Share on Mobile / Dropdown on Desktop) -->
<script>
  (function() {
    const shareBtn = document.getElementById("share-article-btn");
    const sharePopover = document.getElementById("share-popover");
    const copyBtn = document.getElementById("popover-copy-link-btn");
    const title = shareBtn ? shareBtn.getAttribute("data-title") : document.title;
    const url = shareBtn ? shareBtn.getAttribute("data-url") : window.location.href;

    if (!shareBtn) return;

    // Detect mobile / touch with navigator.share support
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.maxTouchPoints > 1 && window.innerWidth < 768);

    shareBtn.addEventListener("click", async function(e) {
      e.stopPropagation();

      if (isMobile && navigator.share) {
        try {
          await navigator.share({
            title: title,
            url: url
          });
        } catch (err) {
          if (err.name !== "AbortError") {
            togglePopover();
          }
        }
      } else {
        togglePopover();
      }
    });

    function togglePopover() {
      if (!sharePopover) return;
      const isHidden = sharePopover.classList.contains("hidden");
      if (isHidden) {
        sharePopover.classList.remove("hidden");
        shareBtn.setAttribute("aria-expanded", "true");
      } else {
        sharePopover.classList.add("hidden");
        shareBtn.setAttribute("aria-expanded", "false");
      }
    }

    // Copy link inside popover
    if (copyBtn) {
      copyBtn.addEventListener("click", async function(e) {
        e.stopPropagation();
        try {
          await navigator.clipboard.writeText(url);
          const label = copyBtn.querySelector(".share-copy-label");
          const done = copyBtn.querySelector(".share-copy-done");
          if (label && done) {
            label.classList.add("hidden");
            done.classList.remove("hidden");
            setTimeout(() => {
              label.classList.remove("hidden");
              done.classList.add("hidden");
            }, 2000);
          }
        } catch (err) {
          console.error("Clipboard copy failed:", err);
        }
      });
    }

    // Close on click outside
    document.addEventListener("click", function(e) {
      if (sharePopover && !sharePopover.classList.contains("hidden")) {
        if (!sharePopover.contains(e.target) && e.target !== shareBtn && !shareBtn.contains(e.target)) {
          sharePopover.classList.add("hidden");
          shareBtn.setAttribute("aria-expanded", "false");
        }
      }
    });

    // Close on Escape key
    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape" && sharePopover && !sharePopover.classList.contains("hidden")) {
        sharePopover.classList.add("hidden");
        shareBtn.setAttribute("aria-expanded", "false");
      }
    });
  })();
</script>

<!-- Conditionally Load Mermaid.js Only If The Page Uses Diagrams -->
{% if 'class="mermaid' in content %}
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

    function getMermaidConfig() {
      return {
        startOnLoad: false,
        securityLevel: "loose",
        theme: "dark",
        themeVariables: {
          primaryColor: "#313244",
          primaryBorderColor: "#89b4fa",
          primaryTextColor: "#cdd6f4",
          lineColor: "#9399b2",
          secondaryColor: "#181825",
          tertiaryColor: "#11111b",
          background: "#1e1e2e",
          mainBkg: "#181825",
          nodeBorder: "#89b4fa",
          clusterBkg: "#181825",
          clusterBorder: "#45475a",
          fontFamily: '"Space Grotesk", sans-serif',
          fontSize: "13px"
        }
      };
    }

    function decodeEntities(encodedString) {
      const textarea = document.createElement("textarea");
      textarea.innerHTML = encodedString;
      return textarea.value;
    }

    async function renderDiagrams() {
      mermaid.initialize(getMermaidConfig());

      const containers = document.querySelectorAll(".mermaid-container");
      for (let idx = 0; idx < containers.length; idx++) {
        const container = containers[idx];
        let code = "";
        const encoded = container.getAttribute("data-mermaid-code");
        if (encoded) {
          try {
            code = decodeURIComponent(encoded);
          } catch (e) {
            code = encoded;
          }
        }
        if (!code) {
          const pre = container.querySelector("pre.mermaid");
          code = pre ? pre.textContent.trim() : "";
        }
        if (!code) continue;

        code = decodeEntities(code);

        try {
          const uniqueId = "mermaid-svg-" + idx + "-" + Math.random().toString(36).substring(2, 8);
          const { svg } = await mermaid.render(uniqueId, code);
          container.innerHTML = svg;
        } catch (err) {
          console.warn("Mermaid render error for diagram " + idx + ":", err);
          if (!container.querySelector("pre")) {
            container.innerHTML = `<pre class="mermaid font-mono text-xs text-red-400 overflow-x-auto">${code.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</pre>`;
          }
        }
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderDiagrams);
    } else {
      renderDiagrams();
    }
  </script>
{% endif %}

<!-- Conditionally Load & Initialize Littlefoot Footnote Popovers -->
{% if content and ('data-footnote-ref' in content or 'fnref' in content or 'footnote' in content) %}
  <script type="module">
    import littlefoot from "/assets/js/littlefoot.js";

    function initLittlefoot() {
      littlefoot({
        activateDelay: 100,
        dismissDelay: 100,
        hoverDelay: 250,
        allowMultiple: false,
        activateOnHover: false,
        dismissOnUnhover: false,
        anchorPattern: /#(user-content-)?fn[:\-_\d]/gi,
        buttonTemplate: '<button class="littlefoot__button" id="<% reference %>" aria-label="Footnote <% number %>" title="See Footnote <% number %>"><span class="littlefoot__number"><% number %></span></button>'
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLittlefoot);
    } else {
      initLittlefoot();
    }
  </script>
{% endif %}

