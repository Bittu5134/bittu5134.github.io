---
layout: layouts/base.njk
ogType: article
---
{% import "macros/icons.njk" as icons %}
{% set tocList = content | toc %}

<!-- Reading Progress Bar (Fixed Top) -->
<div
  id="reading-progress"
  class="fixed top-0 left-0 h-1.5 bg-[#fde047] z-[100] transition-all duration-75"
  style="width: 0%"
  aria-hidden="true"
></div>

<div class="min-h-screen bg-[#f6eedb] retro-dots-bg text-[#14161f] font-sans selection:bg-[#fde047] selection:text-black">
  {% include "components/retro-header.njk" %}

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <!-- Breadcrumb & Action Bar (Clean, uncluttered, focused) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8 pb-3 border-b border-black/10 dark:border-white/10 text-sm">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-neutral-500 dark:text-neutral-400 truncate">
        <a href="/" class="hover:underline font-medium text-neutral-900 dark:text-neutral-100">Home</a>
        <span class="text-neutral-400 dark:text-neutral-600">/</span>
        <a href="/blog" class="hover:underline font-medium text-neutral-900 dark:text-neutral-100">Blog</a>
        <span class="text-neutral-400 dark:text-neutral-600">/</span>
        <span class="font-semibold text-neutral-700 dark:text-neutral-300 truncate">{{ title }}</span>
      </nav>

      <div class="flex items-center gap-2 shrink-0">
        <!-- Dark / Light Mode Toggle -->
        <button
          id="theme-toggle-btn"
          class="btn-brutal-white px-3 py-1.5 text-xs sm:text-sm flex items-center gap-1.5 cursor-pointer select-none font-semibold"
          title="Toggle Light / Dark Theme"
          aria-label="Toggle light and dark theme"
        >
          <span class="theme-icon-light hidden items-center gap-1.5 text-amber-500 font-bold">
            {{ icons.sun("w-4 h-4") }}
            <span class="hidden sm:inline">LIGHT</span>
          </span>
          <span class="theme-icon-dark flex items-center gap-1.5 text-indigo-400 font-bold">
            {{ icons.moon("w-4 h-4") }}
            <span class="hidden sm:inline">DARK</span>
          </span>
        </button>

        <button
          id="share-article-btn"
          class="btn-brutal-white px-3 py-1.5 text-xs sm:text-sm hover:bg-[#86efac] font-semibold"
          data-title="{{ title }}"
          data-url="https://bittu.dev{{ page.url }}"
        >
          <span class="share-default flex items-center gap-1.5">
            {{ icons.share2("w-4 h-4") }}
            <span>SHARE</span>
          </span>
          <span class="share-copied hidden flex items-center gap-1.5 text-emerald-700 font-bold">
            {{ icons.check("w-4 h-4 text-emerald-700 stroke-[3]") }}
            <span>COPIED!</span>
          </span>
        </button>
      </div>
    </div>

    <!-- Main Grid: Content + Desktop Sticky TOC -->
    <div class="grid grid-cols-1 {{ 'xl:grid-cols-[1fr_260px] xl:gap-12' if tocList.length > 1 else '' }}">
      <!-- Left Column: Article Body Area -->
      <article id="article-top" class="min-w-0" data-pagefind-body>
        <!-- Content Paper: Crisp clean surface with subtle border -->
        <div class="post-article-surface bg-white dark:bg-[#161b22] rounded-xl border border-neutral-200 dark:border-[#30363d] shadow-sm p-6 sm:p-10 md:p-14">
          <!-- Cover Image Hero (if present) -->
          {% if coverImage %}
            <div class="mb-10 rounded-lg overflow-hidden border border-neutral-200 dark:border-[#30363d] shadow-sm bg-[#12151e]">
              <img
                src="{{ coverImage }}"
                alt="{{ coverAlt if coverAlt else title }}"
                class="w-full h-auto max-h-[480px] object-cover"
                loading="eager"
                data-pagefind-meta="image[src]"
              />
            </div>
          {% endif %}

          <!-- Article Header -->
          <header class="mb-10 pb-8 border-b border-neutral-200 dark:border-[#30363d]">
            <!-- Clean Editorial Byline (Date · Read Time) -->
            <div class="flex flex-wrap items-center gap-2.5 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 font-mono mb-4">
              <time datetime="{{ date | dateIso }}">{{ (displayDate or date) }}</time>
              <span>·</span>
              <span>{{ readTime or (content | readingTime) }}</span>
            </div>

            <!-- Title: Bold, readable, sans-serif -->
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-neutral-900 dark:text-neutral-100 leading-tight tracking-tight mb-6" data-pagefind-meta="title">
              {{ title }}
            </h1>

            <!-- Summary / Lead paragraph with clean retro accent card -->
            {% if summary %}
              <div class="text-base sm:text-lg text-amber-950 dark:text-amber-100 font-normal leading-relaxed mb-6 border-2 border-black dark:border-amber-400/40 bg-amber-100/70 dark:bg-amber-950/40 p-4 shadow-brutal-xs" data-pagefind-meta="summary">
                {{ summary }}
              </div>
            {% endif %}

            <!-- Tag Pills -->
            <div class="flex flex-wrap gap-2 pt-1">
              {% for tag in tags %}
                {% if tag != "posts" %}
                  <a
                    href="/blog?tag={{ tag | urlencode }}"
                    class="post-tag-pill px-3 py-1 bg-neutral-100 hover:bg-neutral-200 dark:bg-[#21262d] dark:hover:bg-[#30363d] text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-neutral-100 border border-neutral-200 dark:border-[#30363d] rounded-md font-mono text-xs sm:text-sm font-semibold uppercase tracking-wider transition-colors"
                    data-pagefind-filter="tag"
                  >
                    #{{ tag }}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </header>

          <!-- Mobile Collapsible Table of Contents (< xl breakpoint) -->
          {% if tocList.length > 1 %}
            <details class="xl:hidden mb-10 bg-neutral-50 dark:bg-[#21262d]/60 border border-neutral-200 dark:border-[#30363d] rounded-lg p-4 group">
              <summary class="cursor-pointer font-sans font-bold text-sm sm:text-base text-neutral-900 dark:text-neutral-100 flex items-center justify-between select-none">
                <span class="flex items-center gap-2.5">
                  {{ icons.fileText("w-4 h-4 text-amber-500") }}
                  <span>Table of Contents ({{ tocList.length }} sections)</span>
                </span>
                <span class="font-mono text-xs text-neutral-400 group-open:rotate-180 transition-transform duration-150">▼</span>
              </summary>
              <nav class="mt-3 pt-3 border-t border-neutral-200 dark:border-[#30363d] space-y-2 font-sans text-sm">
                {% for item in tocList %}
                  <a
                    href="#{{ item.id }}"
                    class="block py-1 text-neutral-700 dark:text-neutral-300 hover:text-amber-600 dark:hover:text-amber-400 hover:underline transition-colors {{ 'pl-4 text-xs text-neutral-500 dark:text-neutral-400' if item.level == 3 else 'font-medium' }}"
                  >
                    {{ item.title }}
                  </a>
                {% endfor %}
              </nav>
            </details>
          {% endif %}

          <!-- Markdown Content Body: Readability-First Typography -->
          <div class="prose-retro">
            {{ content | safe }}
          </div>

          <!-- Post Action Footer -->
          <div class="mt-14 pt-8 border-t border-neutral-200 dark:border-[#30363d] flex flex-wrap items-center justify-between gap-4 font-mono text-sm">
            <a
              href="/blog"
              class="post-back-btn inline-flex items-center gap-2 px-4 py-2.5 bg-neutral-100 hover:bg-neutral-200 dark:bg-[#21262d] dark:hover:bg-[#30363d] text-neutral-900 dark:text-neutral-100 border border-neutral-300 dark:border-[#30363d] rounded-lg font-bold transition-all"
            >
              {{ icons.arrowLeft("w-4 h-4") }}
              <span>← Back to all articles</span>
            </a>

            <div class="flex items-center gap-3">
              {% if slug %}
                <a
                  href="/raw/blogs/{{ slug }}.md"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2.5 bg-neutral-100 hover:bg-neutral-200 dark:bg-[#21262d] dark:hover:bg-[#30363d] text-neutral-700 dark:text-neutral-300 border border-neutral-300 dark:border-[#30363d] rounded-lg font-bold transition-all text-xs sm:text-sm"
                  title="View plain Markdown source file"
                >
                  {{ icons.code("w-4 h-4") }}
                  <span>Raw Markdown</span>
                </a>
              {% endif %}

              <button
                class="post-copy-link-btn inline-flex items-center gap-2 px-4 py-2.5 bg-[#fde047] hover:bg-[#fcd34d] text-black border-2 border-black rounded-lg font-bold shadow-brutal-xs transition-all cursor-pointer"
                data-url="https://bittu.dev{{ page.url }}"
              >
                {{ icons.copy("w-4 h-4") }}
                <span>Copy article link</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Next / Previous Article Navigation -->
        {% set prevPost = collections.blogs | getPreviousCollectionItem(page) %}
        {% set nextPost = collections.blogs | getNextCollectionItem(page) %}
        {% if prevPost or nextPost %}
          <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-sm">
            {% if prevPost %}
              <a
                href="{{ prevPost.url }}"
                class="bg-white dark:bg-[#161b22] border border-neutral-200 dark:border-[#30363d] rounded-xl p-5 shadow-sm hover:border-neutral-400 dark:hover:border-neutral-500 hover:shadow transition-all flex flex-col justify-between group"
              >
                <span class="text-neutral-500 dark:text-neutral-400 font-semibold mb-2 text-xs flex items-center gap-1">
                  ← PREVIOUS ARTICLE
                </span>
                <span class="font-sans font-bold text-base text-neutral-900 dark:text-neutral-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors line-clamp-2">
                  {{ prevPost.data.title }}
                </span>
              </a>
            {% else %}
              <div class="hidden sm:block"></div>
            {% endif %}

            {% if nextPost %}
              <a
                href="{{ nextPost.url }}"
                class="bg-white dark:bg-[#161b22] border border-neutral-200 dark:border-[#30363d] rounded-xl p-5 shadow-sm hover:border-neutral-400 dark:hover:border-neutral-500 hover:shadow transition-all flex flex-col justify-between text-right group"
              >
                <span class="text-neutral-500 dark:text-neutral-400 font-semibold mb-2 text-xs flex items-center justify-end gap-1">
                  NEXT ARTICLE →
                </span>
                <span class="font-sans font-bold text-base text-neutral-900 dark:text-neutral-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors line-clamp-2">
                  {{ nextPost.data.title }}
                </span>
              </a>
            {% endif %}
          </nav>
        {% endif %}

        <!-- Author Bio Card -->
        <div class="mt-8 bg-white dark:bg-[#161b22] border border-neutral-200 dark:border-[#30363d] rounded-xl p-6 sm:p-7 shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <img
            src="/images/avatar.webp"
            alt="Bittu avatar"
            class="w-16 h-16 rounded-full border-2 border-neutral-200 dark:border-[#30363d] object-cover shrink-0 shadow-sm"
          />
          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <span class="font-sans font-bold text-lg text-neutral-900 dark:text-neutral-100">Bittu (Bittu5134)</span>
            </div>
            <p class="font-sans text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
              Cybersecurity &amp; Computing undergraduate at IIT Kanpur. Building high-throughput WebRTC systems, reverse-engineering protocols, and writing open-source software.
            </p>
            <div class="flex items-center gap-4 pt-1 font-mono text-sm font-semibold">
              <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300">
                {{ icons.github("w-4 h-4") }}
                <span>GitHub</span>
              </a>
              <a href="/discord" target="_blank" rel="noopener noreferrer" class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300">
                {{ icons.discord("w-4 h-4") }}
                <span>Discord</span>
              </a>
              <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors flex items-center gap-1.5 text-amber-600 dark:text-amber-400">
                {{ icons.rss("w-4 h-4") }}
                <span>RSS Feed</span>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- Right Column: Desktop Sticky Table of Contents -->
      {% if tocList.length > 1 %}
        <aside class="hidden xl:block">
          <div class="sticky top-20 bg-white dark:bg-[#161b22] border border-neutral-200 dark:border-[#30363d] rounded-xl p-5 shadow-sm max-h-[calc(100vh-6rem)] overflow-y-auto">
            <div class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-900 dark:text-neutral-100 pb-2 mb-3 border-b border-neutral-200 dark:border-[#30363d] flex items-center justify-between">
              <span>ON THIS PAGE</span>
              <span class="px-2 py-0.5 bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 text-xs rounded-full font-bold">{{ tocList.length }}</span>
            </div>
            <nav class="space-y-1 font-mono text-sm" id="desktop-toc">
              {% for item in tocList %}
                <a
                  href="#{{ item.id }}"
                  class="toc-nav-link block py-1.5 px-2.5 rounded transition-all {{ 'pl-5 text-neutral-500 dark:text-neutral-400 font-normal text-xs sm:text-sm' if item.level == 3 else 'font-semibold text-neutral-800 dark:text-neutral-200' }}"
                  data-target="{{ item.id }}"
                >
                  {{ item.title }}
                </a>
              {% endfor %}
            </nav>
            <div class="mt-4 pt-3 border-t border-neutral-200 dark:border-[#30363d] text-xs font-mono text-neutral-500 dark:text-neutral-400">
              <a href="#article-top" class="hover:text-neutral-900 dark:hover:text-neutral-100 hover:underline flex items-center gap-1">
                <span>↑ Scroll to top</span>
              </a>
            </div>
          </div>
        </aside>
      {% endif %}
    </div>
  </main>
</div>

<!-- Footnotes Enhancement: Littlefoot (Interactive footnote popovers) -->
{% if 'data-footnotes' in content or 'class="footnotes"' in content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/littlefoot/dist/littlefoot.css" />
  <script src="https://cdn.jsdelivr.net/npm/littlefoot/dist/littlefoot.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      try {
        var lf = (window.littlefoot && (window.littlefoot.default || window.littlefoot.littlefoot || window.littlefoot));
        if (typeof lf === "function") {
          lf({
            activateOnHover: false,
            dismissOnUnhover: false,
            allowMultiple: false,
            anchorPattern: /#(?:user-content-)?(fn|footnote|note)[:\-_0-9]/gi,
            buttonTemplate: '<button aria-label="Footnote <% number %>" class="littlefoot__button" id="<% reference %>" title="See footnote <% number %>"><span class="littlefoot__button__ellipsis">[<% number %>]</span></button>'
          });
        }
      } catch (e) {
        console.warn("Littlefoot init warning:", e);
      }
    });
  </script>
{% endif %}

<!-- Conditionally Load Mermaid.js Only If The Page Uses Diagrams -->
{% if 'class="mermaid' in content %}
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

    function getMermaidConfig(isDark) {
      return {
        startOnLoad: false,
        securityLevel: "loose",
        theme: isDark ? "dark" : "base",
        themeVariables: isDark ? {
          primaryColor: "#21262d",
          primaryBorderColor: "#fde047",
          primaryTextColor: "#f0f6fc",
          lineColor: "#8b949e",
          secondaryColor: "#161b22",
          tertiaryColor: "#0d1117",
          background: "#161b22",
          mainBkg: "#161b22",
          nodeBorder: "#fde047",
          clusterBkg: "#0d1117",
          clusterBorder: "#30363d",
          fontFamily: '"Space Grotesk", sans-serif',
          fontSize: "13px"
        } : {
          primaryColor: "#fde047",
          primaryBorderColor: "#000000",
          primaryTextColor: "#000000",
          lineColor: "#000000",
          secondaryColor: "#86efac",
          tertiaryColor: "#f6eedb",
          background: "#fffdf9",
          mainBkg: "#fffdf9",
          nodeBorder: "#000000",
          clusterBkg: "#fafaf9",
          clusterBorder: "#d4d4d8",
          fontFamily: '"Space Grotesk", sans-serif',
          fontSize: "13px"
        }
      };
    }

    async function renderDiagrams() {
      const isDark = document.documentElement.getAttribute("data-theme") === "dark" ||
                     document.documentElement.classList.contains("dark");
      mermaid.initialize(getMermaidConfig(isDark));

      const containers = document.querySelectorAll(".mermaid-container");
      for (let idx = 0; idx < containers.length; idx++) {
        const container = containers[idx];
        let code = "";
        const encoded = container.getAttribute("data-mermaid-code");
        if (encoded) {
          try {
            code = decodeURIComponent(encoded);
          } catch (e) {
            code = encoded;
          }
        }
        if (!code) {
          const pre = container.querySelector("pre.mermaid");
          code = pre ? pre.textContent.trim() : "";
        }
        if (!code) continue;

        try {
          const uniqueId = "mermaid-svg-" + idx + "-" + Math.random().toString(36).substring(2, 8);
          const { svg } = await mermaid.render(uniqueId, code);
          container.innerHTML = svg;
        } catch (err) {
          console.warn("Mermaid render error for diagram " + idx + ":", err);
          if (!container.querySelector("pre")) {
            container.innerHTML = `<pre class="mermaid font-mono text-xs text-red-500 overflow-x-auto">${code.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</pre>`;
          }
        }
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderDiagrams);
    } else {
      renderDiagrams();
    }

    window.addEventListener("theme-change", () => {
      renderDiagrams();
    });
  </script>
{% endif %}

