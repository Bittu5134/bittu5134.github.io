---
layout: layouts/base.njk
ogType: article
---
{% import "macros/icons.njk" as icons %}
{% set tocList = content | toc %}

<!-- Reading Progress Bar (Fixed Top) -->
<div
  id="reading-progress"
  class="fixed top-0 left-0 h-1 bg-[#fde047] z-[100] transition-all duration-75"
  style="width: 0%"
  aria-hidden="true"
></div>

<div class="min-h-screen bg-[#0b0f17] retro-dots-dark text-slate-200 font-sans selection:bg-[#fde047] selection:text-black">
  <!-- Minimal Slate Post Header Navigation -->
  <header class="sticky top-0 z-40 bg-[#0b0f17]/90 backdrop-blur-md border-b border-slate-800/80 px-4 sm:px-6 py-3">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-3 text-sm font-mono">
      <!-- Back Navigation & Breadcrumb -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 truncate">
        <a
          href="/"
          class="text-slate-400 hover:text-white transition-colors font-bold shrink-0"
        >
          BITTU.DEV
        </a>
        <span class="text-slate-600">/</span>
        <a
          href="/blog"
          class="text-slate-400 hover:text-white transition-colors font-bold shrink-0"
        >
          blog
        </a>
        <span class="text-slate-600 hidden sm:inline">/</span>
        <span class="text-slate-300 truncate max-w-[160px] sm:max-w-[240px] md:max-w-[360px]" aria-current="page">{{ title }}</span>
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2 shrink-0">
        {% if slug %}
          <a
            href="/raw/blogs/{{ slug }}.md"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 bg-slate-800/90 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700/80 rounded font-mono text-xs font-semibold transition-colors flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-[#fde047] focus-visible:outline-none"
            title="View plain Markdown source"
          >
            {{ icons.code("w-3.5 h-3.5 text-slate-400") }}
            <span class="hidden md:inline">Raw MD</span>
          </a>
        {% endif %}

        <button
          id="share-article-btn"
          class="px-2.5 py-1 bg-slate-800/90 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700/80 rounded font-mono text-xs font-semibold transition-colors flex items-center gap-1.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-[#fde047] focus-visible:outline-none"
          data-title="{{ title }}"
          data-url="https://bittu.dev{{ page.url }}"
          title="Share article"
        >
          <span class="share-default flex items-center gap-1.5">
            {{ icons.share2("w-3.5 h-3.5 text-slate-400") }}
            <span>Share</span>
          </span>
          <span class="share-copied hidden flex items-center gap-1.5 text-emerald-400 font-bold">
            {{ icons.check("w-3.5 h-3.5 text-emerald-400 stroke-[3]") }}
            <span>Copied!</span>
          </span>
        </button>

        <button
          class="post-copy-link-btn px-2.5 py-1 bg-[#fde047] hover:bg-[#fcd34d] text-black border border-amber-300 rounded font-mono text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-[#fde047] focus-visible:outline-none"
          data-url="https://bittu.dev{{ page.url }}"
          title="Copy direct link"
        >
          {{ icons.copy("w-3.5 h-3.5 text-black") }}
          <span>Copy Link</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Centered Reading Column -->
  <main class="max-w-3xl mx-auto px-4 sm:px-6 md:px-8 py-8 sm:py-12 md:py-16">
    <article id="article-top" class="min-w-0" data-pagefind-body>
      <!-- Cover Image Hero (if present) -->
      {% if coverImage %}
        <div class="mb-10 rounded-xl overflow-hidden border border-slate-800 bg-[#131923] shadow-lg">
          <img
            src="{{ coverImage }}"
            alt="{{ coverAlt if coverAlt else title }}"
            class="w-full h-auto max-h-[460px] object-cover"
            loading="lazy"
            decoding="async"
            data-pagefind-meta="image[src]"
          />
        </div>
      {% endif %}

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-slate-800/90">
        <!-- Date & Read Time Meta -->
        <div class="flex flex-wrap items-center gap-2.5 text-xs sm:text-sm text-slate-400 font-mono mb-4">
          <time datetime="{{ date | dateIso }}">{{ (displayDate or date) }}</time>
          <span class="text-slate-600">·</span>
          <span>{{ readTime or (content | readingTime) }}</span>
        </div>

        <!-- Article Title: Crisp, bold, readability-centered -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white leading-[1.18] tracking-tight mb-6" data-pagefind-meta="title">
          {{ title }}
        </h1>

        <!-- Summary / Lead paragraph -->
        {% if summary %}
          <div class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed mb-6 p-4 sm:p-5 rounded-xl bg-[#131923]/80 border border-slate-800/80" data-pagefind-meta="summary">
            {{ summary }}
          </div>
        {% endif %}

        <!-- Tag Pills -->
        <div class="flex flex-wrap gap-2 pt-1">
          {% for tag in tags %}
            {% if tag != "posts" %}
              <a
                href="/blog?tag={{ tag | urlencode }}"
                class="post-tag-pill px-2.5 py-1 bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700/80 rounded font-mono text-xs font-semibold uppercase tracking-wider transition-colors focus-visible:ring-2 focus-visible:ring-[#fde047] focus-visible:outline-none"
                data-pagefind-filter="tag"
              >
                #{{ tag }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </header>

      <!-- Table of Contents (<details> collapsible for frictionless navigation) -->
      {% if tocList.length > 1 %}
        <details class="mb-10 bg-[#131923] border border-slate-800 rounded-xl p-4 sm:p-5 group">
          <summary class="cursor-pointer font-sans font-bold text-sm sm:text-base text-slate-100 flex items-center justify-between select-none p-1 rounded-lg focus-visible:ring-2 focus-visible:ring-[#fde047] focus-visible:outline-none">
            <span class="flex items-center gap-2.5">
              {{ icons.fileText("w-4 h-4 text-[#fde047]") }}
              <span>Table of Contents</span>
              <span class="px-2 py-0.5 bg-slate-800 text-slate-300 text-xs font-mono rounded font-semibold">{{ tocList.length }} sections</span>
            </span>
            <span class="font-mono text-xs text-slate-500 group-open:rotate-180 transition-transform duration-150">▼</span>
          </summary>
          <nav class="mt-4 pt-3.5 border-t border-slate-800/80 space-y-1.5 font-mono text-xs sm:text-sm">
            {% for item in tocList %}
              <a
                href="#{{ item.id }}"
                class="block py-1 text-slate-400 hover:text-[#fde047] hover:underline transition-colors {{ 'pl-4 text-xs text-slate-500' if item.level == 3 else 'font-medium text-slate-300' }}"
              >
                {{ item.title }}
              </a>
            {% endfor %}
          </nav>
        </details>
      {% endif %}

      <!-- Markdown Content Body: Readability-First Slate Typography -->
      <div class="prose-retro">
        {{ content | safe }}
      </div>

      <!-- Post Action Footer -->
      <div class="mt-14 pt-8 border-t border-slate-800/90 flex flex-wrap items-center justify-between gap-4 font-mono text-sm">
        <a
          href="/blog"
          class="post-back-btn inline-flex items-center gap-2 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 rounded-lg font-bold transition-all text-xs sm:text-sm"
        >
          {{ icons.arrowLeft("w-4 h-4 text-slate-400") }}
          <span>← Back to all articles</span>
        </a>

        <div class="flex items-center gap-2.5">
          {% if slug %}
            <a
              href="/raw/blogs/{{ slug }}.md"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-2 bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700/80 rounded-lg font-bold transition-all text-xs"
              title="View plain Markdown source file"
            >
              {{ icons.code("w-4 h-4 text-slate-400") }}
              <span>Raw MD</span>
            </a>
          {% endif %}

          <button
            class="post-copy-link-btn inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#fde047] hover:bg-[#fcd34d] text-black border border-amber-300 rounded-lg font-bold text-xs transition-all cursor-pointer"
            data-url="https://bittu.dev{{ page.url }}"
          >
            {{ icons.copy("w-4 h-4 text-black") }}
            <span>Copy link</span>
          </button>
        </div>
      </div>

      <!-- Next / Previous Article Navigation -->
      {% set prevPost = collections.blogs | getPreviousCollectionItem(page) %}
      {% set nextPost = collections.blogs | getNextCollectionItem(page) %}
      {% if prevPost or nextPost %}
        <nav class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs sm:text-sm">
          {% if prevPost %}
            <a
              href="{{ prevPost.url }}"
              class="bg-[#131923] border border-slate-800 hover:border-slate-600 rounded-xl p-5 transition-all flex flex-col justify-between group"
            >
              <span class="text-slate-500 font-semibold mb-2 text-xs flex items-center gap-1">
                ← PREVIOUS ARTICLE
              </span>
              <span class="font-sans font-bold text-sm sm:text-base text-slate-200 group-hover:text-[#fde047] transition-colors line-clamp-2">
                {{ prevPost.data.title }}
              </span>
            </a>
          {% else %}
            <div class="hidden sm:block"></div>
          {% endif %}

          {% if nextPost %}
            <a
              href="{{ nextPost.url }}"
              class="bg-[#131923] border border-slate-800 hover:border-slate-600 rounded-xl p-5 transition-all flex flex-col justify-between text-right group"
            >
              <span class="text-slate-500 font-semibold mb-2 text-xs flex items-center justify-end gap-1">
                NEXT ARTICLE →
              </span>
              <span class="font-sans font-bold text-sm sm:text-base text-slate-200 group-hover:text-[#fde047] transition-colors line-clamp-2">
                {{ nextPost.data.title }}
              </span>
            </a>
          {% endif %}
        </nav>
      {% endif %}

      <!-- Author Bio Card -->
      <div class="mt-10 bg-[#131923] border border-slate-800 rounded-xl p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center gap-5">
        <img
          src="/images/avatar.webp"
          alt="Bittu avatar"
          class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-2 border-slate-700 object-cover shrink-0 shadow-sm"
        />
        <div class="space-y-2">
          <div class="flex items-center gap-2.5">
            <span class="font-sans font-bold text-base sm:text-lg text-white">Bittu (Bittu5134)</span>
          </div>
          <p class="font-sans text-xs sm:text-sm text-slate-300 leading-relaxed">
            Cybersecurity &amp; Computing undergraduate at IIT Kanpur. Building high-throughput WebRTC systems, reverse-engineering protocols, and writing open-source software.
          </p>
          <div class="flex items-center gap-4 pt-1 font-mono text-xs sm:text-sm font-semibold">
            <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="hover:text-[#fde047] transition-colors flex items-center gap-1.5 text-slate-400">
              {{ icons.github("w-4 h-4") }}
              <span>GitHub</span>
            </a>
            <a href="/discord" target="_blank" rel="noopener noreferrer" class="hover:text-[#fde047] transition-colors flex items-center gap-1.5 text-slate-400">
              {{ icons.discord("w-4 h-4") }}
              <span>Discord</span>
            </a>
            <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="hover:text-[#fde047] transition-colors flex items-center gap-1.5 text-amber-400">
              {{ icons.rss("w-4 h-4") }}
              <span>RSS Feed</span>
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>
</div>

<!-- Conditionally Load Mermaid.js Only If The Page Uses Diagrams -->
{% if 'class="mermaid' in content %}
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

    function getMermaidConfig() {
      return {
        startOnLoad: false,
        securityLevel: "loose",
        theme: "dark",
        themeVariables: {
          primaryColor: "#1e293b",
          primaryBorderColor: "#fde047",
          primaryTextColor: "#f8fafc",
          lineColor: "#94a3b8",
          secondaryColor: "#131923",
          tertiaryColor: "#0b0f17",
          background: "#131923",
          mainBkg: "#131923",
          nodeBorder: "#fde047",
          clusterBkg: "#0b0f17",
          clusterBorder: "#334155",
          fontFamily: '"Space Grotesk", sans-serif',
          fontSize: "13px"
        }
      };
    }

    function decodeEntities(encodedString) {
      const textarea = document.createElement("textarea");
      textarea.innerHTML = encodedString;
      return textarea.value;
    }

    async function renderDiagrams() {
      mermaid.initialize(getMermaidConfig());

      const containers = document.querySelectorAll(".mermaid-container");
      for (let idx = 0; idx < containers.length; idx++) {
        const container = containers[idx];
        let code = "";
        const encoded = container.getAttribute("data-mermaid-code");
        if (encoded) {
          try {
            code = decodeURIComponent(encoded);
          } catch (e) {
            code = encoded;
          }
        }
        if (!code) {
          const pre = container.querySelector("pre.mermaid");
          code = pre ? pre.textContent.trim() : "";
        }
        if (!code) continue;

        code = decodeEntities(code);

        try {
          const uniqueId = "mermaid-svg-" + idx + "-" + Math.random().toString(36).substring(2, 8);
          const { svg } = await mermaid.render(uniqueId, code);
          container.innerHTML = svg;
        } catch (err) {
          console.warn("Mermaid render error for diagram " + idx + ":", err);
          if (!container.querySelector("pre")) {
            container.innerHTML = `<pre class="mermaid font-mono text-xs text-red-400 overflow-x-auto">${code.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</pre>`;
          }
        }
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderDiagrams);
    } else {
      renderDiagrams();
    }
  </script>
{% endif %}

<!-- Conditionally Load & Initialize Littlefoot Footnote Popovers -->
{% if content and ('data-footnote-ref' in content or 'fn-' in content or 'footnote' in content) %}
  <script type="module">
    import littlefoot from "/assets/js/littlefoot.js";
    
    function initLittlefoot() {
      littlefoot({
        activateDelay: 100,
        dismissDelay: 100,
        hoverDelay: 250,
        allowMultiple: false,
        activateOnHover: false,
        dismissOnUnhover: false,
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLittlefoot);
    } else {
      initLittlefoot();
    }
  </script>
{% endif %}
