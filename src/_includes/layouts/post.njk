---
layout: layouts/base.njk
ogType: article
---
{% import "macros/icons.njk" as icons %}
{% set tocList = content | toc %}

<!-- Reading Progress Bar (Fixed Top) -->
<div
  id="reading-progress"
  class="fixed top-0 left-0 h-1 bg-[#fde047] border-b border-black z-[100] transition-all duration-75"
  style="width: 0%"
  aria-hidden="true"
></div>

<div class="min-h-screen bg-[#f6eedb] retro-dots-bg text-[#14161f] font-sans selection:bg-[#fde047] selection:text-black">
  {% include "components/retro-header.njk" %}

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <!-- Breadcrumb & Top Action Bar (Neo-brutalist site shell chrome) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8 pb-3 border-b-2 border-black/15 font-mono text-xs sm:text-sm">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-black/60 truncate">
        <a href="/" class="hover:text-black hover:underline font-bold text-black">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-black hover:underline font-bold text-black">Blog</a>
        <span>/</span>
        <span class="text-black/80 font-bold truncate">{{ title }}</span>
      </nav>

      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/blog"
          class="btn-brutal-white px-2.5 py-1 text-xs"
        >
          {{ icons.arrowLeft("w-3.5 h-3.5") }}
          <span>ALL ARTICLES</span>
        </a>

        <!-- Dark / Light Mode Toggle -->
        <button
          id="theme-toggle-btn"
          class="btn-brutal-white px-2.5 py-1 text-xs flex items-center gap-1.5 cursor-pointer select-none"
          title="Toggle Light / Dark Theme"
          aria-label="Toggle light and dark theme"
        >
          <span class="theme-icon-light hidden items-center gap-1 text-amber-500 font-bold">
            {{ icons.sun("w-3.5 h-3.5") }}
            <span class="hidden sm:inline">LIGHT</span>
          </span>
          <span class="theme-icon-dark flex items-center gap-1 text-indigo-400 font-bold">
            {{ icons.moon("w-3.5 h-3.5") }}
            <span class="hidden sm:inline">DARK</span>
          </span>
        </button>

        <button
          id="share-article-btn"
          class="btn-brutal-white px-2.5 py-1 text-xs hover:bg-[#86efac]"
          data-title="{{ title }}"
          data-url="https://bittu.dev{{ page.url }}"
        >
          <span class="share-default flex items-center gap-1.5">
            {{ icons.share2("w-3.5 h-3.5") }}
            <span>SHARE</span>
          </span>
          <span class="share-copied hidden flex items-center gap-1.5 text-emerald-800 font-bold">
            {{ icons.check("w-3.5 h-3.5 text-emerald-800 stroke-[3]") }}
            <span>COPIED!</span>
          </span>
        </button>

        {% if slug %}
          <a
            href="/raw/blogs/{{ slug }}.md"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-brutal bg-[#fde047] px-2.5 py-1 text-xs"
            title="View plain Markdown source file"
          >
            {{ icons.code("w-3.5 h-3.5") }}
            <span>RAW MD</span>
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Main Grid: Content + Desktop Sticky TOC -->
    <div class="grid grid-cols-1 {{ 'xl:grid-cols-[1fr_260px] xl:gap-12' if tocList.length > 1 else '' }}">
      <!-- Left Column: Article Body Area -->
      <article id="article-top" class="min-w-0" data-pagefind-body>
        <!-- Content Paper: subtle warm off-white surface without heavy outer card box -->
        <div class="bg-[#fffdf9] rounded-xl border border-black/10 shadow-sm p-6 sm:p-8 md:p-12">
          <!-- Cover Image Hero (if present) -->
          {% if coverImage %}
            <div class="mb-10 rounded-lg overflow-hidden border border-black/10 shadow-sm bg-[#12151e]">
              <img
                src="{{ coverImage }}"
                alt="{{ coverAlt if coverAlt else title }}"
                class="w-full h-auto max-h-[480px] object-cover"
                loading="eager"
                data-pagefind-meta="image[src]"
              />
            </div>
          {% endif %}

          <!-- Article Header -->
          <header class="mb-10 pb-8 border-b border-black/10">
            <!-- Metadata Badges (mono UI chrome) -->
            <div class="flex flex-wrap items-center gap-2 mb-4 font-mono text-xs font-bold">
              <span class="px-2.5 py-1 bg-[#86efac] border border-black/20 rounded text-black" data-pagefind-meta="date">
                STAMP: {{ (displayDate or date) | upper }}
              </span>
              <span class="px-2.5 py-1 bg-[#fde047] border border-black/20 rounded text-black">
                {{ readTime | upper }}
              </span>
              {% if slug %}
                <span class="px-2.5 py-1 bg-black/5 text-black/60 rounded hidden sm:inline-block">
                  SLUG: {{ slug }}
                </span>
              {% endif %}
            </div>

            <!-- Title: Bold, readable, sans-serif -->
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#14161f] leading-tight tracking-tight mb-5" data-pagefind-meta="title">
              {{ title }}
            </h1>

            <!-- Summary / Subtitle -->
            {% if summary %}
              <p class="text-base sm:text-lg text-black/80 font-normal leading-relaxed mb-6 border-l-4 border-[#f59e0b] pl-4 py-1 bg-[#f6eedb]/40 rounded-r" data-pagefind-meta="summary">
                {{ summary }}
              </p>
            {% endif %}

            <!-- Tag Pills (mono UI chrome) -->
            <div class="flex flex-wrap gap-2 pt-1">
              {% for tag in tags %}
                {% if tag != "posts" %}
                  <a
                    href="/blog?tag={{ tag | urlencode }}"
                    class="px-2.5 py-0.5 bg-[#f6eedb] hover:bg-[#fde047] text-black border border-black/20 rounded font-mono text-xs font-semibold tracking-wide uppercase transition-colors"
                    data-pagefind-filter="tag"
                  >
                    #{{ tag | upper }}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </header>

          <!-- Mobile Collapsible Table of Contents (< xl breakpoint) -->
          {% if tocList.length > 1 %}
            <details class="xl:hidden mb-10 bg-[#fafaf9] border border-black/10 rounded-lg p-4 group">
              <summary class="cursor-pointer font-sans font-bold text-sm sm:text-base text-black flex items-center justify-between select-none">
                <span class="flex items-center gap-2.5">
                  {{ icons.fileText("w-4 h-4 text-[#f59e0b]") }}
                  <span>Table of Contents ({{ tocList.length }} sections)</span>
                </span>
                <span class="font-mono text-xs text-black/50 group-open:rotate-180 transition-transform duration-150">▼</span>
              </summary>
              <nav class="mt-3 pt-3 border-t border-black/10 space-y-2 font-sans text-sm">
                {% for item in tocList %}
                  <a
                    href="#{{ item.id }}"
                    class="block py-0.5 text-black/75 hover:text-[#d97706] hover:underline transition-colors {{ 'pl-4 text-xs text-black/60' if item.level == 3 else 'font-medium text-black' }}"
                  >
                    {{ item.title }}
                  </a>
                {% endfor %}
              </nav>
            </details>
          {% endif %}

          <!-- Markdown Content Body: Readability-First Typography -->
          <div class="prose-retro">
            {{ content | safe }}
          </div>

          <!-- Post Action Footer -->
          <div class="mt-14 pt-6 border-t border-black/10 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
            <a
              href="/blog"
              class="post-back-btn inline-flex items-center gap-2 px-3.5 py-2 bg-white hover:bg-black/5 text-black border border-black/15 rounded-lg shadow-sm font-bold transition-all"
            >
              {{ icons.arrowLeft("w-4 h-4") }}
              <span>BACK TO ARTICLES</span>
            </a>

            <button
              class="post-copy-link-btn inline-flex items-center gap-2 px-3.5 py-2 bg-[#fde047] hover:bg-[#fcd34d] text-black border border-black/20 rounded-lg shadow-sm font-bold transition-all cursor-pointer"
              data-url="https://bittu.dev{{ page.url }}"
            >
              {{ icons.copy("w-3.5 h-3.5") }}
              <span>COPY ARTICLE LINK</span>
            </button>
          </div>
        </div>

        <!-- Next / Previous Article Navigation -->
        {% set prevPost = collections.blogs | getPreviousCollectionItem(page) %}
        {% set nextPost = collections.blogs | getNextCollectionItem(page) %}
        {% if prevPost or nextPost %}
          <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs">
            {% if prevPost %}
              <a
                href="{{ prevPost.url }}"
                class="bg-[#fffdf9] border border-black/10 rounded-xl p-5 shadow-sm hover:border-black/25 hover:shadow transition-all flex flex-col justify-between group"
              >
                <span class="text-black/50 font-bold mb-1.5 flex items-center gap-1">
                  ← PREVIOUS DISPATCH
                </span>
                <span class="font-sans font-bold text-sm sm:text-base text-black group-hover:text-[#d97706] transition-colors line-clamp-2">
                  {{ prevPost.data.title }}
                </span>
              </a>
            {% else %}
              <div class="hidden sm:block"></div>
            {% endif %}

            {% if nextPost %}
              <a
                href="{{ nextPost.url }}"
                class="bg-[#fffdf9] border border-black/10 rounded-xl p-5 shadow-sm hover:border-black/25 hover:shadow transition-all flex flex-col justify-between text-right group"
              >
                <span class="text-black/50 font-bold mb-1.5 flex items-center justify-end gap-1">
                  NEXT DISPATCH →
                </span>
                <span class="font-sans font-bold text-sm sm:text-base text-black group-hover:text-[#d97706] transition-colors line-clamp-2">
                  {{ nextPost.data.title }}
                </span>
              </a>
            {% endif %}
          </nav>
        {% endif %}

        <!-- Author Bio Card -->
        <div class="mt-8 bg-[#fffdf9] border border-black/10 rounded-xl p-6 shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <img
            src="/images/avatar.webp"
            alt="Bittu avatar"
            class="w-16 h-16 rounded-full border border-black/15 object-cover shrink-0 shadow-sm"
          />
          <div class="space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="font-sans font-bold text-base text-black">Bittu (Bittu5134)</span>
              <span class="px-2 py-0.5 bg-[#86efac] border border-black/15 rounded font-mono text-[10px] font-bold text-black">AUTHOR</span>
            </div>
            <p class="font-sans text-xs sm:text-sm text-black/75 leading-relaxed">
              Cybersecurity &amp; Computing undergraduate at IIT Kanpur. Building high-throughput WebRTC systems, reverse-engineering protocols, and writing open-source software.
            </p>
            <div class="flex items-center gap-3.5 pt-1 font-mono text-xs font-semibold">
              <a href="https://github.com/Bittu5134" target="_blank" rel="noopener noreferrer" class="hover:text-[#d97706] transition-colors flex items-center gap-1">
                {{ icons.github("w-3.5 h-3.5") }}
                <span>GitHub</span>
              </a>
              <a href="/discord" target="_blank" rel="noopener noreferrer" class="hover:text-[#d97706] transition-colors flex items-center gap-1">
                {{ icons.discord("w-3.5 h-3.5") }}
                <span>Discord</span>
              </a>
              <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="hover:text-[#d97706] transition-colors flex items-center gap-1 text-[#d97706]">
                {{ icons.rss("w-3.5 h-3.5") }}
                <span>RSS Feed</span>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- Right Column: Desktop Sticky Table of Contents -->
      {% if tocList.length > 1 %}
        <aside class="hidden xl:block">
          <div class="sticky top-20 bg-[#fffdf9] border border-black/10 rounded-xl p-5 shadow-sm max-h-[calc(100vh-6rem)] overflow-y-auto">
            <div class="text-xs font-mono font-bold uppercase tracking-wider text-black pb-2 mb-3 border-b border-black/10 flex items-center justify-between">
              <span>ON THIS PAGE</span>
              <span class="px-1.5 py-0.2 bg-[#fde047] text-[10px] border border-black/20 rounded font-bold">{{ tocList.length }}</span>
            </div>
            <nav class="space-y-1 font-mono text-xs" id="desktop-toc">
              {% for item in tocList %}
                <a
                  href="#{{ item.id }}"
                  class="toc-nav-link block py-1.5 px-2.5 rounded transition-all {{ 'pl-5 text-black/60 font-normal' if item.level == 3 else 'font-bold text-black/85' }}"
                  data-target="{{ item.id }}"
                >
                  {{ item.title }}
                </a>
              {% endfor %}
            </nav>
            <div class="mt-4 pt-3 border-t border-black/10 text-[11px] font-mono text-black/50">
              <a href="#article-top" class="hover:text-black hover:underline flex items-center gap-1">
                <span>↑ Scroll to top</span>
              </a>
            </div>
          </div>
        </aside>
      {% endif %}
    </div>
  </main>
</div>

<!-- Footnotes Enhancement: Littlefoot (Interactive footnote popovers) -->
{% if 'data-footnotes' in content or 'class="footnotes"' in content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/littlefoot/dist/littlefoot.css" />
  <script src="https://cdn.jsdelivr.net/npm/littlefoot/dist/littlefoot.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      try {
        var lf = (window.littlefoot && (window.littlefoot.default || window.littlefoot.littlefoot || window.littlefoot));
        if (typeof lf === "function") {
          lf({
            activateOnHover: false,
            dismissOnUnhover: false,
            allowMultiple: false,
            anchorPattern: /#(?:user-content-)?(fn|footnote|note)[:\-_0-9]/gi,
            buttonTemplate: '<button aria-label="Footnote <% number %>" class="littlefoot__button" id="<% reference %>" title="See footnote <% number %>"><span class="littlefoot__button__ellipsis">[<% number %>]</span></button>'
          });
        }
      } catch (e) {
        console.warn("Littlefoot init warning:", e);
      }
    });
  </script>
{% endif %}

<!-- Conditionally Load Mermaid.js Only If The Page Uses Diagrams -->
{% if 'class="mermaid' in content %}
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

    function getMermaidConfig(isDark) {
      return {
        startOnLoad: false,
        securityLevel: "loose",
        theme: isDark ? "dark" : "base",
        themeVariables: isDark ? {
          primaryColor: "#21262d",
          primaryBorderColor: "#fde047",
          primaryTextColor: "#f0f6fc",
          lineColor: "#8b949e",
          secondaryColor: "#161b22",
          tertiaryColor: "#0d1117",
          background: "#161b22",
          mainBkg: "#161b22",
          nodeBorder: "#fde047",
          clusterBkg: "#0d1117",
          clusterBorder: "#30363d",
          fontFamily: '"Space Grotesk", sans-serif',
          fontSize: "13px"
        } : {
          primaryColor: "#fde047",
          primaryBorderColor: "#000000",
          primaryTextColor: "#000000",
          lineColor: "#000000",
          secondaryColor: "#86efac",
          tertiaryColor: "#f6eedb",
          background: "#fffdf9",
          mainBkg: "#fffdf9",
          nodeBorder: "#000000",
          clusterBkg: "#fafaf9",
          clusterBorder: "#d4d4d8",
          fontFamily: '"Space Grotesk", sans-serif',
          fontSize: "13px"
        }
      };
    }

    async function renderDiagrams() {
      const isDark = document.documentElement.getAttribute("data-theme") === "dark" ||
                     document.documentElement.classList.contains("dark");
      mermaid.initialize(getMermaidConfig(isDark));

      const containers = document.querySelectorAll(".mermaid-container");
      for (let idx = 0; idx < containers.length; idx++) {
        const container = containers[idx];
        let code = "";
        const encoded = container.getAttribute("data-mermaid-code");
        if (encoded) {
          try {
            code = decodeURIComponent(encoded);
          } catch (e) {
            code = encoded;
          }
        }
        if (!code) {
          const pre = container.querySelector("pre.mermaid");
          code = pre ? pre.textContent.trim() : "";
        }
        if (!code) continue;

        try {
          const uniqueId = "mermaid-svg-" + idx + "-" + Math.random().toString(36).substring(2, 8);
          const { svg } = await mermaid.render(uniqueId, code);
          container.innerHTML = svg;
        } catch (err) {
          console.warn("Mermaid render error for diagram " + idx + ":", err);
          if (!container.querySelector("pre")) {
            container.innerHTML = `<pre class="mermaid font-mono text-xs text-red-500 overflow-x-auto">${code.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</pre>`;
          }
        }
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderDiagrams);
    } else {
      renderDiagrams();
    }

    window.addEventListener("theme-change", () => {
      renderDiagrams();
    });
  </script>
{% endif %}

