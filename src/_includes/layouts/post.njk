---
layout: layouts/base.njk
ogType: article
isBlogPage: true
---
<!--
THESIS: The article view of the rewritten retro site. Same design system as the
homepage and /blog archive: flat #f3e7cc canvas, Playpen Sans display headings,
Space Mono metadata with rotating chip colors (#86efac / #c4b5fd / #38bdf8),
solid black tag chips, yellow (#fde047) action pills, orange (#fb923c) RSS,
amber (#b45309) dek accent — full-width text, no card, no border box.
-->

{% import "macros/icons.njk" as icons %}
{% set tocList = content | toc %}

<!-- Top Reading Progress Indicator -->
<div
  id="reading-progress"
  class="fixed top-0 left-0 h-[3px] bg-[#fde047] z-50 transition-all duration-75"
  style="width: 0%"
  aria-hidden="true"
></div>

<div class="min-h-screen bg-[#f3e7cc] text-[#14161f] font-body selection:bg-[#fde047] selection:text-black flex flex-col justify-between">
  <!-- Consistent Site Header -->
  {% include "components/retro-header.njk" %}

  <!-- Main Content Area: same width as homepage + /blog archive -->
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14 w-full flex-1">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="site-breadcrumb mb-8 flex items-center justify-between gap-2 text-xs sm:text-sm font-mono font-bold">
      <div class="flex items-center gap-1.5 sm:gap-2 truncate text-black/60">
        <a href="/" class="hover:underline text-black shrink-0">~</a>
        <span class="text-black/40">/</span>
        <a href="/blog" class="hover:underline text-black shrink-0">blogs</a>
        <span class="text-black/40">/</span>
        <span class="truncate text-black">{{ slug or (title | truncate(32)) }}</span>
      </div>

      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#fb923c] border-2 border-black text-xs font-bold text-black hover:bg-[#f97316] transition-colors"
        title="Subscribe via RSS"
      >
        {{ icons.rss("w-3.5 h-3.5 text-black") }}
        <span>RSS</span>
      </a>
    </nav>

    <!-- Article: text directly on the canvas -->
    <article
      id="article-top"
      class="w-full"
      data-pagefind-body
    >
      <!-- Print-Only Editorial Masthead (hidden on screen) -->
      <div class="print-masthead hidden print:block" aria-hidden="true">
        <div class="print-masthead-row">
          <span>{{ site.name | upper }}</span>
          <span>{{ (displayDate or date) | dateDisplay | upper }}</span>
        </div>
      </div>

      <!-- Cover Image (full-width, flat brutalist frame) -->
      {% if coverImage %}
        <img
          src="{{ coverImage }}"
          alt="{{ coverAlt if coverAlt else title }}"
          class="w-full h-auto border-2 border-black mb-10"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-pagefind-meta="image[src]"
        />
      {% endif %}

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b-2 border-black">
        <!-- Metadata Row: colored date chip + mono separators -->
        <p class="font-mono text-sm font-bold flex flex-wrap items-center gap-3 mb-5">
          <span class="inline-block px-2.5 py-1 border-2 border-black bg-[#86efac] text-black shrink-0">
            <time datetime="{{ date | dateIso }}">{{ (displayDate or date) | dateDisplay }}</time>
          </span>
          <span class="text-black/65">// {{ (content | readingTime) }}</span>
          <span class="hidden sm:inline text-black/65">// BY <a href="/" class="hover:underline text-black">BITTU</a></span>
        </p>

        <!-- Title -->
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-black leading-[1.05] tracking-tight mb-6">
          {{ title }}
        </h1>

        <!-- Summary Dek (homepage tagline style: amber display face) -->
        {% if summary %}
          <p
            class="font-display text-lg sm:text-xl text-[#b45309] leading-snug mb-6"
            data-pagefind-meta="summary"
          >
            {{ summary }}
          </p>
        {% endif %}

        <!-- Tags + Share Button (yellow pill) on the right -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
          {% if tags %}
            <div class="tag-row flex flex-wrap items-center gap-2">
              {% for tag in tags %}
                {% if tag != "posts" %}
                  <a
                    href="/blog/?tag={{ tag | urlencode }}"
                    class="px-2.5 py-1 bg-transparent border-2 border-black font-mono text-xs font-bold text-black hover:bg-[#fef3c7] transition-colors"
                  >
                    #{{ tag | lower }}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          {% else %}
            <span class="hidden sm:block" aria-hidden="true"></span>
          {% endif %}

          <div class="screen-meta relative">
            <button
              id="share-article-btn"
              class="bg-[#fde047] hover:bg-[#fbbf24] border-2 border-black px-3 py-1 text-xs font-bold text-black inline-flex items-center gap-1 cursor-pointer select-none transition-colors"
              data-title="{{ title }}"
              data-url="https://bittu.dev{{ page.url }}"
              aria-haspopup="true"
              aria-expanded="false"
              title="Share article"
            >
              {{ icons.share2("w-3.5 h-3.5 text-black") }}
              <span>SHARE</span>
            </button>

            <!-- Share Popover Dropdown -->
            <div
              id="share-popover"
              class="hidden absolute right-0 top-full mt-1.5 w-44 bg-[#fffdf9] border-2 border-black p-1 z-50 text-xs font-mono flex-col shadow-brutal-xs"
              role="menu"
              aria-label="Share options"
            >
              <a
                href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ ('https://bittu.dev' + page.url) | urlencode }}"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 px-2 py-1.5 hover:bg-[#fde047] text-black font-bold transition-colors"
                role="menuitem"
              >
                {{ icons.twitter("w-3.5 h-3.5 text-black") }}
                <span>Share on X</span>
              </a>

              <a
                href="https://www.linkedin.com/sharing/share-offsite/?url={{ ('https://bittu.dev' + page.url) | urlencode }}"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 px-2 py-1.5 hover:bg-[#38bdf8] text-black font-bold transition-colors"
                role="menuitem"
              >
                {{ icons.linkedin("w-3.5 h-3.5 text-black") }}
                <span>Share on LinkedIn</span>
              </a>

              <a
                href="https://reddit.com/submit?url={{ ('https://bittu.dev' + page.url) | urlencode }}&title={{ title | urlencode }}"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 px-2 py-1.5 hover:bg-[#fed7aa] text-black font-bold transition-colors"
                role="menuitem"
              >
                {{ icons.reddit("w-3.5 h-3.5 text-black") }}
                <span>Share on Reddit</span>
              </a>

              <button
                id="popover-copy-link-btn"
                class="w-full text-left flex items-center gap-2 px-2 py-1.5 hover:bg-[#86efac] text-black font-bold transition-colors cursor-pointer"
                role="menuitem"
              >
                {{ icons.copy("w-3.5 h-3.5 text-black") }}
                <span id="popover-copy-text">Copy link</span>
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Print-Only Editorial Byline (hidden on screen) -->
      <div class="print-byline hidden print:block" aria-hidden="true">
        BY {{ site.author.name | upper }}
        &middot; {{ (displayDate or date) | dateDisplay | upper }}
        &middot; {{ (content | readingTime) | upper }}
      </div>

      <!-- Table of Contents -->
      {% if tocList and tocList.length > 2 %}
        <details class="mb-10 group border-2 border-black px-4 py-3.5 sm:px-5">
          <summary class="font-mono text-xs sm:text-sm font-black uppercase text-black cursor-pointer flex items-center justify-between select-none">
            <span class="flex items-center gap-2">
              {{ icons.bookOpen("w-4 h-4") }}
              <span>TABLE OF CONTENTS ({{ tocList.length }} SECTIONS)</span>
            </span>
            <span class="font-mono text-xs font-bold transition-transform group-open:rotate-180">▼</span>
          </summary>
          <nav class="mt-4 space-y-1 text-xs sm:text-sm font-mono">
            {% for item in tocList %}
              <a
                href="#{{ item.id }}"
                class="block py-1 text-black/70 hover:text-black hover:bg-[#fde047] transition-colors {{ 'pl-4 font-medium' if item.level == 3 else 'font-bold text-black' }}"
              >
                {{ item.title }}
              </a>
            {% endfor %}
          </nav>
        </details>
      {% endif %}

      <!-- Markdown Article Content Body (full reading width) -->
      <div class="prose prose-retro max-w-none text-black">
        {{ content | safe }}
      </div>

      <!-- Post Footer: Author Line + Navigation -->
      <footer class="mt-16 pt-8 border-t-2 border-black space-y-8">
        <!-- Author: plain text + compact social pills -->
        <div class="author-card flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="font-body text-sm sm:text-base leading-relaxed flex items-center flex-wrap gap-x-2 gap-y-1">
            <span class="font-display text-lg sm:text-xl font-bold text-black">Bittu</span>
            <span class="font-bold text-[#b45309]" aria-hidden="true">//</span>
            <span class="text-black/85">Software Engineer &amp; Cybersecurity student at IIT Kanpur.</span>
          </div>
          <div class="author-socials flex items-center gap-2 font-mono text-xs font-bold shrink-0">
            <a
              href="https://github.com/Bittu5134"
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 bg-transparent border-2 border-black hover:bg-[#c4b5fd] transition-colors flex items-center gap-1 text-black"
            >
              {{ icons.github("w-3.5 h-3.5") }}
              <span>GITHUB</span>
            </a>
            <a
              href="https://www.linkedin.com/in/bittu5134"
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 bg-transparent border-2 border-black hover:bg-[#38bdf8] transition-colors flex items-center gap-1 text-black"
            >
              {{ icons.linkedin("w-3.5 h-3.5") }}
              <span>LINKEDIN</span>
            </a>
            <a
              href="/rss.xml"
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 bg-transparent border-2 border-black hover:bg-[#fb923c] transition-colors flex items-center gap-1 text-black"
            >
              {{ icons.rss("w-3.5 h-3.5") }}
              <span>RSS</span>
            </a>
          </div>
        </div>

        <!-- Post Navigation: colored label chips (mint / lavender / sky) -->
        {% set newerPost = collections.blogs | getPreviousCollectionItem(page) %}
        {% set olderPost = collections.blogs | getNextCollectionItem(page) %}
        {% set randomPost = collections.blogs | getRandomOtherPost(page.url, newerPost.url if newerPost else "", olderPost.url if olderPost else "") %}
        {% if newerPost or olderPost or randomPost %}
          <div class="post-nav border-y border-black/15 py-6 space-y-3 font-mono text-xs sm:text-sm">
            {% if newerPost %}
              <div class="flex items-baseline justify-between gap-3">
                <div class="flex items-baseline gap-3 min-w-0">
                  <span class="shrink-0 inline-block px-2 py-0.5 border-2 border-black bg-[#86efac] text-black font-black uppercase text-[10px]">Next</span>
                  <a
                    href="{{ newerPost.url }}"
                    class="font-mono font-bold text-black hover:text-[#b45309] transition-colors truncate"
                  >
                    {{ newerPost.data.title }}
                  </a>
                </div>
                <time datetime="{{ newerPost.date | dateIso }}" class="text-xs text-black/60 font-medium shrink-0">
                  {{ (newerPost.data.displayDate or newerPost.date) | dateDisplay }}
                </time>
              </div>
            {% endif %}

            {% if olderPost %}
              <div class="flex items-baseline justify-between gap-3">
                <div class="flex items-baseline gap-3 min-w-0">
                  <span class="shrink-0 inline-block px-2 py-0.5 border-2 border-black bg-[#c4b5fd] text-black font-black uppercase text-[10px]">Prev</span>
                  <a
                    href="{{ olderPost.url }}"
                    class="font-mono font-bold text-black hover:text-[#b45309] transition-colors truncate"
                  >
                    {{ olderPost.data.title }}
                  </a>
                </div>
                <time datetime="{{ olderPost.date | dateIso }}" class="text-xs text-black/60 font-medium shrink-0">
                  {{ (olderPost.data.displayDate or olderPost.date) | dateDisplay }}
                </time>
              </div>
            {% endif %}

            {% if randomPost %}
              <div class="flex items-baseline justify-between gap-3">
                <div class="flex items-baseline gap-3 min-w-0">
                  <span class="shrink-0 inline-block px-2 py-0.5 border-2 border-black bg-[#38bdf8] text-black font-black uppercase text-[10px]">Random</span>
                  <a
                    href="{{ randomPost.url }}"
                    class="font-mono font-bold text-black hover:text-[#b45309] transition-colors truncate"
                  >
                    {{ randomPost.data.title }}
                  </a>
                </div>
                <time datetime="{{ randomPost.date | dateIso }}" class="text-xs text-black/60 font-medium shrink-0">
                  {{ (randomPost.data.displayDate or randomPost.date) | dateDisplay }}
                </time>
              </div>
            {% endif %}
          </div>

          <div class="flex items-center justify-between">
            <a
              href="/blog"
              class="inline-flex items-center gap-1.5 px-4 py-2 border-2 border-black bg-transparent font-mono text-xs sm:text-sm font-bold text-black hover:bg-[#fde047] transition-colors"
            >
              <span>← ALL BLOGS</span>
            </a>
            <a
              href="#article-top"
              class="inline-flex items-center gap-1.5 px-4 py-2 border-2 border-black bg-transparent font-mono text-xs sm:text-sm font-bold text-black hover:bg-[#86efac] transition-colors"
            >
              <span>▲ TOP</span>
            </a>
          </div>
        {% endif %}

        <!-- Giscus Comments Section -->
        <section id="comments">
          <div class="giscus-container min-h-[160px]">
            <script src="https://giscus.app/client.js"
              data-repo="Bittu5134/bittu5134.github.io"
              data-repo-id="MDEwOlJlcG9zaXRvcnkzOTkzNDM2NDE="
              data-category="Announcements"
              data-category-id="DIC_kwDOF82AGc4DGpnm"
              data-mapping="pathname"
              data-strict="0"
              data-reactions-enabled="1"
              data-emit-metadata="0"
              data-input-position="top"
              data-theme="gruvbox_light"
              data-lang="en"
              crossorigin="anonymous"
              async>
            </script>
          </div>
        </section>
      </footer>
    </article>
  </main>

  <!-- Canonical Site Footer -->
  {% include "components/retro-footer.njk" %}
</div>

<!-- Reading Progress Scroll Observer -->
<script>
  (function() {
    const progressBar = document.getElementById("reading-progress");
    if (!progressBar) return;
    function updateProgress() {
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (totalHeight <= 0) {
        progressBar.style.width = "0%";
        return;
      }
      const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
      progressBar.style.width = progress + "%";
    }
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
  })();
</script>

<!-- Share Widget Logic (Mobile uses Web Share API, Desktop uses Flat Popover) -->
<script>
  (function() {
    const shareBtn = document.getElementById("share-article-btn");
    const sharePopover = document.getElementById("share-popover");
    const copyBtn = document.getElementById("popover-copy-link-btn");
    const copyText = document.getElementById("popover-copy-text");
    if (!shareBtn) return;
    const title = shareBtn.getAttribute("data-title") || document.title;
    const url = shareBtn.getAttribute("data-url") || window.location.href;

    shareBtn.addEventListener("click", async function(e) {
      e.stopPropagation();
      const isMobile = window.matchMedia("(max-width: 767px)").matches || /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      if (isMobile && navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch (err) {
          if (err.name !== "AbortError") {
            togglePopover();
          }
        }
      } else {
        togglePopover();
      }
    });

    function togglePopover() {
      if (!sharePopover) return;
      const isHidden = sharePopover.classList.contains("hidden");
      sharePopover.classList.toggle("hidden", !isHidden);
      sharePopover.classList.toggle("flex", isHidden);
      shareBtn.setAttribute("aria-expanded", String(isHidden));
    }

    if (copyBtn) {
      copyBtn.addEventListener("click", async function(e) {
        e.stopPropagation();
        try {
          await navigator.clipboard.writeText(url);
          if (copyText) {
            copyText.textContent = "COPIED!";
            setTimeout(() => { copyText.textContent = "Copy link"; }, 2000);
          }
        } catch (e) {}
      });
    }

    document.addEventListener("click", function(e) {
      if (sharePopover && !sharePopover.classList.contains("hidden") && !sharePopover.contains(e.target) && e.target !== shareBtn) {
        sharePopover.classList.add("hidden");
        sharePopover.classList.remove("flex");
        shareBtn.setAttribute("aria-expanded", "false");
      }
    });
  })();
</script>

<!-- Conditionally Load Mermaid.js with Light/Retro Theme -->
{% if 'class="mermaid' in content %}
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

    function getMermaidConfig() {
      return {
        startOnLoad: false,
        securityLevel: "loose",
        // "base" fully honours themeVariables — nodes render in the site's
        // yellow / mint / lavender accents instead of neutral grayscale.
        theme: "base",
        themeVariables: {
          primaryColor: "#fde047",
          primaryBorderColor: "#000000",
          primaryTextColor: "#000000",
          secondaryColor: "#86efac",
          secondaryTextColor: "#000000",
          secondaryBorderColor: "#000000",
          tertiaryColor: "#c4b5fd",
          tertiaryTextColor: "#000000",
          tertiaryBorderColor: "#000000",
          lineColor: "#14161f",
          textColor: "#000000",
          background: "#fffdf9",
          mainBkg: "#fde047", /* node bodies paint from mainBkg in mermaid */
          nodeBorder: "#000000",
          clusterBkg: "#f3e7cc",
          clusterBorder: "#000000",
          edgeLabelBackground: "#fffdf9",
          noteBkgColor: "#fef3c7",
          noteTextColor: "#000000",
          noteBorderColor: "#000000",
          actorBkg: "#fde047",
          actorBorder: "#000000",
          activationBkgColor: "#86efac",
          fontFamily: '"Space Grotesk", sans-serif',
          fontSize: "13px"
        }
      };
    }

    /* Colour nodes by their graph role — one consistent colour per role,
       determined by parsing the diagram source for each node id:
       id([...]) / id(["..."]) terminals -> mint, id{"..."} decisions -> sky,
       id[("...")] data stores -> lavender, id["..."] processes -> yellow.
       Shape geometry is the fallback for diagram types with opaque ids.
       2px black strokes match the site's border system. */
    const ROLE_COLORS = { terminal: "#86efac", decision: "#38bdf8", data: "#c4b5fd", process: "#fde047" };
    function parseNodeRoles(code) {
      const map = {};
      const re = /(?:^|\n|\s|;)([A-Za-z0-9_]+)\s*(\(\[|\[\(|\{|\[|\()/g;
      let m;
      while ((m = re.exec(code)) !== null) {
        const id = m[1];
        const opener = m[2];
        if (opener === "(") continue; // plain id("...") is still a process box
        map[id] = opener === "{" ? ROLE_COLORS.decision
          : opener === "[(" ? ROLE_COLORS.data
          : opener === "([" ? ROLE_COLORS.terminal
          : ROLE_COLORS.process;
      }
      return map;
    }
    function colorizeByRole(container, code) {
      const svg = container.querySelector("svg");
      if (!svg) return;
      const roleMap = parseNodeRoles(code || "");
      svg.querySelectorAll("g.node").forEach(node => {
        const shape = node.querySelector("rect, polygon, circle, path");
        if (!shape) return;
        let fill = null;
        const idMatch = node.id.match(/-(?:flowchart|flow|statediagram|state)-([A-Za-z0-9_]+)-\d+$/);
        if (idMatch && roleMap[idMatch[1]]) {
          fill = roleMap[idMatch[1]]; // role straight from the diagram source
        } else {
          // fallback: infer from shape geometry
          const tag = shape.tagName.toLowerCase();
          if (tag === "polygon") fill = ROLE_COLORS.decision;
          else if (tag === "circle") fill = ROLE_COLORS.terminal;
          else if (tag === "path") {
            const d = shape.getAttribute("d") || "";
            fill = /C|Q/.test(d) ? ROLE_COLORS.terminal : ROLE_COLORS.process;
          } else {
            const rx = parseFloat(shape.getAttribute("rx") || "0");
            const h = parseFloat(shape.getAttribute("height") || "0");
            fill = (h && rx >= h / 2) ? ROLE_COLORS.terminal : ROLE_COLORS.process;
          }
        }
        shape.style.fill = fill;
        shape.style.stroke = "#000000";
        shape.style.strokeWidth = "2px";
      });
    }

    function decodeEntities(encodedString) {
      const textarea = document.createElement("textarea");
      textarea.innerHTML = encodedString;
      return textarea.value;
    }

    async function renderDiagrams() {
      mermaid.initialize(getMermaidConfig());

      const containers = document.querySelectorAll(".mermaid-container");
      for (let idx = 0; idx < containers.length; idx++) {
        const container = containers[idx];
        let code = "";
        const encoded = container.getAttribute("data-mermaid-code");
        if (encoded) {
          try { code = decodeURIComponent(encoded); } catch (e) { code = encoded; }
        }
        if (!code) {
          const pre = container.querySelector("pre.mermaid");
          code = pre ? pre.textContent.trim() : "";
        }
        if (!code) continue;
        code = decodeEntities(code);

        try {
          const uniqueId = "mermaid-svg-" + idx + "-" + Math.random().toString(36).substring(2, 8);
          const { svg } = await mermaid.render(uniqueId, code);
          container.innerHTML = svg;
          colorizeByRole(container, code);
        } catch (err) {
          console.warn("Mermaid render error for diagram " + idx + ":", err);
          if (!container.querySelector("pre")) {
            container.innerHTML = `<pre class="mermaid font-mono text-xs text-red-500 overflow-x-auto">${code.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</pre>`;
          }
        }
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderDiagrams);
    } else {
      renderDiagrams();
    }
  </script>
{% endif %}

<!-- Conditionally Load & Initialize Littlefoot Footnote Popovers -->
{% if content and ('data-footnote-ref' in content or 'class="footnotes' in content) %}
  <script type="module">
    import littlefoot from "/assets/js/littlefoot.js";

    function initLittlefoot() {
      littlefoot({
        activateDelay: 100,
        dismissDelay: 100,
        hoverDelay: 250,
        allowMultiple: false,
        activateOnHover: true,
        dismissOnUnhover: false,
        anchorPattern: /#(user-content-)?fn[:\-_\d]/gi,
        buttonTemplate: '<button class="littlefoot__button" id="<% reference %>" aria-label="Footnote <% number %>" title="See Footnote <% number %>"><span class="littlefoot__number"><% number %></span></button>'
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLittlefoot);
    } else {
      initLittlefoot();
    }
  </script>
{% endif %}
