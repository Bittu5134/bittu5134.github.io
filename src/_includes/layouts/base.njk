<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title if title else "Bittu | Software & CyberSec" }}</title>
    <meta name="description" content="{{ summary if summary else (description if description else "Your friendly, neighborhood Technomancer. Cybersecurity @ IIT Kanpur '30") }}" />
    <meta name="author" content="Bittu" />
    <link rel="canonical" href="https://bittu.dev{{ page.url }}" />

    <!-- Preload the above-the-fold cover image: it is the LCP element on posts -->
    {% if coverImage %}
      {% set preloadCover = coverImage %}
      {% if preloadCover.endsWith('.svg') %}
        {% set preloadCover = preloadCover | replace('.svg', '.png') %}
      {% endif %}
      <link
        rel="preload"
        as="image"
        href="{{ preloadCover if (preloadCover.startsWith('http://') or preloadCover.startsWith('https://')) else ('https://bittu.dev' + preloadCover) }}"
        {% if coverImageWidth %}width="{{ coverImageWidth }}"{% endif %}
        {% if coverImageHeight %}height="{{ coverImageHeight }}"{% endif %}
        fetchpriority="high"
      />
    {% endif %}

    <!-- OpenGraph / Social Meta -->
    <meta property="og:site_name" content="{{ siteName if siteName else 'bittu.dev' }}" />
    <meta property="og:title" content="{{ title if title else 'Bittu | Software & CyberSec' }}" />
    <meta property="og:description" content="{{ summary if summary else (description if description else "Your friendly, neighborhood Technomancer. Cybersecurity @ IIT Kanpur '30") }}" />
    <meta property="og:type" content="{{ ogType if ogType else ('article' if date else 'website') }}" />
    <meta property="og:url" content="https://bittu.dev{{ page.url }}" />
    {% set rawOg = ogImage if ogImage else coverImage %}
    {% if not rawOg %}
      {% set rawOg = '/images/og_banner.webp' %}
    {% elif rawOg.endsWith('.svg') %}
      {% set rawOg = rawOg | replace('.svg', '.png') %}
    {% endif %}
    {% set resolvedCover = rawOg if (rawOg.startsWith('http://') or rawOg.startsWith('https://')) else ('https://bittu.dev' + rawOg) %}
    <meta property="og:image" content="{{ resolvedCover }}" />
    <meta property="og:image:secure_url" content="{{ resolvedCover }}" />
    {% if resolvedCover.endsWith('.png') %}
      <meta property="og:image:type" content="image/png" />
    {% elif resolvedCover.endsWith('.webp') %}
      <meta property="og:image:type" content="image/webp" />
    {% elif resolvedCover.endsWith('.jpg') or resolvedCover.endsWith('.jpeg') %}
      <meta property="og:image:type" content="image/jpeg" />
    {% endif %}
    {% set imgWidth = ogImageWidth if ogImageWidth else (1400 if 'og_banner' in resolvedCover else 1200) %}
    {% set imgHeight = ogImageHeight if ogImageHeight else (350 if 'og_banner' in resolvedCover else 630) %}
    <meta property="og:image:width" content="{{ imgWidth }}" />
    <meta property="og:image:height" content="{{ imgHeight }}" />
    {% set resolvedAlt = coverAlt if coverAlt else (alt if alt else (title if title else 'Bittu | Software & CyberSec')) %}
    <meta property="og:image:alt" content="{{ resolvedAlt }}" />

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@404lostsquid" />
    <meta name="twitter:creator" content="@404lostsquid" />
    <meta name="twitter:title" content="{{ title if title else 'Bittu | Software & CyberSec' }}" />
    <meta name="twitter:description" content="{{ summary if summary else (description if description else "Your friendly, neighborhood Technomancer. Cybersecurity @ IIT Kanpur '30") }}" />
    <meta name="twitter:image" content="{{ resolvedCover }}" />
    <meta name="twitter:image:alt" content="{{ resolvedAlt }}" />

    <!-- Article Metadata -->
    {% if date %}<meta property="article:published_time" content="{{ date | dateIso }}" />{% endif %}
    {% set seoTagList = allSeoTags if allSeoTags else (tags | filterTags) %}
    {% if seoTagList %}
      {% for tag in seoTagList %}
        {% if tag != "posts" and tag != "all" %}
          <meta property="article:tag" content="{{ tag }}" />
        {% endif %}
      {% endfor %}
    {% endif %}
    {% if keywords %}
      <meta name="keywords" content="{{ keywords }}" />
    {% endif %}

    <!-- JSON-LD Structured Data -->
    {% include "components/seo-schema.njk" %}

    <!-- Preload Critical Local Fonts & Hero Avatar -->
    <!-- Space Mono Bold carries ~84% of hero text (font-bold/black/semibold all resolve to it,
         since Space Mono only ships 400 + 700). Regular/Grotesk are left to font-display: swap. -->
    <link rel="preload" href="/fonts/SpaceMono-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/images/avatar.avif" as="image" type="image/avif" />

    <!-- Theme Preference (Retro Light Theme) -->
    <script>
      (function() {
        try {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.classList.remove("dark");
        } catch (e) {}
      })();
    </script>

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/index.css" />

    <!-- Blog CSS: typography + prose styles (blog pages only) -->
    {% if isBlogPage %}
      <link rel="stylesheet" href="/assets/css/blog.css" />
    {% endif %}

    <!-- KaTeX (loaded only if page contains math output) -->
    {% if content and 'katex' in content %}
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" crossorigin="anonymous" />
    {% endif %}

    <!-- Littlefoot Footnotes CSS (blog posts with real footnote markup) -->
    {% if isBlogPage and content and ('data-footnote-ref' in content or 'class="footnotes' in content) %}
      <link rel="stylesheet" href="/assets/css/littlefoot.css" />
    {% endif %}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Bittu's Blog RSS Feed" href="https://bittu.dev/rss.xml" />

    <!-- LLM / AI agent context feeds (replaces non-standard robots.txt directives) -->
    <link rel="alternate" type="text/plain" title="LLM Context Index" href="https://bittu.dev/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLM Full Context" href="https://bittu.dev/llms-full.txt" />
  </head>
  <body id="top" class="bg-[#f6eedb] text-[#14161f] selection:bg-[#fde047] selection:text-black min-h-screen">
    {% if isBlogPage %}
      {% include "components/icons-sprite.njk" %}
    {% else %}
      {% include "components/icons-sprite-home.njk" %}
    {% endif %}
    {{ content | safe }}

    <!-- Client-side Vanilla Scripts -->
    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
