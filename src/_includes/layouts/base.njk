{%- set pageTitle = title or site.title -%}
{%- set pageDesc = summary or description or site.description -%}
{%- set rawCover = ogImage or coverImage or '/assets/images/og-banner.webp' -%}
{%- if rawCover.endsWith('.svg') -%}{%- set rawCover = rawCover | replace('.svg', '.png') -%}{%- endif -%}
{%- set coverUrl = rawCover if rawCover.startsWith('http') else (site.url + rawCover) -%}
{%- set coverWidth = ogImageWidth or (1400 if 'og-banner' in coverUrl else 1200) -%}
{%- set coverHeight = ogImageHeight or (350 if 'og-banner' in coverUrl else 630) -%}
{%- set coverAltText = coverAlt or title or site.title -%}
{%- set seoTagList = allSeoTags if allSeoTags else (tags | filterTags) -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f3e7cc" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDesc }}" />
    <meta name="author" content="{{ site.author.name }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    <!-- Preload the above-the-fold cover image: it is the LCP element on posts -->
    {% if coverImage %}
      <link rel="preload" as="image" href="{{ coverUrl }}" width="{{ coverWidth }}" height="{{ coverHeight }}" fetchpriority="high" />
    {% endif %}

    <!-- OpenGraph / Social Meta -->
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDesc }}" />
    <meta property="og:type" content="{{ ogType or ('article' if date else 'website') }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ coverUrl }}" />
    <meta property="og:image:secure_url" content="{{ coverUrl }}" />
    {% if coverUrl.endsWith('.png') %}
      <meta property="og:image:type" content="image/png" />
    {% elif coverUrl.endsWith('.webp') %}
      <meta property="og:image:type" content="image/webp" />
    {% elif coverUrl.endsWith('.jpg') or coverUrl.endsWith('.jpeg') %}
      <meta property="og:image:type" content="image/jpeg" />
    {% endif %}
    <meta property="og:image:width" content="{{ coverWidth }}" />
    <meta property="og:image:height" content="{{ coverHeight }}" />
    <meta property="og:image:alt" content="{{ coverAltText }}" />

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="{{ site.author.twitter }}" />
    <meta name="twitter:creator" content="{{ site.author.twitter }}" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDesc }}" />
    <meta name="twitter:image" content="{{ coverUrl }}" />
    <meta name="twitter:image:alt" content="{{ coverAltText }}" />

    <!-- Article Metadata -->
    {% if date %}<meta property="article:published_time" content="{{ date | dateIso }}" />{% endif %}
    {% if dateModified %}<meta property="article:modified_time" content="{{ dateModified }}" />{% endif %}
    {% for tag in seoTagList %}
      {% if tag != "posts" %}<meta property="article:tag" content="{{ tag }}" />{% endif %}
    {% endfor %}
    {% if keywords %}<meta name="keywords" content="{{ keywords }}" />{% endif %}

    <!-- JSON-LD Structured Data -->
    {% include "components/seo-schema.njk" %}

    <!-- Preload Critical Local Fonts & Hero Avatar -->
    <!-- Playpen Sans Regular + ExtraBold are the only above-the-fold faces;
         Space Mono (data accents) and the 700 cut are left to font-display: swap. -->
    {% if page.url == "/" %}
      <link rel="preload" href="/assets/images/avatar.avif" as="image" type="image/avif" />
      <link rel="preload" href="/assets/fonts/PlaypenSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/assets/fonts/PlaypenSans-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/assets/fonts/PlaypenSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
    {% endif %}

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/index.css?v={{ buildStamp }}" />

    <!-- Blog CSS: prose typography (blog pages only) -->
    {% if isBlogPage %}
      <link rel="stylesheet" href="/assets/css/blog.css?v={{ buildStamp }}" />
    {% endif %}

    <!-- KaTeX (only when the page actually rendered math) -->
    {% if content and 'katex' in content %}
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" crossorigin="anonymous" />
    {% endif %}


    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} — RSS Feed" href="{{ site.feedUrl }}" />

    <!-- LLM / AI agent context feeds (replaces non-standard robots.txt directives) -->
    <link rel="alternate" type="text/plain" title="LLM Context Index" href="{{ site.url }}/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLM Full Context" href="{{ site.url }}/llms-full.txt" />
  </head>
  <body id="top" class="text-[#14161f] selection:bg-[#fde047] selection:text-black min-h-screen">
    {{ content | safe }}

    <!-- Client-side Vanilla Scripts -->
    <script src="/assets/js/main.js?v={{ buildStamp }}" defer></script>
  </body>
</html>
