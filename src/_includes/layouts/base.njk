<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title if title else "Bittu | Systems Hacker & Modder" }}</title>
    <meta name="description" content="{{ summary if summary else (description if description else 'Systems engineer & cybersecurity student at IIT Kanpur. Builds open-source tools, WebRTC infra, and got featured on Minecraft Live.') }}" />
    <meta name="author" content="Bittu (Bittu5134)" />
    <meta name="theme-color" content="#f6eedb" />
    <link rel="canonical" href="https://bittu.dev{{ page.url }}" />

    <!-- OpenGraph / Social Meta -->
    <meta property="og:site_name" content="Bittu (Bittu5134)" />
    <meta property="og:title" content="{{ title if title else 'Bittu | Systems Hacker & Modder' }}" />
    <meta property="og:description" content="{{ summary if summary else (description if description else 'Systems engineer & cybersecurity student at IIT Kanpur. Builds open-source tools, WebRTC infra, and got featured on Minecraft Live.') }}" />
    <meta property="og:type" content="{{ ogType if ogType else ('article' if date else 'website') }}" />
    <meta property="og:url" content="https://bittu.dev{{ page.url }}" />
    {% set rawOg = ogImage if ogImage else coverImage %}
    {% if not rawOg %}
      {% set rawOg = '/images/avatar.webp' %}
    {% elif rawOg.endsWith('.svg') %}
      {% set rawOg = rawOg | replace('.svg', '.png') %}
    {% endif %}
    {% set resolvedCover = rawOg if (rawOg.startsWith('http://') or rawOg.startsWith('https://')) else ('https://bittu.dev' + rawOg) %}
    <meta property="og:image" content="{{ resolvedCover }}" />
    <meta property="og:image:secure_url" content="{{ resolvedCover }}" />
    {% if resolvedCover.endsWith('.png') %}<meta property="og:image:type" content="image/png" />{% endif %}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {% if coverAlt %}<meta property="og:image:alt" content="{{ coverAlt }}" />{% endif %}

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Bittu5134" />
    <meta name="twitter:creator" content="@Bittu5134" />
    <meta name="twitter:title" content="{{ title if title else 'Bittu | Systems Hacker & Modder' }}" />
    <meta name="twitter:description" content="{{ summary if summary else (description if description else 'Systems engineer & cybersecurity student at IIT Kanpur.') }}" />
    <meta name="twitter:image" content="{{ resolvedCover }}" />
    {% if coverAlt %}<meta name="twitter:image:alt" content="{{ coverAlt }}" />{% endif %}

    <!-- Article Metadata -->
    {% if date %}<meta property="article:published_time" content="{{ date | dateIso }}" />{% endif %}
    {% if tags %}
      {% for tag in tags %}
        {% if tag != "posts" and tag != "all" %}
          <meta property="article:tag" content="{{ tag }}" />
        {% endif %}
      {% endfor %}
    {% endif %}

    <!-- JSON-LD Structured Data -->
    {% if date %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ (title if title else "Bittu Dispatch") | json | safe }},
      "description": {{ (summary if summary else (description if description else "")) | json | safe }},
      "image": [{{ resolvedCover | json | safe }}],
      "datePublished": {{ date | dateIso | json | safe }},
      "author": {
        "@type": "Person",
        "name": "Bittu (Bittu5134)",
        "url": "https://bittu.dev"
      },
      "publisher": {
        "@type": "Person",
        "name": "Bittu",
        "url": "https://bittu.dev"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://bittu.dev{{ page.url }}"
      }
    }
    </script>
    {% endif %}

    <!-- Preload Critical Local Fonts & Hero Avatar -->
    <link rel="preload" href="/fonts/SpaceGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/images/avatar.avif" as="image" type="image/avif" />

    <!-- Theme Preference (Retro Light Theme) -->
    <script>
      (function() {
        try {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.classList.remove("dark");
        } catch (e) {}
      })();
    </script>

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/index.css" />

    <!-- KaTeX (loaded only if page contains math output) -->
    {% if content and 'katex' in content %}
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" crossorigin="anonymous" />
    {% endif %}

    <!-- Littlefoot Footnotes CSS (loaded only if page contains footnotes) -->
    {% if content and ('data-footnote-ref' in content or 'fnref' in content or 'footnote' in content) %}
      <link rel="stylesheet" href="/assets/css/littlefoot.css" />
    {% endif %}


    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Bittu's Blog RSS Feed" href="https://bittu.dev/rss.xml" />
  </head>
  <body class="bg-[#f6eedb] text-[#14161f] selection:bg-[#fde047] selection:text-black min-h-screen">
    {% include "components/icons-sprite.njk" %}
    {{ content | safe }}

    <!-- Client-side Vanilla Scripts -->
    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
