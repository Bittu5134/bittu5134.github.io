---
layout: layouts/base.njk
title: "404 - Page Not Found | Bittu"
permalink: "/404.html"
---
{% import "macros/icons.njk" as icons %}

<div class="min-h-screen bg-[#f6eedb] retro-dots-bg text-[#14161f] font-sans flex flex-col">
  {% include "components/retro-header.njk" %}

  <main class="flex-1 flex items-center justify-center p-4 py-16">
    <div class="max-w-lg w-full text-center space-y-6">

      <!-- Window Chrome Bar -->
      <div class="bg-[#fffdf9] border-[3px] border-black shadow-brutal">
        <div class="bg-[#fb7185] border-b-[3px] border-black p-2 flex items-center justify-between px-4">
          <span class="font-mono text-sm font-black text-black tracking-wider uppercase">ERROR 404</span>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full border-2 border-black bg-[#fde047] inline-block"></span>
            <span class="w-3 h-3 rounded-full border-2 border-black bg-[#86efac] inline-block"></span>
            <span class="w-3 h-3 rounded-full border-2 border-black bg-[#f87171] inline-block"></span>
          </div>
        </div>

        <div class="p-8 sm:p-12 space-y-5">
          <h1 class="text-8xl sm:text-9xl font-black font-mono tracking-tight text-black select-none leading-none">
            404
          </h1>

          <div class="inline-block bg-[#fde047] border-2 border-black px-3 py-1 text-xs font-mono font-bold uppercase shadow-brutal-sm">
            PAGE NOT FOUND
          </div>

          <p class="font-mono text-sm text-black/70 leading-relaxed max-w-sm mx-auto">
            Looks like you wandered off the map. This page doesn't exist or may have been moved.
          </p>

          <!-- Terminal-style suggestion -->
          <div class="bg-[#14161f] border-2 border-black p-4 text-left font-mono text-xs space-y-1">
            <span class="text-[#86efac]">$ </span><span class="text-white">cd ~</span><br/>
            <span class="text-[#86efac]">$ </span><span class="text-white">ls blog/</span><br/>
            <span class="text-[#fde047]">→ maybe try the blog archive?</span>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
            <a
              href="/"
              class="inline-flex items-center gap-2 bg-[#fde047] hover:bg-[#fb923c] text-black font-mono font-bold px-5 py-2.5 border-2 border-black shadow-brutal hover:-translate-y-0.5 hover:shadow-brutal-lg active:translate-y-0 active:shadow-none transition-all text-sm uppercase"
            >
              {{ icons.arrowLeft("w-4 h-4") }}
              <span>Home</span>
            </a>
            <a
              href="/blog"
              class="inline-flex items-center gap-2 bg-[#86efac] hover:bg-[#4ade80] text-black font-mono font-bold px-5 py-2.5 border-2 border-black shadow-brutal hover:-translate-y-0.5 hover:shadow-brutal-lg active:translate-y-0 active:shadow-none transition-all text-sm uppercase"
            >
              {{ icons.fileText("w-4 h-4") }}
              <span>All Articles</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>

  {% include "components/retro-footer.njk" %}
</div>
