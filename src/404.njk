---
layout: layouts/base.njk
title: "404 — Page Not Found | Bittu"
description: "That page doesn't exist. Every post and link that does is one click away."
permalink: "/404.html"
---
{% import "macros/icons.njk" as icons %}

{# Same canvas, header and footer as the homepage and /blog — a dead end should
   still look like the rest of the site. Content is centred: this is the one page
   with no reading column, so it gets one focal point instead. #}
<div class="font-body relative min-h-screen flex flex-col bg-[#f3e7cc]">
  {% include "components/scene-ornaments.njk" %}
  {% include "components/retro-header.njk" %}

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24 w-full flex-1 flex flex-col justify-center text-center">
    <!-- Eyebrow: mono chip + slash meta, same as post headers -->
    <div class="flex flex-wrap items-center justify-center gap-2 font-mono text-sm font-bold">
      <span class="inline-block px-2.5 py-1 border-2 border-black bg-[#fb7185]">ERROR 404</span>
      <span class="text-black/60">// nothing at this address</span>
    </div>

    <h1 class="heading-pop font-display text-5xl sm:text-7xl text-black leading-none mt-6">
      Lost in the void<span class="text-[#b45309]">.</span>
    </h1>

    <p class="font-body text-base sm:text-lg text-black/80 leading-relaxed max-w-xl mx-auto mt-5">
      This page doesn't exist, or it moved somewhere else. Everything below still works.
    </p>

    <!-- Terminal panel: the site's retro voice, flat and ink-framed -->
    <div class="mt-8 mx-auto max-w-md border-2 border-black bg-[#14161f] px-4 py-3.5 font-mono text-xs sm:text-sm font-bold leading-relaxed text-left shadow-brutal">
      <div class="text-[#86efac]">$ cd ~</div>
      <div class="text-white">$ ls blog/</div>
      <div class="text-[#fde047] mt-1">→ {{ collections.blogs.length }} posts are one click away</div>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
      <a href="/" class="btn-pill bg-[#fde047] hover:bg-[#fbbf24]">
        {{ icons.arrowLeft("w-3.5 h-3.5 text-black") }} Home
      </a>
      <a href="/blog/" class="btn-pill bg-[#86efac] hover:bg-[#4ade80]">
        {{ icons.fileText("w-3.5 h-3.5 text-black") }} All articles
      </a>
      <a href="/#contact" class="btn-pill bg-[#38bdf8] hover:bg-[#0ea5e9]">
        {{ icons.mail("w-4 h-4 text-black") }} Contact
      </a>
    </div>
  </main>

  {% include "components/retro-footer.njk" %}
</div>
