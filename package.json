{
  "name": "bittu5134.github.io",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "generate-fonts": "python3 scripts/generate-fonts.py",
    "generate-meta": "node scripts/generate-meta.mjs",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/assets/css/index.css --minify",
    "build:11ty": "eleventy",
    "build": "rm -rf dist && python3 scripts/generate-fonts.py && tailwindcss -i ./src/index.css -o ./dist/assets/css/index.css --minify && eleventy && terser dist/assets/js/main.js -c -m -o dist/assets/js/main.js",
    "dev:css": "tailwindcss -i ./src/index.css -o ./dist/assets/css/index.css --watch",
    "dev:11ty": "eleventy --serve",
    "dev": "npm run generate-fonts && (npm run dev:css & npm run dev:11ty)",
    "start": "npm run dev",
    "preview": "eleventy --serve"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@microflash/rehype-figure": "^2.1.4",
    "@shikijs/rehype": "^4.4.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-flexible-code-titles": "^1.3.5",
    "remark-gfm": "^4.0.1",
    "remark-github-alerts": "^0.1.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^3.4.15",
    "terser": "^5.51.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
